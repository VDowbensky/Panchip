;;;1123   
;;;1124       ble_hs_lock();
;;;1125       conn = ble_hs_conn_find(conn_handle);
;;;1126       assert(conn != NULL);
;;;1127   
;;;1128       for (i = 0; i < proc->connect.chan_cnt; i++) {
;;;1129           chan = proc->connect.chan[i];
;;;1130           if (rsp->dcids[i] == 0) {
;;;1131               /* Channel rejected, dont put it on the list.
;;;1132                * User will get notified later in that function
;;;1133                */
