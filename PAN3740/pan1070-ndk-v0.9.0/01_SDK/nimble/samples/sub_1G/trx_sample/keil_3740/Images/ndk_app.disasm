;;;1154                                                  out_att_err);
;;;1155           if (rc == BLE_HS_EAGAIN) {
;;;1156               rc = 0;
;;;1157           }
;;;1158       } else {
;;;1159           rc = 0;
;;;1160       }
;;;1161   
;;;1162   done:
