;;;2000   
;;;2001       ble_hs_lock();
;;;2002       proc = ble_sm_proc_find(conn_handle, BLE_SM_PROC_STATE_PAIR, 1, NULL);
;;;2003       if (proc != NULL) {
;;;2004           proc->pair_rsp[0] = BLE_SM_OP_PAIR_RSP;
;;;2005           memcpy(proc->pair_rsp + 1, rsp, sizeof(*rsp));
;;;2006   
;;;2007           if (rsp->max_enc_key_size < BLE_SM_PAIR_KEY_SZ_MIN) {
;;;2008               res->sm_err = BLE_SM_ERR_ENC_KEY_SZ;
;;;2009               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_ENC_KEY_SZ);
;;;2010           } else if (rsp->max_enc_key_size > BLE_SM_PAIR_KEY_SZ_MAX) {
;;;2011               res->sm_err = BLE_SM_ERR_INVAL;
