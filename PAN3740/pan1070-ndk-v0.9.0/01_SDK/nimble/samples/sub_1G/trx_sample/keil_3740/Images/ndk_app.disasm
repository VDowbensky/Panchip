;;;1375           for (i = 0; i < conn->bhc_gatt_svr.num_clt_cfgs; i++) {
;;;1376               clt_cfg = conn->bhc_gatt_svr.clt_cfgs + i;
;;;1377               if (clt_cfg->flags & BLE_GATTS_CLT_CFG_F_MODIFIED) {
;;;1378                   BLE_HS_DBG_ASSERT(clt_cfg->flags &
;;;1379                                     BLE_GATTS_CLT_CFG_F_INDICATE);
;;;1380   
;;;1381                   chr_val_handle = clt_cfg->chr_val_handle;
;;;1382   
;;;1383                   /* Clear pending flag in anticipation of indication tx. */
;;;1384                   clt_cfg->flags &= ~BLE_GATTS_CLT_CFG_F_MODIFIED;
