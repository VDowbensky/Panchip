;;;530    /**
;;;531     * Implements the first half of the start process.  This just enqueues another
;;;532     * event on the host parent task's event queue.
;;;533     *
;;;534     * Starting is done in two stages to allow the application time to configure
;;;535     * the event queue to use after system initialization but before the host
;;;536     * starts.
;;;537     */
;;;538    static void
