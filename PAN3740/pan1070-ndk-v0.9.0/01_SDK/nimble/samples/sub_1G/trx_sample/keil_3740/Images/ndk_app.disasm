;;;3423   
;;;3424   /*
;;;3425    * -----------------------------------------------------------
;;;3426    * The Idle task.
;;;3427    * ----------------------------------------------------------
;;;3428    *
;;;3429    * The portTASK_FUNCTION() macro is used to allow port/compiler specific
;;;3430    * language extensions.  The equivalent prototype for this function is:
;;;3431    *
;;;3432    * void prvIdleTask( void *pvParameters );
;;;3433    *
;;;3434    */
;;;3435   static portTASK_FUNCTION( prvIdleTask, pvParameters )
;;;3436   {
;;;3437       /* Stop warnings. */
;;;3438       ( void ) pvParameters;
;;;3439   
;;;3440       /** THIS IS THE RTOS IDLE TASK - WHICH IS CREATED AUTOMATICALLY WHEN THE
