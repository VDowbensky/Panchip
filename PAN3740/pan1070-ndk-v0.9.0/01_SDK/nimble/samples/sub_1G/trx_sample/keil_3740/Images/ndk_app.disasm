;;;2022   static int32_t
;;;2023   ble_gap_master_timer(void)
;;;2024   {
;;;2025       uint32_t ticks_until_exp;
;;;2026   #if NIMBLE_BLE_SCAN || NIMBLE_BLE_CONNECT
;;;2027       int rc;
