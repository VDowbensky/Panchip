;;;864    static int
;;;865    ble_att_svr_build_find_info_rsp(uint16_t conn_handle,
;;;866                                    uint16_t start_handle, uint16_t end_handle,
;;;867                                    struct os_mbuf **rxom,
;;;868                                    struct os_mbuf **out_txom,
;;;869                                    uint8_t *att_err)
;;;870    {
;;;871        struct ble_att_find_info_rsp *rsp;
;;;872        struct os_mbuf *txom;
;;;873        uint16_t mtu;
;;;874        int rc;
;;;875    
;;;876        /* Just reuse the request buffer for the response. */
;;;877        txom = *rxom;
;;;878        *rxom = NULL;
;;;879        os_mbuf_adj(txom, OS_MBUF_PKTLEN(txom));
;;;880    
;;;881        /* Write the response base at the start of the buffer.  The format field is
