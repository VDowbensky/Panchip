;;;1216   
;;;1217   int
;;;1218   ble_att_svr_rx_find_type_value(uint16_t conn_handle, struct os_mbuf **rxom)
;;;1219   {
;;;1220   #if !MYNEWT_VAL(BLE_ATT_SVR_FIND_TYPE)
;;;1221       return BLE_HS_ENOTSUP;
;;;1222   #endif
;;;1223   
