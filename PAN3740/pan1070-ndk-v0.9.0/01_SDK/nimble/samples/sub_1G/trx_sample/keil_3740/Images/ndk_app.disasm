;;;3284       {
;;;3285           /* The unblocked task has a priority above that of the calling task, so
;;;3286            * a context switch is required.  This function is called with the
;;;3287            * scheduler suspended so xYieldPending is set so the context switch
;;;3288            * occurs immediately that the scheduler is resumed (unsuspended). */
;;;3289           xYieldPending = pdTRUE;
;;;3290       }
;;;3291   }
