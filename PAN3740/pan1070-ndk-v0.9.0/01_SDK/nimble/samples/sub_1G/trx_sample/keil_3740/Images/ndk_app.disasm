;;;456        ANA->LP_SPACING_TIME1 = 0;
;;;457        ANA->LP_SPACING_TIME2 = 0;
;;;458        /* Enable sleeptimer interrupt */
;;;459        ANA->LP_INT_CTRL |= ANAC_INT_SLEEP_TMR_INT_EN_Msk;
;;;460        NVIC_EnableIRQ(SLPTMR_IRQn);
;;;461        NVIC_SetPriority(SLPTMR_IRQn, 3);   // Lowest prio
;;;462    }
