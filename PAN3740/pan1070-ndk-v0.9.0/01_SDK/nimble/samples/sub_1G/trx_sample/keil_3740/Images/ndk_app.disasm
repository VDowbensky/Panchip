;;;961    static uint32_t
;;;962    ble_gap_master_ticks_until_exp(void)
;;;963    {
;;;964        ble_npl_stime_t ticks;
;;;965    
;;;966        if (ble_gap_master.op == BLE_GAP_OP_NULL || !ble_gap_master.exp_set) {
;;;967            /* Timer not set; infinity ticks until next event. */
;;;968            return BLE_HS_FOREVER;
;;;969        }
;;;970    
;;;971        ticks = ble_gap_master.exp_os_ticks - ble_npl_time_get();
;;;972        if (ticks > 0) {
;;;973            /* Timer not expired yet. */
;;;974            return ticks;
;;;975        }
;;;976    
;;;977        /* Timer just expired. */
;;;978        return 0;
;;;979    }
;;;980    
;;;981    #if NIMBLE_BLE_ADVERTISE && !MYNEWT_VAL(BLE_EXT_ADV)
