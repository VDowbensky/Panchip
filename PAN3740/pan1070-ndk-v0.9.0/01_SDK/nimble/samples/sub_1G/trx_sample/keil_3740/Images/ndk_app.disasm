;;;571    //--------------------------------------------------------------------------------------------------
;;;572    // _mtb_kvstore_buffered_crc_compute
;;;573    //--------------------------------------------------------------------------------------------------
;;;574    static cy_rslt_t _mtb_kvstore_buffered_crc_compute(mtb_kvstore_t* obj, uint32_t address,
;;;575                                                       uint32_t size, uint16_t* crc)
;;;576    {
;;;577        CY_ASSERT(obj != NULL);
;;;578        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;579        uint32_t remaining_size = size;
;;;580        while (remaining_size > 0)
;;;581        {
;;;582            uint32_t transfer_size = (obj->transaction_buffer_size >= remaining_size)
;;;583                                    ? remaining_size
;;;584                                    : obj->transaction_buffer_size;
;;;585    
;;;586            result = obj->bd->read(obj->bd->context, address, transfer_size, obj->transaction_buffer);
;;;587            if (result != CY_RSLT_SUCCESS)
;;;588            {
;;;589                return result;
;;;590            }
;;;591    
;;;592            *crc = _mtb_kvstore_crc16(obj->transaction_buffer, transfer_size, *crc);
;;;593    
;;;594            address += transfer_size;
;;;595            remaining_size -= transfer_size;
;;;596        }
;;;597        return result;
;;;598    }
