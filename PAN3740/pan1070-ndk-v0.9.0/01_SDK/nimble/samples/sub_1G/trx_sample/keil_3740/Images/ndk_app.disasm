;;;3490           ble_hs_unlock();
;;;3491           return BLE_HS_EINVAL;
;;;3492       }
;;;3493   
;;;3494       rc = ble_gap_periodic_adv_params_tx(instance, params);
;;;3495       if (rc) {
;;;3496           ble_hs_unlock();
;;;3497           return rc;
;;;3498       }
;;;3499   
;;;3500       ble_gap_slave[instance].periodic_configured = 1;
;;;3501   
;;;3502       ble_hs_unlock();
;;;3503   
;;;3504       return 0;
;;;3505   }
