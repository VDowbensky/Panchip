;;;627    ble_sm_proc_find(uint16_t conn_handle, uint8_t state, int is_initiator,
;;;628                     struct ble_sm_proc **out_prev)
;;;629    {
;;;630        struct ble_sm_proc *proc;
;;;631        struct ble_sm_proc *prev;
;;;632    
;;;633        // BLE_HS_DBG_ASSERT(ble_hs_locked_by_cur_task());
