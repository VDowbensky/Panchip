;;;2531   int
;;;2532   ble_gap_adv_start(uint8_t own_addr_type, const ble_addr_t *direct_addr,
;;;2533                     int32_t duration_ms,
;;;2534                     const struct ble_gap_adv_params *adv_params,
;;;2535                     ble_gap_event_fn *cb, void *cb_arg)
;;;2536   {
;;;2537   #if NIMBLE_BLE_ADVERTISE && !MYNEWT_VAL(BLE_EXT_ADV)
;;;2538       uint32_t duration_ticks = 0;
;;;2539       int rc;
;;;2540   
;;;2541       STATS_INC(ble_gap_stats, adv_start);
;;;2542   
;;;2543       ble_hs_lock();
;;;2544   
;;;2545       rc = ble_gap_adv_validate(own_addr_type, direct_addr, adv_params);
;;;2546       if (rc != 0) {
;;;2547           goto done;
;;;2548       }
;;;2549   
;;;2550       if (duration_ms != BLE_HS_FOREVER) {
;;;2551           rc = ble_npl_time_ms_to_ticks(duration_ms, &duration_ticks);
;;;2552           if (rc != 0) {
;;;2553               /* Duration too great. */
;;;2554               rc = BLE_HS_EINVAL;
;;;2555               goto done;
;;;2556           }
;;;2557       }
;;;2558   
;;;2559       if (!ble_hs_is_enabled()) {
;;;2560           rc = BLE_HS_EDISABLED;
;;;2561           goto done;
;;;2562       }
;;;2563   
;;;2564       if (ble_gap_is_preempted()) {
;;;2565           rc = BLE_HS_EPREEMPTED;
;;;2566           goto done;
;;;2567       }
;;;2568   
;;;2569       rc = ble_hs_id_use_addr(own_addr_type);
;;;2570       if (rc != 0) {
;;;2571           goto done;
;;;2572       }
;;;2573   
;;;2574       BLE_HS_LOG(INFO, "GAP procedure initiated: advertise; ");
;;;2575       ble_gap_log_adv(own_addr_type, direct_addr, adv_params);
;;;2576       // BLE_HS_LOG(INFO, "\n");
;;;2577   
;;;2578       ble_gap_slave[0].cb = cb;
;;;2579       ble_gap_slave[0].cb_arg = cb_arg;
;;;2580       ble_gap_slave[0].our_addr_type = own_addr_type;
;;;2581   
;;;2582       if (adv_params->conn_mode != BLE_GAP_CONN_MODE_NON) {
;;;2583           ble_gap_slave[0].connectable = 1;
;;;2584       } else {
;;;2585           ble_gap_slave[0].connectable = 0;
;;;2586       }
;;;2587   
;;;2588       rc = ble_gap_adv_params_tx(own_addr_type, direct_addr, adv_params);
;;;2589       if (rc != 0) {
;;;2590           goto done;
;;;2591       }
;;;2592   
;;;2593       ble_gap_slave[0].op = BLE_GAP_OP_S_ADV;
;;;2594   
;;;2595       rc = ble_gap_adv_enable_tx(1);
;;;2596       if (rc != 0) {
;;;2597           ble_gap_slave_reset_state(0);
;;;2598           goto done;
;;;2599       }
;;;2600   
;;;2601   #if SMP_MULTI_ADDR_MODE_EN
;;;2602       ble_hs_id_set_used_addr_type(own_addr_type);
;;;2603   #endif
;;;2604   
;;;2605       if (duration_ms != BLE_HS_FOREVER) {
;;;2606           ble_gap_slave_set_timer(duration_ticks);
;;;2607       }
;;;2608   
;;;2609       rc = 0;
;;;2610   
;;;2611   done:
;;;2612       ble_hs_unlock();
;;;2613   
;;;2614       if (rc != 0) {
;;;2615           STATS_INC(ble_gap_stats, adv_start_fail);
;;;2616       }
;;;2617       return rc;
;;;2618   #else
;;;2619       return BLE_HS_ENOTSUP;
;;;2620   #endif
;;;2621   }
