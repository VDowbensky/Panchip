;;;1058   /**
;;;1059    * Fills the supplied mbuf with the variable length Handles-Information-List
;;;1060    * field of a Find-By-Type-Value ATT response.
;;;1061    *
;;;1062    * @param req                   The Find-By-Type-Value-Request being responded
;;;1063    *                                  to.
;;;1064    * @param rxom                  The mbuf containing the received request.
;;;1065    * @param txom                  The destination mbuf where the
;;;1066    *                                  Handles-Information-List field gets
;;;1067    *                                  written.
;;;1068    * @param mtu                   The ATT L2CAP channel MTU.
;;;1069    *
;;;1070    * @return                      0 on success;
;;;1071    *                              BLE_HS_ENOENT if attribute not found;
;;;1072    *                              BLE_HS_EAPP on other error.
;;;1073    */
;;;1074   static int
;;;1075   ble_att_svr_fill_type_value(uint16_t conn_handle,
;;;1076                               uint16_t start_handle, uint16_t end_handle,
;;;1077                               ble_uuid16_t attr_type,
