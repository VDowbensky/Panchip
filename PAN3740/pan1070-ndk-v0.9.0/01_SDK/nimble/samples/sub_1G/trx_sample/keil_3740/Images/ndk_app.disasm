;;;379        // Ensure SoC LP configure is sleep mode (default state)
;;;380        SCB->SCR &= ~SCB_SCR_SLEEPDEEP_Msk;
;;;381        LP_SetSleepMode(ANA, LP_MODE_SEL_SLEEP_MODE);
;;;382    
;;;383    #if (CONFIG_LOW_SPEED_CLOCK_SRC == 0)  /*LP Clock from RCL, 32000 HZ default*/
;;;384        /* Enable RCL */
;;;385        CLK->RCL_CTRL_3V |= CLK_RCLCTL_RC32K_EN_Msk_3v;
;;;386        /* Wait for stable */
;;;387        while (!(CLK->RCL_CTRL_3V & CLK_STABLE_STATUS_Msk));
;;;388        /* Select RCL as SoC 32K clock source */
;;;389        CLK->CLK_TOP_CTRL_3V &= ~CLK_TOPCTL_32K_CLK_SEL_Msk_3v;
;;;390        /* Disable lp xtl src */
;;;391        ANA->LP_FL_CTRL_3V &= ~ANAC_FL_XTAL32K_EN_Msk_3v;
;;;392        ANA->LP_FL_CTRL_3V |= ANAC_FL_RC32K_EN_Msk_3v;
;;;393        /* Delay more than two 32K clock cycles */
;;;394        SYS_delay_10nop(250);
;;;395        /* Disable XTL */
;;;396        CLK->XTL_CTRL_3V &= ~CLK_XTLCTL_XTL_EN_Msk_3v;
;;;397    #if CONFIG_FORCE_CALIB_RCL_CLK
;;;398        /* Calibrate RCL to 32K Hz */
;;;399        calibrate_rcl_clk(32000);
;;;400    #endif /* CONFIG_FORCE_CALIB_RCL_CLK */
;;;401    #elif ( CONFIG_LOW_SPEED_CLOCK_SRC == 2)  /*LP Clock from ACT32K,32000 HZ default*/
;;;402        ANA->ACT_32K_CTRL |= (CLK_ACT32K_TMR_EN_Msk | CLK_ACT32K_LL_32KCLK_SEL_Msk);  /*LP Clock from XTL,32768 HZ default*/
;;;403    #else /*LP Clock from XTL, 32768 HZ */
;;;404    #ifdef XTL_SLOW_SETUP
;;;405        /* Enable XTL clock */
;;;406        CLK->XTL_CTRL_3V |= CLK_XTLCTL_XTL_EN_Msk_3v;
;;;407        while(!(CLK->XTL_CTRL_3V & CLK_XTLCTL_STABLE_Msk));
;;;408    #else // Quick Setup
;;;409        CLK->MEAS_CLK_CTRL = (CLK->MEAS_CLK_CTRL & ~(CLK_MEASCLK_XTH_DIV_Msk)) | (0x1e8 << CLK_MEASCLK_XTH_DIV_Pos);
;;;410        CLK->XTL_CTRL_3V = (CLK->XTL_CTRL_3V & ~(CLK_XTLCTL_DELAY_Msk_3v)) | (3 << CLK_XTLCTL_DELAY_Pos_3v);
;;;411        /* Enable quick startup */
;;;412        CLK->MEAS_CLK_CTRL |= CLK_MEASCLK_XTL_QUICK_EN_Msk;
;;;413        SYS_SET_MFP(P2, 0, XTL_C1_CLK);
;;;414        SYS_SET_MFP(P2, 1, XTL_C2_CLK);
;;;415        /* Enable XTL clock */
;;;416        CLK->XTL_CTRL_3V |= CLK_XTLCTL_XTL_EN_Msk_3v;
;;;417        /* Delay a while */
;;;418        SYS_delay_10nop(5000);
;;;419        /* Disable quick startup */
;;;420        CLK->MEAS_CLK_CTRL &= ~CLK_MEASCLK_XTL_QUICK_EN_Msk;
;;;421        SYS_SET_MFP(P2, 0, GPIO);
;;;422        SYS_SET_MFP(P2, 1, GPIO);
;;;423        /* Wait for stable */
;;;424        while (!(CLK->XTL_CTRL_3V & CLK_STABLE_STATUS_Msk)) {
;;;425            /* Busy wait */
;;;426            __NOP();
;;;427        }
;;;428    #endif /* XTL_SLOW_SETUP */
;;;429        /* Select XTL as current 32K clock */
;;;430        CLK->CLK_TOP_CTRL_3V |= CLK_TOPCTL_32K_CLK_SEL_Msk_3v;
;;;431        /* Delay more than two 32K clock cycles */
;;;432        SYS_delay_10nop(250);
