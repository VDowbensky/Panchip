;;;1926   
;;;1927       /* If peer RPA is not set in the event and peer address
;;;1928        * is RPA then store the peer RPA address so when the peer
;;;1929        * address is resolved, the RPA is not forgotten.
;;;1930        */
;;;1931       if (memcmp(BLE_ADDR_ANY->val, evt->peer_rpa, 6) == 0) {
;;;1932           if (BLE_ADDR_IS_RPA(&conn->bhc_peer_addr)) {
;;;1933               conn->bhc_peer_rpa_addr = conn->bhc_peer_addr;
;;;1934           }
;;;1935       } else {
