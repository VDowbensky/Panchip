;;;1957                * are already bonded to this peer).  In that case, we include the
;;;1958                * information in a notification to the app.
;;;1959                */
;;;1960               ble_sm_pair_rsp_fill(proc);
;;;1961               ble_sm_pair_cfg(proc);
;;;1962   
;;;1963               proc_flags = proc->flags;
;;;1964               key_size = proc->key_size;
;;;1965               res->execute = 1;
;;;1966           }
;;;1967       }
;;;1968   
;;;1969       ble_hs_unlock();
;;;1970   
;;;1971       /* Check if we are already bonded to this peer.  If so, give the
;;;1972        * application an opportunity to delete the old bond.
;;;1973        */
;;;1974       if (res->app_status == 0) {
;;;1975           rc = ble_sm_chk_repeat_pairing(conn_handle, proc_flags, key_size);
;;;1976           if (rc != 0) {
;;;1977               /* The app indicated that the pairing request should be ignored. */
;;;1978               res->app_status = rc;
;;;1979               res->execute = 0;
;;;1980           }
;;;1981       }
;;;1982   }
