;;;2016   /**
;;;2017    * Accumulates counts of each resource type required by the specified service
;;;2018    * definition array.  This function is generally used to calculate some host
;;;2019    * configuration values prior to initialization.  This function adds the counts
;;;2020    * to the appropriate fields in the supplied ble_gatt_resources object without
;;;2021    * clearing them first, so it can be called repeatedly with different inputs to
;;;2022    * calculate totals.  Be sure to zero the resource struct prior to the first
;;;2023    * call to this function.
;;;2024    *
;;;2025    * @param svcs                  The service array containing the resource
;;;2026    *                                  definitions to be counted.
;;;2027    * @param res                   The resource counts are accumulated in this
;;;2028    *                                  struct.
;;;2029    *
;;;2030    * @return                      0 on success;
;;;2031    *                              BLE_HS_EINVAL if the svcs array contains an
;;;2032    *                                  invalid resource definition.
;;;2033    */
;;;2034   static int
;;;2035   ble_gatts_count_resources(const struct ble_gatt_svc_def *svcs,
;;;2036                             struct ble_gatt_resources *res)
