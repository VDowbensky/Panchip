;;;1360   ble_gatts_send_next_indicate(uint16_t conn_handle)
;;;1361   {
;;;1362       struct ble_gatts_clt_cfg *clt_cfg;
;;;1363       struct ble_hs_conn *conn;
;;;1364       uint16_t chr_val_handle;
;;;1365       int rc;
;;;1366       int i;
