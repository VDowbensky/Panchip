;;;2024   
;;;2025               rc = ble_sm_io_action(proc, &ioact);
;;;2026               if (rc != 0) {
;;;2027                   res->sm_err = BLE_SM_ERR_AUTHREQ;
;;;2028                   res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_AUTHREQ);
;;;2029                   res->enc_cb = 1;
;;;2030               } else {
;;;2031                   proc->state = ble_sm_state_after_pair(proc);
