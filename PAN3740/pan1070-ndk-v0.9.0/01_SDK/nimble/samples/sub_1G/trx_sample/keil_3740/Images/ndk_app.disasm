;;;3424   /*
;;;3425    * -----------------------------------------------------------
;;;3426    * The Idle task.
;;;3427    * ----------------------------------------------------------
;;;3428    *
;;;3429    * The portTASK_FUNCTION() macro is used to allow port/compiler specific
;;;3430    * language extensions.  The equivalent prototype for this function is:
;;;3431    *
;;;3432    * void prvIdleTask( void *pvParameters );
;;;3433    *
;;;3434    */
;;;3435   static portTASK_FUNCTION( prvIdleTask, pvParameters )
;;;3436   {
;;;3437       /* Stop warnings. */
;;;3438       ( void ) pvParameters;
;;;3439   
;;;3440       /** THIS IS THE RTOS IDLE TASK - WHICH IS CREATED AUTOMATICALLY WHEN THE
;;;3441        * SCHEDULER IS STARTED. **/
;;;3442   
;;;3443       /* In case a task that has a secure context deletes itself, in which case
;;;3444        * the idle task is responsible for deleting the task's secure context, if
;;;3445        * any. */
;;;3446       portALLOCATE_SECURE_CONTEXT( configMINIMAL_SECURE_STACK_SIZE );
;;;3447   
;;;3448       for( ; ; )
;;;3449       {
;;;3450           /* See if any tasks have deleted themselves - if so then the idle task
;;;3451            * is responsible for freeing the deleted task's TCB and stack. */
;;;3452           prvCheckTasksWaitingTermination();
;;;3453   
;;;3454           #if ( configUSE_PREEMPTION == 0 )
;;;3455           {
;;;3456               /* If we are not using preemption we keep forcing a task switch to
;;;3457                * see if any other task has become available.  If we are using
;;;3458                * preemption we don't need to do this as any task becoming available
;;;3459                * will automatically get the processor anyway. */
;;;3460               taskYIELD();
;;;3461           }
;;;3462           #endif /* configUSE_PREEMPTION */
;;;3463   
;;;3464           #if ( ( configUSE_PREEMPTION == 1 ) && ( configIDLE_SHOULD_YIELD == 1 ) )
;;;3465           {
;;;3466               /* When using preemption tasks of equal priority will be
;;;3467                * timesliced.  If a task that is sharing the idle priority is ready
;;;3468                * to run then the idle task should yield before the end of the
;;;3469                * timeslice.
;;;3470                *
;;;3471                * A critical region is not required here as we are just reading from
;;;3472                * the list, and an occasional incorrect value will not matter.  If
;;;3473                * the ready list at the idle priority contains more than one task
;;;3474                * then a task other than the idle task is ready to execute. */
;;;3475               if( listCURRENT_LIST_LENGTH( &( pxReadyTasksLists[ tskIDLE_PRIORITY ] ) ) > ( UBaseType_t ) 1 )
;;;3476               {
;;;3477                   taskYIELD();
;;;3478               }
;;;3479               else
;;;3480               {
;;;3481                   mtCOVERAGE_TEST_MARKER();
;;;3482               }
;;;3483           }
;;;3484           #endif /* ( ( configUSE_PREEMPTION == 1 ) && ( configIDLE_SHOULD_YIELD == 1 ) ) */
;;;3485   
;;;3486           #if ( configUSE_IDLE_HOOK == 1 )
;;;3487           {
;;;3488               extern bool vApplicationIdleHook( void );
;;;3489   
;;;3490               /*
;;;3491                * Call the user defined function from within the idle task.  This
;;;3492                * allows the application designer to add background functionality
;;;3493                * without the overhead of a separate task.
;;;3494                * NOTE1: Return true to avoid falling into DeepSleep Flow.
;;;3495                * NOTE2: vApplicationIdleHook() MUST NOT, UNDER ANY CIRCUMSTANCES,
;;;3496                *        CALL A FUNCTION THAT MIGHT BLOCK.
;;;3497                */
;;;3498               if (vApplicationIdleHook()) {
;;;3499                   continue;
;;;3500               }
;;;3501           }
;;;3502           #endif /* configUSE_IDLE_HOOK */
;;;3503   
;;;3504           #if BLE_EN
;;;3505               extern void vApplicationUserHook( void );
;;;3506               vApplicationUserHook();
;;;3507           #endif
;;;3508   
;;;3509           /* This conditional compilation should use inequality to 0, not equality
;;;3510            * to 1.  This is to ensure portSUPPRESS_TICKS_AND_SLEEP() is called when
;;;3511            * user defined low power mode  implementations require
;;;3512            * configUSE_TICKLESS_IDLE to be set to a value other than 1. */
;;;3513           #if ( configUSE_TICKLESS_IDLE != 0 )
;;;3514           {
;;;3515               TickType_t xExpectedIdleTime;
;;;3516   
;;;3517               /* It is not desirable to suspend then resume the scheduler on
;;;3518                * each iteration of the idle task.  Therefore, a preliminary
;;;3519                * test of the expected idle time is performed without the
;;;3520                * scheduler suspended.  The result here is not necessarily
;;;3521                * valid. */
;;;3522               taskENTER_CRITICAL();
;;;3523               vTaskTickSet(lp_get_curr_tmr_cnt());
;;;3524               xExpectedIdleTime = prvGetExpectedIdleTime();
;;;3525               taskEXIT_CRITICAL();
;;;3526   
;;;3527               if( xExpectedIdleTime >= configEXPECTED_IDLE_TIME_BEFORE_SLEEP )
;;;3528               {
;;;3529                   vTaskSuspendAll();
;;;3530   
;;;3531                   if(xNextTaskUnblockTime >= xTickCount)
;;;3532                   {
;;;3533                       /* Now the scheduler is suspended, the expected idle
;;;3534                        * time can be sampled again, and this time its value can
;;;3535                        * be used. */
;;;3536                       // configASSERT( xNextTaskUnblockTime >= xTickCount );
;;;3537                       if(xNextTaskUnblockTime < xTickCount)
;;;3538                       {
;;;3539                           SYS_WRN("xNextTaskUnblockTime:%llu, xTickCount:%llu\n", xNextTaskUnblockTime, xTickCount);
;;;3540                       }
;;;3541                       taskENTER_CRITICAL();
;;;3542                       vTaskTickSet(lp_get_curr_tmr_cnt());
;;;3543                       xExpectedIdleTime = prvGetExpectedIdleTime();
;;;3544                       taskEXIT_CRITICAL();
;;;3545   
;;;3546                       /* Define the following macro to set xExpectedIdleTime to 0
;;;3547                        * if the application does not want
;;;3548                        * portSUPPRESS_TICKS_AND_SLEEP() to be called. */
;;;3549                       configPRE_SUPPRESS_TICKS_AND_SLEEP_PROCESSING( xExpectedIdleTime );
;;;3550   
;;;3551                       if( xExpectedIdleTime >= configEXPECTED_IDLE_TIME_BEFORE_SLEEP )
;;;3552                       {
;;;3553                           traceLOW_POWER_IDLE_BEGIN();
;;;3554                           portSUPPRESS_TICKS_AND_SLEEP( xExpectedIdleTime );
;;;3555                           traceLOW_POWER_IDLE_END();
;;;3556                       }
;;;3557                       else
;;;3558                       {
;;;3559                           mtCOVERAGE_TEST_MARKER();
;;;3560                       }
;;;3561                   }else
;;;3562                   {
;;;3563                       vTaskStepTick(0);
;;;3564                   }
;;;3565                   ( void ) xTaskResumeAll();
;;;3566               }
;;;3567               else
;;;3568               {
;;;3569                   mtCOVERAGE_TEST_MARKER();
;;;3570               }
;;;3571           }
;;;3572           #endif /* configUSE_TICKLESS_IDLE */
;;;3573       }
;;;3574   }
