;;;1453       int restore;
;;;1454   
;;;1455       uint16_t conn_handle = le16toh(ev->conn_handle);
;;;1456   
;;;1457       memset(&res, 0, sizeof res);
;;;1458   
;;;1459       ble_hs_lock();
;;;1460       proc = ble_sm_proc_find(conn_handle, BLE_SM_PROC_STATE_NONE, 0, NULL);
;;;1461       if (proc == NULL) {
;;;1462           /* The peer is attempting to restore a encrypted connection via the
;;;1463            * encryption procedure.  Create a proc entry to indicate that security
;;;1464            * establishment is in progress and execute the procedure after the
;;;1465            * mutex gets unlocked.
;;;1466            */
;;;1467           restore = 1;
