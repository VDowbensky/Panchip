;;;143    
;;;144    #if (CONFIG_SYSTEM_CLOCK == 32)
;;;145        CLK_HCLKConfig(1);
;;;146        CLK_SYSCLKConfig(CLK_DPLL_REF_CLKSEL_XTH, CLK_DPLL_OUT_64M);
;;;147    #elif (CONFIG_SYSTEM_CLOCK == 48)
;;;148        CLK_HCLKConfig(0);
;;;149        CLK_SYSCLKConfig(CLK_DPLL_REF_CLKSEL_XTH, CLK_DPLL_OUT_48M);
;;;150    #endif
