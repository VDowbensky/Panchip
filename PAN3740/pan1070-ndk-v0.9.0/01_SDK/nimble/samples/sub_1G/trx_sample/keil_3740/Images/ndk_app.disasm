;;;3030           {
;;;3031               #ifdef portALT_GET_RUN_TIME_COUNTER_VALUE
;;;3032                   portALT_GET_RUN_TIME_COUNTER_VALUE( ulTotalRunTime );
;;;3033               #else
;;;3034                   ulTotalRunTime = portGET_RUN_TIME_COUNTER_VALUE();
;;;3035               #endif
;;;3036   
;;;3037               /* Add the amount of time the task has been running to the
;;;3038                * accumulated time so far.  The time the task started running was
;;;3039                * stored in ulTaskSwitchedInTime.  Note that there is no overflow
;;;3040                * protection here so count values are only valid until the timer
;;;3041                * overflows.  The guard against negative values is to protect
;;;3042                * against suspect run time stat counter implementations - which
;;;3043                * are provided by the application, not the kernel. */
;;;3044               if( ulTotalRunTime > ulTaskSwitchedInTime )
;;;3045               {
;;;3046                   pxCurrentTCB->ulRunTimeCounter += ( ulTotalRunTime - ulTaskSwitchedInTime );
;;;3047               }
;;;3048               else
;;;3049               {
;;;3050                   mtCOVERAGE_TEST_MARKER();
;;;3051               }
;;;3052   
;;;3053               ulTaskSwitchedInTime = ulTotalRunTime;
;;;3054           }
;;;3055           #endif /* configGENERATE_RUN_TIME_STATS */
;;;3056   
;;;3057           /* Check for stack overflow, if configured. */
;;;3058           taskCHECK_FOR_STACK_OVERFLOW();
;;;3059   
;;;3060           /* Before the currently running task is switched out, save its errno. */
;;;3061           #if ( configUSE_POSIX_ERRNO == 1 )
;;;3062           {
;;;3063               pxCurrentTCB->iTaskErrno = FreeRTOS_errno;
;;;3064           }
;;;3065           #endif
;;;3066   
;;;3067           /* Select a new task to run using either the generic C or port
;;;3068            * optimised asm code. */
;;;3069           taskSELECT_HIGHEST_PRIORITY_TASK(); /*lint !e9079 void * is used as this macro is used with timers and co-routines too.  Alignment is known to be fine as the type of the pointer stored and retrieved is the same. */
;;;3070           traceTASK_SWITCHED_IN();
;;;3071   
;;;3072           /* After the new task is switched in, update the global errno. */
;;;3073           #if ( configUSE_POSIX_ERRNO == 1 )
;;;3074           {
;;;3075               FreeRTOS_errno = pxCurrentTCB->iTaskErrno;
;;;3076           }
;;;3077           #endif
;;;3078   
;;;3079           #if ( ( configUSE_NEWLIB_REENTRANT == 1 ) || ( configUSE_C_RUNTIME_TLS_SUPPORT == 1 ) )
;;;3080           {
;;;3081               /* Switch C-Runtime's TLS Block to point to the TLS
;;;3082                * Block specific to this task. */
;;;3083               configSET_TLS_BLOCK( pxCurrentTCB->xTLSBlock );
;;;3084           }
;;;3085           #endif
;;;3086       }
;;;3087   
;;;3088   }
