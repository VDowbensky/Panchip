;;;1473               proc->state = BLE_SM_PROC_STATE_LTK_RESTORE;
;;;1474               ble_sm_insert(proc);
;;;1475   
;;;1476               res.execute = 1;
;;;1477           }
;;;1478       } else if (proc->state == BLE_SM_PROC_STATE_SEC_REQ) {
;;;1479           /* Same as above, except we solicited the encryption procedure by
;;;1480            * sending a security request.
;;;1481            */
;;;1482           restore = 1;
;;;1483           proc->state = BLE_SM_PROC_STATE_LTK_RESTORE;
;;;1484           res.execute = 1;
;;;1485       } else if (proc->state == BLE_SM_PROC_STATE_LTK_START) {
;;;1486           /* Legacy pairing just completed.  Send the short term key to the
;;;1487            * controller.
;;;1488            */
;;;1489           restore = 0;
;;;1490           res.execute = 1;
;;;1491       } else {
;;;1492           /* The request is unexpected; nack and forget. */
;;;1493           restore = 0;
;;;1494           ble_sm_ltk_req_neg_reply_tx(conn_handle);
;;;1495           proc = NULL;
;;;1496       }
