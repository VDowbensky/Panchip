;;;3544                       taskEXIT_CRITICAL();
;;;3545   
;;;3546                       /* Define the following macro to set xExpectedIdleTime to 0
;;;3547                        * if the application does not want
;;;3548                        * portSUPPRESS_TICKS_AND_SLEEP() to be called. */
;;;3549                       configPRE_SUPPRESS_TICKS_AND_SLEEP_PROCESSING( xExpectedIdleTime );
