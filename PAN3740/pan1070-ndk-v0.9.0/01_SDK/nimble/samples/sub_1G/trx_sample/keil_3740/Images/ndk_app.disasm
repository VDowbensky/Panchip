;;;4426   
;;;4427       rc = ble_gap_disc_ext_validate(own_addr_type);
;;;4428       if (rc != 0) {
;;;4429           goto done;
;;;4430       }
;;;4431   
;;;4432       /* Make a copy of the parameter structure and fill unspecified values with
;;;4433        * defaults.
;;;4434        */
;;;4435   
;;;4436       if (uncoded_params) {
;;;4437           ble_gap_ext_scan_params_to_hci(uncoded_params, &ucp);
;;;4438           ble_gap_ext_disc_fill_dflts(limited, &ucp);
;;;4439   
;;;4440           /* XXX: We should do it only once */
;;;4441           if (!uncoded_params->passive) {
;;;4442               rc = ble_hs_id_use_addr(own_addr_type);
;;;4443               if (rc != 0) {
;;;4444                   goto done;
;;;4445               }
;;;4446           }
;;;4447       }
;;;4448   
;;;4449       if (coded_params) {
;;;4450           ble_gap_ext_scan_params_to_hci(coded_params, &cp);
;;;4451           ble_gap_ext_disc_fill_dflts(limited, &cp);
;;;4452   
;;;4453           /* XXX: We should do it only once */
;;;4454           if (!coded_params->passive) {
;;;4455               rc = ble_hs_id_use_addr(own_addr_type);
;;;4456               if (rc != 0) {
;;;4457                   goto done;
;;;4458               }
;;;4459           }
;;;4460       }
;;;4461   
;;;4462       ble_gap_master.disc.limited = limited;
;;;4463       ble_gap_master.cb = cb;
;;;4464       ble_gap_master.cb_arg = cb_arg;
;;;4465   
