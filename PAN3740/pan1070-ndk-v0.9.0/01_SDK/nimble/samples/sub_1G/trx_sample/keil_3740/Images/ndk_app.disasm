;;;490            next_exp_in = BLE_HS_FOREVER;
;;;491            now = ble_npl_time_get();
;;;492    
;;;493            ble_hs_lock();
;;;494    
;;;495            /* This loop performs one of two tasks:
;;;496             * 1. Determine if any connections need to be terminated due to timeout.
;;;497             *    If so, break out of the loop and terminate the connection.  This
;;;498             *    function will need to be executed again.
;;;499             * 2. Otherwise, determine when the next timeout will occur.
;;;500             */
;;;501            SLIST_FOREACH(conn, &ble_hs_conns, bhc_next) {
;;;502                if (!(conn->bhc_flags & BLE_HS_CONN_F_TERMINATING)) {
;;;503    
;;;504    #if MYNEWT_VAL(BLE_L2CAP_RX_FRAG_TIMEOUT) != 0
;;;505                    /* Check each connection's rx fragment timer.  If too much time
;;;506                     * passes after a partial packet is received, the connection is
;;;507                     * terminated.
;;;508                     */
;;;509                    if (conn->bhc_rx_chan != NULL) {
;;;510                        time_diff = conn->bhc_rx_timeout - now;
;;;511    
;;;512                        if (time_diff <= 0) {
;;;513                            /* ACL reassembly has timed out.  Remember the connection
;;;514                             * handle so it can be terminated after the mutex is
;;;515                             * unlocked.
;;;516                             */
;;;517                            conn_handle = conn->bhc_handle;
;;;518                            break;
;;;519                        }
;;;520    
;;;521                        /* Determine if this connection is the soonest to time out. */
;;;522                        if (time_diff < next_exp_in) {
;;;523                            next_exp_in = time_diff;
;;;524                        }
;;;525                    }
;;;526    #endif
;;;527    
;;;528    #if BLE_HS_ATT_SVR_QUEUED_WRITE_TMO
;;;529                    /* Check each connection's rx queued write timer.  If too much
;;;530                     * time passes after a prep write is received, the queue is
;;;531                     * cleared.
;;;532                     */
;;;533                    time_diff = ble_att_svr_ticks_until_tmo(&conn->bhc_att_svr, now);
;;;534                    if (time_diff <= 0) {
;;;535                        /* ACL reassembly has timed out.  Remember the connection
;;;536                         * handle so it can be terminated after the mutex is
;;;537                         * unlocked.
;;;538                         */
;;;539                        conn_handle = conn->bhc_handle;
;;;540                        break;
;;;541                    }
;;;542    
;;;543                    /* Determine if this connection is the soonest to time out. */
;;;544                    if (time_diff < next_exp_in) {
;;;545                        next_exp_in = time_diff;
;;;546                    }
;;;547    #endif
;;;548                }
;;;549            }
;;;550    
;;;551            ble_hs_unlock();
;;;552    
;;;553            /* If a connection has timed out, terminate it.  We need to repeatedly
;;;554             * call this function again to determine when the next timeout is.
;;;555             */
;;;556            if (conn_handle != BLE_HS_CONN_HANDLE_NONE) {
;;;557                ble_gap_terminate(conn_handle, BLE_ERR_REM_USER_CONN_TERM);
;;;558                continue;
;;;559            }
;;;560    
;;;561            return next_exp_in;
;;;562        }
;;;563    }
