;;;1156       ble_sm_connection_broken(conn_handle);
;;;1157       ble_gatts_connection_broken(conn_handle);
;;;1158       ble_gattc_connection_broken(conn_handle);
;;;1159       ble_hs_flow_connection_broken(conn_handle);;
;;;1160   
;;;1161       ble_hs_atomic_conn_delete(conn_handle);
