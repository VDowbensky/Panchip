;;;4856   /**
;;;4857    * Initiates a connect procedure.
;;;4858    *
;;;4859    * @param own_addr_type         The type of address the stack should use for
;;;4860    *                                  itself during connection establishment.
;;;4861    *                                      o BLE_OWN_ADDR_PUBLIC
