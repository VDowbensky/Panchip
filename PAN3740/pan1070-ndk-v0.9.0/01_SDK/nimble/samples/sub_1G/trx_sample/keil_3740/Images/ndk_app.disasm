;;;1174   //--------------------------------------------------------------------------------------------------
;;;1175   // _mtb_kvstore_garbage_collection
;;;1176   //--------------------------------------------------------------------------------------------------
;;;1177   static cy_rslt_t _mtb_kvstore_garbage_collection(mtb_kvstore_t* obj,
;;;1178                                                    const _mtb_kvstore_record_info_t* record_info)
;;;1179   {
;;;1180       CY_ASSERT(obj != NULL);
;;;1181       cy_rslt_t result = CY_RSLT_SUCCESS;
;;;1182   
;;;1183       // If we need to update a record then that the new size fits the space remaining space.
;;;1184       // Otherwise return area full error before copying over. We can do this because we track
;;;1185       // the actual consumed size so we use that to check if there is enough space to accommodate
;;;1186       // the updated record.
;;;1187       if ((record_info != NULL) && (record_info->update_rec_info != NULL))
;;;1188       {
;;;1189           // Note that the consumed size is not yet updated so we need to subtract the old record size
;;;1190           // while checking for space left.
;;;1191           uint32_t total_size = obj->consumed_size - record_info->consumed_size_info.old_record_size +
;;;1192                                 record_info->consumed_size_info.new_record_size;
;;;1193           if (total_size > _MTB_KVSTORE_AREA_SIZE(obj))
;;;1194           {
;;;1195               return MTB_KVSTORE_STORAGE_FULL_ERROR;
;;;1196           }
;;;1197       }
;;;1198   
;;;1199       /* Erase the GC area */
;;;1200       result = _mtb_kvstore_erase_area(obj, obj->gc_area_addr);
;;;1201       if (result != CY_RSLT_SUCCESS)
;;;1202       {
;;;1203           return result;
;;;1204       }
;;;1205   
;;;1206       uint32_t dst_offset = _mtb_kvstore_get_area_header_record_size(obj, obj->gc_area_addr);
;;;1207       for (uint32_t idx = 0; idx < obj->num_entries; idx++)
;;;1208       {
;;;1209           if ((record_info != NULL) && (idx == record_info->ram_tbl_idx))
;;;1210           {
;;;1211               continue;
;;;1212           }
;;;1213   
;;;1214           uint32_t dst_next_offset;
;;;1215           uint32_t src_offset = obj->ram_table[idx].offset;
;;;1216           result = _mtb_kvstore_copy_record(obj, obj->active_area_addr, src_offset, obj->gc_area_addr,
;;;1217                                             dst_offset, &dst_next_offset);
;;;1218           if (result != CY_RSLT_SUCCESS)
;;;1219           {
;;;1220               return result;
;;;1221           }
;;;1222   
;;;1223           obj->ram_table[idx].offset = dst_offset;
;;;1224           dst_offset = dst_next_offset;
;;;1225       }
;;;1226   
;;;1227       // We need to inject a record or delete a record in the case where there may not be enough space
;;;1228       // to add a new record for an update or delete operation.
;;;1229       if (record_info != NULL)
;;;1230       {
;;;1231           if (record_info->update_rec_info != NULL)
;;;1232           {
;;;1233               _mtb_kvstore_update_ram_table_info_t ram_tbl_info =
;;;1234               {
;;;1235                   .ram_tbl_idx  = record_info->ram_tbl_idx,
;;;1236                   .entry.hash   = record_info->update_rec_info->key_hash,
;;;1237                   .entry.offset = dst_offset
;;;1238               };
;;;1239   
;;;1240               result = _mtb_kvstore_write_record(obj, obj->gc_area_addr, dst_offset,
;;;1241                                                  record_info->update_rec_info->key,
;;;1242                                                  record_info->update_rec_info->data,
;;;1243                                                  record_info->update_rec_info->data_size,
;;;1244                                                  _MTB_KVSTORE_OPER_UPDATE,
;;;1245                                                  &ram_tbl_info, &record_info->consumed_size_info);
;;;1246               if (result != CY_RSLT_SUCCESS)
;;;1247               {
;;;1248                   return result;
;;;1249               }
;;;1250   
;;;1251               dst_offset += record_info->consumed_size_info.new_record_size;
;;;1252           }
;;;1253           else
;;;1254           {
;;;1255               _mtb_kvstore_update_ram_table_info_t ram_tbl_info =
