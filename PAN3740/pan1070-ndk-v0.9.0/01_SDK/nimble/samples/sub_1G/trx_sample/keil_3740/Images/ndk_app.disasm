;;;4515   
;;;4516   static int
;;;4517   ble_gap_disc_validate(uint8_t own_addr_type,
;;;4518                         const struct ble_gap_disc_params *disc_params)
;;;4519   {
;;;4520       if (disc_params == NULL) {
;;;4521           return BLE_HS_EINVAL;
;;;4522       }
;;;4523   
;;;4524       /* Check interval and window */
;;;4525       if ((disc_params->itvl < BLE_HCI_SCAN_ITVL_MIN) ||
;;;4526           (disc_params->itvl > BLE_HCI_SCAN_ITVL_MAX) ||
;;;4527           (disc_params->window < BLE_HCI_SCAN_WINDOW_MIN) ||
;;;4528           (disc_params->window > BLE_HCI_SCAN_WINDOW_MAX) ||
;;;4529           (disc_params->itvl < disc_params->window)) {
;;;4530           return BLE_HS_EINVAL;
;;;4531       }
;;;4532   
