;;;3367           else
;;;3368           {
;;;3369               *pxTicksToWait = ( TickType_t ) 0;
;;;3370               xReturn = pdTRUE;
;;;3371           }
;;;3372       }
;;;3373       taskEXIT_CRITICAL();
;;;3374   
;;;3375       return xReturn;
;;;3376   }
