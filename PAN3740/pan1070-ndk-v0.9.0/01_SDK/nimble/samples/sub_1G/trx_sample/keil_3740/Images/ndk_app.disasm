;;;1888               return rc;
;;;1889           }
;;;1890           break;
;;;1891   
;;;1892       default:
;;;1893           BLE_HS_DBG_ASSERT(0);
;;;1894           break;
;;;1895       }
;;;1896   
;;;1897       /* We verified that there is a free connection when the procedure began. */
;;;1898       conn = ble_hs_conn_alloc(evt->connection_handle);
;;;1899       BLE_HS_DBG_ASSERT(conn != NULL);
;;;1900   
;;;1901       conn->bhc_itvl = evt->conn_itvl;
