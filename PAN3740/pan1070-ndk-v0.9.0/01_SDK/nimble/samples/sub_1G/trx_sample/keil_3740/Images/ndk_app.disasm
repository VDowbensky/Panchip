;;;885        criteria = arg;
;;;886    
;;;887        time_diff = proc->exp_os_ticks - criteria->now;
;;;888    
;;;889        if (time_diff <= 0) {
;;;890            /* Procedure is expired. */
;;;891            return 1;
;;;892        }
;;;893    
;;;894        /* Procedure isn't expired; determine if it is the next to expire. */
;;;895        if (time_diff < criteria->next_exp_in) {
;;;896            criteria->next_exp_in = time_diff;
;;;897        }
;;;898        return 0;
;;;899    }
