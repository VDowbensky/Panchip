;;;95     /**
;;;96      * @brief Output a string
;;;97      *
;;;98      * Output a string on output installed by platform at init time. Some
;;;99      * printf-like formatting is available.
;;;100     *
;;;101     * Available formatting:
;;;102     * - %x/%X:  outputs a number in hexadecimal format
;;;103     * - %s:     outputs a null-terminated string
;;;104     * - %p:     pointer, same as %x with a 0x prefix
;;;105     * - %u:     outputs a number in unsigned decimal format
