;;;560        crc = _mtb_kvstore_get_header_crc(record_header, crc);
;;;561        crc = _mtb_kvstore_crc16((uint8_t*)key, record_header->key_size, crc);
;;;562        if ((data != NULL) && (record_header->data_size != 0))
;;;563        {
;;;564            crc = _mtb_kvstore_crc16(data, record_header->data_size, crc);
;;;565        }
;;;566    
;;;567        return crc;
;;;568    }
