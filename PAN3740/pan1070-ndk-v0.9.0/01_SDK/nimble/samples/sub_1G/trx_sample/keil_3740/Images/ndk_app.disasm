;;;639    
;;;640    //--------------------------------------------------------------------------------------------------
;;;641    // _mtb_kvstore_read_record
;;;642    //--------------------------------------------------------------------------------------------------
;;;643    static cy_rslt_t _mtb_kvstore_read_record(mtb_kvstore_t* obj,
;;;644                                              uint32_t area_address,
;;;645                                              uint32_t offset,
;;;646                                              _mtb_kvstore_record_header_t* record_header,
;;;647                                              const char* key,
;;;648                                              bool validate_key,
;;;649                                              uint8_t* data,
;;;650                                              uint32_t* data_size)
;;;651    {
;;;652        CY_ASSERT(obj != NULL);
;;;653        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;654        uint16_t crc = _MTB_KVSTORE_CRC_INIT_VAL;
;;;655    
;;;656        uint32_t record_start_addr = area_address + offset;
;;;657        uint8_t header_size = sizeof(_mtb_kvstore_record_header_t);
;;;658    
;;;659        CY_ASSERT(record_header != NULL);
;;;660    
;;;661        // Read header for the record
;;;662        result =
;;;663            obj->bd->read(obj->bd->context, record_start_addr, header_size, (uint8_t*)record_header);
;;;664        if (result != CY_RSLT_SUCCESS)
;;;665        {
;;;666            return result;
;;;667        }
;;;668    
;;;669        if ((record_header->magic == 0xFFFFFFFFU) || (record_header->magic == 0))
;;;670        {
;;;671            return MTB_KVSTORE_ERASED_DATA_ERROR;
;;;672        }
;;;673    
;;;674        if (record_header->magic != _MTB_KVSTORE_HEADER_MAGIC)
;;;675        {
;;;676            return MTB_KVSTORE_INVALID_DATA_ERROR;
;;;677        }
;;;678    
;;;679        if ((record_header->key_size == 0) || (record_header->key_size >= MTB_KVSTORE_MAX_KEY_SIZE))
;;;680        {
;;;681            return MTB_KVSTORE_INVALID_DATA_ERROR;
;;;682        }
;;;683    
;;;684        // If a data buffer is provided and the size is less that what is in the storage
;;;685        // return error.
;;;686        if ((data != NULL) && (data_size != NULL) && (*data_size < record_header->data_size))
;;;687        {
;;;688            *data_size = record_header->data_size;
;;;689            return MTB_KVSTORE_BUFFER_TOO_SMALL;
;;;690        }
;;;691    
;;;692        crc = _mtb_kvstore_get_header_crc(record_header, crc);
;;;693    
;;;694        // Copy key into the provided key area
;;;695        uint32_t key_addr = record_start_addr + record_header->header_size;
;;;696        if (key != NULL)
;;;697        {
;;;698            if (validate_key)
;;;699            {
;;;700                result = _mtb_kvstore_validate_key(obj, key_addr, key, record_header->key_size);
;;;701                if (result != CY_RSLT_SUCCESS)
;;;702                {
;;;703                    return result;
;;;704                }
;;;705            }
;;;706            else
;;;707            {
;;;708                result = obj->bd->read(obj->bd->context, key_addr, record_header->key_size,
;;;709                                       (uint8_t*)key);
;;;710                if (result != CY_RSLT_SUCCESS)
;;;711                {
;;;712                    return result;
;;;713                }
;;;714            }
;;;715    
;;;716            // If the user passes in a key for validation since at this point we have
;;;717            // validated that the key on the storage is the same as what was passes in
;;;718            // it should be ok to use the key passed in by the user for CRC calculation.
;;;719            crc = _mtb_kvstore_crc16((uint8_t*)key, record_header->key_size, crc);
;;;720        }
;;;721        else
;;;722        {
;;;723            // Start buffered CRC
;;;724            result = _mtb_kvstore_buffered_crc_compute(obj, key_addr, record_header->key_size, &crc);
;;;725            if (result != CY_RSLT_SUCCESS)
;;;726            {
;;;727                return result;
;;;728            }
;;;729        }
;;;730    
;;;731        uint32_t data_addr = key_addr + record_header->key_size;
;;;732        if ((data != NULL) && (data_size != NULL))
;;;733        {
;;;734            // Copy data into the data buffer provided
;;;735            result = obj->bd->read(obj->bd->context, data_addr, record_header->data_size, data);
;;;736            if (result != CY_RSLT_SUCCESS)
;;;737            {
;;;738                return result;
;;;739            }
;;;740    
;;;741            crc = _mtb_kvstore_crc16(data, record_header->data_size, crc);
;;;742        }
;;;743        else
;;;744        {
;;;745            result = _mtb_kvstore_buffered_crc_compute(obj, data_addr, record_header->data_size, &crc);
;;;746            if (result != CY_RSLT_SUCCESS)
;;;747            {
;;;748                return result;
;;;749            }
;;;750        }
;;;751    
;;;752        // If the CRC did not match then record is corrupted.
;;;753        if (record_header->crc != crc)
;;;754        {
;;;755            return MTB_KVSTORE_INVALID_DATA_ERROR;
;;;756        }
;;;757    
;;;758        if (data_size != NULL)
;;;759        {
;;;760            *data_size = record_header->data_size;
;;;761        }
;;;762    
;;;763        return result;
;;;764    }
