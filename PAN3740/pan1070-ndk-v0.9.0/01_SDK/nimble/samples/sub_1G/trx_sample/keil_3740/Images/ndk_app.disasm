;;;350            return -1;
;;;351        }
;;;352    
;;;353        // Find 32K blocks from the initial data chunk
;;;354        find_special_chunk_in_range(8, start_phy_sector_idx, sector_num, &block_32k_start_sector_idx, &block_32k_sector_num);
;;;355    
;;;356        if (block_32k_sector_num == 0) { // No 32k-block found
;;;357            // Do only sector erase
;;;358            for (size_t i = 0; i < sector_num; i++) {
;;;359                FMC_EraseSector(FLCTL, (start_phy_sector_idx + i - 1) * SECTOR_SIZE);
;;;360            }
;;;361        } else { // Found at least 1 32k-block
;;;362            // Do sector erase for leading sectors
;;;363            for (size_t i = 0; i < block_32k_start_sector_idx - start_phy_sector_idx; i++) {
;;;364                FMC_EraseSector(FLCTL, (start_phy_sector_idx + i - 1) * SECTOR_SIZE);
;;;365            }
;;;366            // Do sector erase for trailing sectors
;;;367            for (size_t i = 0; i < start_phy_sector_idx + sector_num - block_32k_start_sector_idx - block_32k_sector_num; i++) {
;;;368                FMC_EraseSector(FLCTL, (block_32k_start_sector_idx + block_32k_sector_num + i - 1) * SECTOR_SIZE);
;;;369            }
;;;370    
;;;371            // Find 64K blocks from the 32K-block chunk if there are
;;;372            find_special_chunk_in_range(16, block_32k_start_sector_idx, block_32k_sector_num, &block_64k_start_sector_idx, &block_64k_sector_num);
;;;373    
;;;374            if (block_64k_sector_num == 0) { // No 64k-block found
;;;375                // Do only block-32k erase
;;;376                for (size_t i = 0; i < block_32k_sector_num; i += 8) {
;;;377                    FMC_EraseBlock32k(FLCTL, (block_32k_start_sector_idx + i - 1) * SECTOR_SIZE);
;;;378                }
;;;379            } else { // Found at least 1 64k-block
;;;380                // Do block-32k erase for leading sectors if there are
;;;381                if (block_32k_start_sector_idx % 16 != 0) {
;;;382                    FMC_EraseBlock32k(FLCTL, (block_32k_start_sector_idx - 1) * SECTOR_SIZE);
;;;383                }
;;;384                // Do block-32k erase for trailing sectors if there are
;;;385                if ((block_32k_start_sector_idx + block_32k_sector_num) % 16 != 0) {
;;;386                    FMC_EraseBlock32k(FLCTL, (block_64k_start_sector_idx + block_64k_sector_num - 1) * SECTOR_SIZE);
;;;387                }
;;;388                // Do block_64k erase
;;;389                for (size_t i = 0; i < block_64k_sector_num; i += 16) {
;;;390                    FMC_EraseBlock64k(FLCTL, (block_64k_start_sector_idx + i - 1) * SECTOR_SIZE);
;;;391                }
;;;392            }
;;;393        }
;;;394    
;;;395        return 0;
;;;396    }
