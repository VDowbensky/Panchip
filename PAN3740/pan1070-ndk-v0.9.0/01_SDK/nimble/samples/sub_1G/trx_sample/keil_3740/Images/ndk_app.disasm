;;;1390       ble_hs_unlock();
;;;1391   
;;;1392       if (conn == NULL) {
;;;1393           return BLE_HS_ENOTCONN;
;;;1394       }
;;;1395   
;;;1396       if (chr_val_handle == 0) {
;;;1397           return BLE_HS_ENOENT;
;;;1398       }
;;;1399   
;;;1400       rc = ble_gatts_indicate(conn_handle, chr_val_handle);
;;;1401       if (rc != 0) {
;;;1402           return rc;
;;;1403       }
;;;1404   
;;;1405       return 0;
;;;1406   }
