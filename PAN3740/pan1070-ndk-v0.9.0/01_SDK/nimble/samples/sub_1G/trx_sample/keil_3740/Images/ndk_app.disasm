;;;340    
;;;341    /**
;;;342     * Calculates the number of ticks until a queued write times out on the
;;;343     * specified ATT server.  If this server is not in the process of receiving a
;;;344     * queued write, then BLE_HS_FOREVER is returned.  If a timeout just occurred,
;;;345     * 0 is returned.
;;;346     *
;;;347     * @param svr                   The ATT server to check.
;;;348     * @param now                   The current OS time.
;;;349     *
;;;350     * @return                      The number of ticks until the current queued
;;;351     *                                  write times out.
;;;352     */
;;;353    int32_t
;;;354    ble_att_svr_ticks_until_tmo(const struct ble_att_svr_conn *svr, ble_npl_time_t now)
;;;355    {
;;;356    #if BLE_HS_ATT_SVR_QUEUED_WRITE_TMO == 0
;;;357        return BLE_HS_FOREVER;
;;;358    #endif
;;;359    
;;;360        int32_t time_diff;
;;;361    
;;;362        if (SLIST_EMPTY(&svr->basc_prep_list)) {
;;;363            return BLE_HS_FOREVER;
;;;364        }
;;;365    
;;;366        time_diff = svr->basc_prep_timeout_at - now;
;;;367        if (time_diff < 0) {
;;;368            return 0;
;;;369        }
;;;370    
;;;371        return time_diff;
;;;372    }
