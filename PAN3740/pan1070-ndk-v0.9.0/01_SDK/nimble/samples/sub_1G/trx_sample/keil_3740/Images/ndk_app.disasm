;;;214      *            @arg CLK_APB1Periph_All
;;;215      * @param  NewState  : new state of the specified peripheral clock.
;;;216      *          This parameter can be: ENABLE or DISABLE.
;;;217      * @retval None
;;;218      */
;;;219    void CLK_APB1PeriphClockCmd(uint32_t CLK_APB1Periph, FunctionalState NewState)
;;;220    {
;;;221      (NewState != DISABLE)?(CLK->APB1_CLK_CTRL |= CLK_APB1Periph):(CLK->APB1_CLK_CTRL &= ~CLK_APB1Periph);
;;;222    }
