;;;1917           return;
;;;1918       }
;;;1919   
;;;1920       ble_hs_lock();
;;;1921   
;;;1922       proc = ble_sm_proc_alloc();
;;;1923       if (proc != NULL) {
;;;1924           proc->conn_handle = conn_handle;
;;;1925           proc->state = BLE_SM_PROC_STATE_PAIR;
;;;1926           ble_sm_insert(proc);
;;;1927   
;;;1928           proc->pair_req[0] = BLE_SM_OP_PAIR_REQ;
;;;1929           memcpy(proc->pair_req + 1, req, sizeof(*req));
;;;1930   
;;;1931           conn = ble_hs_conn_find_assert(proc->conn_handle);
;;;1932           if (conn->bhc_flags & BLE_HS_CONN_F_MASTER) {
;;;1933               res->sm_err = BLE_SM_ERR_CMD_NOT_SUPP;
;;;1934               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_CMD_NOT_SUPP);
;;;1935           } else if (MYNEWT_VAL(BLE_SM_SC_LVL) == 1) {
;;;1936               res->sm_err = BLE_SM_ERR_CMD_NOT_SUPP;
;;;1937               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_CMD_NOT_SUPP);
;;;1938           } else if (req->max_enc_key_size < BLE_SM_PAIR_KEY_SZ_MIN) {
;;;1939               res->sm_err = BLE_SM_ERR_ENC_KEY_SZ;
;;;1940               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_ENC_KEY_SZ);
;;;1941           } else if (req->max_enc_key_size > BLE_SM_PAIR_KEY_SZ_MAX) {
;;;1942               res->sm_err = BLE_SM_ERR_INVAL;
;;;1943               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_INVAL);
;;;1944           } else if (MYNEWT_VAL(BLE_SM_SC_ONLY) && (req->max_enc_key_size != BLE_SM_PAIR_KEY_SZ_MAX)) {
;;;1945               /* Fail if Secure Connections Only mode is on and remote does not meet
;;;1946               * key size requirements - MITM was checked in last step
;;;1947               */
