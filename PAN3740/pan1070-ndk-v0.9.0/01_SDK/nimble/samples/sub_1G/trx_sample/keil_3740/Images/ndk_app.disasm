;;;4856   /**
;;;4857    * Initiates a connect procedure.
;;;4858    *
;;;4859    * @param own_addr_type         The type of address the stack should use for
;;;4860    *                                  itself during connection establishment.
;;;4861    *                                      o BLE_OWN_ADDR_PUBLIC
;;;4862    *                                      o BLE_OWN_ADDR_RANDOM
;;;4863    *                                      o BLE_OWN_ADDR_RPA_PUBLIC_DEFAULT
;;;4864    *                                      o BLE_OWN_ADDR_RPA_RANDOM_DEFAULT
;;;4865    * @param peer_addr             The address of the peer to connect to.
;;;4866    *                                  If this parameter is NULL, the white list
;;;4867    *                                  is used.
;;;4868    * @param duration_ms           The duration of the discovery procedure.
;;;4869    *                                  On expiration, the procedure ends and a
;;;4870    *                                  BLE_GAP_EVENT_DISC_COMPLETE event is
;;;4871    *                                  reported.  Units are milliseconds.
;;;4872    * @param phy_mask              Define on which PHYs connection attempt should
;;;4873    *                                  be done
;;;4874    * @param phy_1m_conn_params     Additional arguments specifying the
;;;4875    *                                  particulars of the connect procedure. When
;;;4876    *                                  BLE_GAP_LE_PHY_1M_MASK is set in phy_mask
;;;4877    *                                  this parameter can be specify to null for
;;;4878    *                                  default values.
;;;4879    * @param phy_2m_conn_params     Additional arguments specifying the
;;;4880    *                                  particulars of the connect procedure. When
;;;4881    *                                  BLE_GAP_LE_PHY_2M_MASK is set in phy_mask
;;;4882    *                                  this parameter can be specify to null for
;;;4883    *                                  default values.
;;;4884    * @param phy_coded_conn_params  Additional arguments specifying the
;;;4885    *                                  particulars of the connect procedure. When
;;;4886    *                                  BLE_GAP_LE_PHY_CODED_MASK is set in
;;;4887    *                                  phy_mask this parameter can be specify to
;;;4888    *                                  null for default values.
;;;4889    * @param cb                    The callback to associate with this connect
;;;4890    *                                  procedure.  When the connect procedure
;;;4891    *                                  completes, the result is reported through
;;;4892    *                                  this callback.  If the connect procedure
;;;4893    *                                  succeeds, the connection inherits this
;;;4894    *                                  callback as its event-reporting mechanism.
;;;4895    * @param cb_arg                The optional argument to pass to the callback
;;;4896    *                                  function.
;;;4897    *
;;;4898    * @return                      0 on success;
;;;4899    *                              BLE_HS_EALREADY if a connection attempt is
;;;4900    *                                  already in progress;
;;;4901    *                              BLE_HS_EBUSY if initiating a connection is not
;;;4902    *                                  possible because scanning is in progress;
;;;4903    *                              BLE_HS_EDONE if the specified peer is already
;;;4904    *                                  connected;
;;;4905    *                              Other nonzero on error.
