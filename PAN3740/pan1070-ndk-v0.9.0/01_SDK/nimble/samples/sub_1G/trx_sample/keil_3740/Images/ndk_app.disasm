;;;2597           ble_gap_slave_reset_state(0);
;;;2598           goto done;
;;;2599       }
;;;2600   
;;;2601   #if SMP_MULTI_ADDR_MODE_EN
;;;2602       ble_hs_id_set_used_addr_type(own_addr_type);
;;;2603   #endif
;;;2604   
;;;2605       if (duration_ms != BLE_HS_FOREVER) {
;;;2606           ble_gap_slave_set_timer(duration_ticks);
;;;2607       }
;;;2608   
;;;2609       rc = 0;
;;;2610   
;;;2611   done:
;;;2612       ble_hs_unlock();
;;;2613   
;;;2614       if (rc != 0) {
;;;2615           STATS_INC(ble_gap_stats, adv_start_fail);
;;;2616       }
