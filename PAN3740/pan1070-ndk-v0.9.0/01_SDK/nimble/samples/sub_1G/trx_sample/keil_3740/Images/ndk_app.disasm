;;;1259           case BLE_ERR_UNSUPP_REM_FEATURE:
;;;1260               /* Peer reports that it doesn't support the procedure.  This should
;;;1261                * only happen if our controller sent the 4.1 Connection Parameters
;;;1262                * Request Procedure.  If we are the slave, fail over to the L2CAP
