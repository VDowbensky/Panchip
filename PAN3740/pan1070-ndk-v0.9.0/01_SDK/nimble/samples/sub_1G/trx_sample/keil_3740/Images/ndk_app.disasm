;;;440                break;
;;;441    
;;;442            case _MTB_KVSTORE_OPER_ADD:
;;;443                CY_ASSERT(obj->num_entries < obj->max_entries);
;;;444                CY_ASSERT(info->ram_tbl_idx <= obj->num_entries);
;;;445                if (info->ram_tbl_idx < obj->num_entries)
;;;446                {
;;;447                    memmove(&obj->ram_table[info->ram_tbl_idx + 1], &obj->ram_table[info->ram_tbl_idx],
;;;448                            (obj->num_entries - info->ram_tbl_idx) *
;;;449                            sizeof(mtb_kvstore_ram_table_entry_t));
;;;450                }
;;;451                obj->num_entries++;
;;;452                obj->ram_table[info->ram_tbl_idx].hash = info->entry.hash;
;;;453                obj->ram_table[info->ram_tbl_idx].offset = info->entry.offset;
;;;454                break;
;;;455    
;;;456            case _MTB_KVSTORE_OPER_UPDATE:
;;;457                obj->ram_table[info->ram_tbl_idx].hash = info->entry.hash;
;;;458                obj->ram_table[info->ram_tbl_idx].offset = info->entry.offset;
;;;459                break;
;;;460    
;;;461            default:
;;;462                CY_ASSERT(false);
;;;463        }
;;;464    }
;;;465    
;;;466    
;;;467    //--------------------------------------------------------------------------------------------------
;;;468    // _mtb_kvstore_update_consumed_size
;;;469    //--------------------------------------------------------------------------------------------------
;;;470    static void _mtb_kvstore_update_consumed_size(mtb_kvstore_t* obj,
;;;471                                                  _mtb_kvstore_operation_t operation,
;;;472                                                  const _mtb_kvstore_update_consumed_size_info_t* info)
;;;473    {
;;;474        switch (operation)
;;;475        {
;;;476            case _MTB_KVSTORE_OPER_DELETE:
;;;477                obj->consumed_size -= info->old_record_size;
;;;478                break;
;;;479    
;;;480            case _MTB_KVSTORE_OPER_UPDATE:
;;;481                obj->consumed_size = obj->consumed_size - info->old_record_size + info->new_record_size;
;;;482                break;
;;;483    
;;;484            case _MTB_KVSTORE_OPER_ADD:
;;;485                obj->consumed_size += info->new_record_size;
;;;486                break;
;;;487    
;;;488            default:
;;;489                CY_ASSERT(false);
;;;490        }
;;;491    }
