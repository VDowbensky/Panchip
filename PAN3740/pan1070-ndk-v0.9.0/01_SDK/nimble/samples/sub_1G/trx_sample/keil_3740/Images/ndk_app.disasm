;;;2314        * system call (or maximum API call) interrupt priority.  Interrupts that are
;;;2315        * above the maximum system call priority are kept permanently enabled, even
;;;2316        * when the RTOS kernel is in a critical section, but cannot make any calls to
;;;2317        * FreeRTOS API functions.  If configASSERT() is defined in FreeRTOSConfig.h
;;;2318        * then portASSERT_IF_INTERRUPT_PRIORITY_INVALID() will result in an assertion
;;;2319        * failure if a FreeRTOS API function is called from an interrupt that has been
;;;2320        * assigned a priority above the configured maximum system call priority.
;;;2321        * Only FreeRTOS functions that end in FromISR can be called from interrupts
;;;2322        * that have been assigned a priority at or (logically) below the maximum
;;;2323        * system call  interrupt priority.  FreeRTOS maintains a separate interrupt
;;;2324        * safe API to ensure interrupt entry is as fast and as simple as possible.
;;;2325        * More information (albeit Cortex-M specific) is provided on the following
;;;2326        * link: https://www.FreeRTOS.org/RTOS-Cortex-M3-M4.html */
;;;2327       portASSERT_IF_INTERRUPT_PRIORITY_INVALID();
;;;2328   
;;;2329       uxSavedInterruptStatus = portTICK_TYPE_SET_INTERRUPT_MASK_FROM_ISR();
;;;2330       {
;;;2331           xReturn = xTickCount;
;;;2332       }
;;;2333       portTICK_TYPE_CLEAR_INTERRUPT_MASK_FROM_ISR( uxSavedInterruptStatus );
;;;2334   
;;;2335       return xReturn;
;;;2336   }
