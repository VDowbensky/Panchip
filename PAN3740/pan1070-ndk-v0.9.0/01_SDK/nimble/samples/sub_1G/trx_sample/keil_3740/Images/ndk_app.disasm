;;;3263       #if ( configUSE_TICKLESS_IDLE != 0 )
;;;3264       {
;;;3265           /* If a task is blocked on a kernel object then xNextTaskUnblockTime
;;;3266            * might be set to the blocked task's time out time.  If the task is
;;;3267            * unblocked for a reason other than a timeout xNextTaskUnblockTime is
;;;3268            * normally left unchanged, because it is automatically reset to a new
;;;3269            * value when the tick count equals xNextTaskUnblockTime.  However if
;;;3270            * tickless idling is used it might be more important to enter sleep mode
;;;3271            * at the earliest possible time - so reset xNextTaskUnblockTime here to
;;;3272            * ensure it is updated at the earliest possible time. */
;;;3273           prvResetNextTaskUnblockTime();
;;;3274       }
;;;3275       #endif
;;;3276   
;;;3277       /* Remove the task from the delayed list and add it to the ready list.  The
;;;3278        * scheduler is suspended so interrupts will not be accessing the ready
;;;3279        * lists. */
;;;3280       listREMOVE_ITEM( &( pxUnblockedTCB->xStateListItem ) );
;;;3281       prvAddTaskToReadyList( pxUnblockedTCB );
;;;3282   
;;;3283       if( pxUnblockedTCB->uxPriority > pxCurrentTCB->uxPriority )
;;;3284       {
;;;3285           /* The unblocked task has a priority above that of the calling task, so
;;;3286            * a context switch is required.  This function is called with the
;;;3287            * scheduler suspended so xYieldPending is set so the context switch
;;;3288            * occurs immediately that the scheduler is resumed (unsuspended). */
;;;3289           xYieldPending = pdTRUE;
;;;3290       }
;;;3291   }
