;;;1227   void
;;;1228   ble_gap_rx_update_complete(const struct ble_hci_ev_le_subev_conn_upd_complete *ev)
;;;1229   {
;;;1230   #if NIMBLE_BLE_CONNECT
;;;1231       struct ble_gap_update_entry *entry;
