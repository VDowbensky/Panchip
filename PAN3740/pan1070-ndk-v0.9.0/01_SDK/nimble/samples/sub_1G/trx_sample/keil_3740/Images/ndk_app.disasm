;;;1937           memcpy(conn->bhc_peer_rpa_addr.val, evt->peer_rpa, 6);
;;;1938       }
;;;1939   
;;;1940       ble_hs_lock();
;;;1941   
;;;1942       memset(&event, 0, sizeof event);
;;;1943       ble_hs_conn_insert(conn);
;;;1944   
;;;1945       ble_hs_unlock();
;;;1946   
;;;1947       event.type = BLE_GAP_EVENT_CONNECT;
;;;1948       event.connect.conn_handle = evt->connection_handle;
;;;1949       event.connect.status = 0;
;;;1950   
;;;1951       ble_gap_event_listener_call(&event);
;;;1952       ble_gap_call_conn_event_cb(&event, evt->connection_handle);
;;;1953   
;;;1954       #if (MYNEWT_VAL_HOST_COMPATIBILITY_PATCH)
;;;1955       /*Disable slave feature here*/
;;;1956       #else
;;;1957       ble_gap_rd_rem_sup_feat_tx(evt->connection_handle);
;;;1958       #endif
;;;1959   
;;;1960       return 0;
;;;1961   #else
;;;1962       return BLE_HS_ENOTSUP;
;;;1963   #endif
;;;1964   }
