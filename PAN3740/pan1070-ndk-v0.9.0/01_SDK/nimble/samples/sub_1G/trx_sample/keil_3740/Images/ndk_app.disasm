;;;246    /**
;;;247      * @brief Erase a 32KB Block in Flash Memory.
;;;248      *
;;;249      * This function is used to erase a 32KB flash block
;;;250      * in flash code area.
;;;251      *
;;;252      * @note The 1st 28KB flash block is not allowed to be erased
;;;253      * as the Info Area resides in this physical 32KB flash block.
;;;254      * @note The 32KB flash block start address is 0x7000, 0xF000,
;;;255      * 0x17000, 0x1F000, 0x27000, 0x2F000, ...
;;;256      *
;;;257      * @param fmc: where fmc is a flash peripheral.
;;;258      * @param adr: where addr is a erase start address.
;;;259      * @retval 0: Success.
;;;260      * @retval -1: Fail.
;;;261      */
;;;262    int FMC_EraseBlock32k(FLCTL_T *fmc,unsigned long addr)
;;;263    {
;;;264        if ((addr >= FMC_GetFlashCodeAreaSize(fmc))
;;;265            || (addr < 0x7000)) {
;;;266            return -1;
;;;267        }
;;;268    
;;;269        // Ensure we will not touch the flash INFO area
;;;270        fmc->X_FL_CONFIG &= ~BIT1;  //clear info_en bit
;;;271        fmc->X_FL_CONFIG |= BIT2;   //set tx_address_transaction bit
;;;272    
;;;273        return FMC_Erase(fmc,addr,CMD_ERASE_32K);
;;;274    }
