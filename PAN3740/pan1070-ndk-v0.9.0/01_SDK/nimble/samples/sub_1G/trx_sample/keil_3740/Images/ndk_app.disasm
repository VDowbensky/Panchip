;;;1829   
;;;1830       STATS_INC(ble_gap_stats, rx_conn_complete);
;;;1831   
;;;1832       /* in that case *only* status field is valid so we determine role
;;;1833        * based on error code
;;;1834        */
;;;1835       if (evt->status != BLE_ERR_SUCCESS) {
