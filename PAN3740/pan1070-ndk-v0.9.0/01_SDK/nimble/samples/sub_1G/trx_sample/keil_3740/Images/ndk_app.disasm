;;;6173   
;;;6174   /**
;;;6175    * @brief Preempts the GAP if it is not already preempted.
;;;6176    *
;;;6177    * Aborts all active GAP procedures and prevents new ones from being started.
;;;6178    * This function is used to ensure an idle GAP so that the controller's
;;;6179    * resolving list can be modified.  When done accessing the resolving list, the
;;;6180    * caller must call `ble_gap_preempt_done()` to permit new GAP procedures.
;;;6181    *
;;;6182    * On preemption, all aborted GAP procedures are reported with a status or
;;;6183    * reason code of BLE_HS_EPREEMPTED.  An attempt to initiate a new GAP
;;;6184    * procedure during preemption fails with a return code of BLE_HS_EPREEMPTED.
;;;6185    */
;;;6186   void
;;;6187   ble_gap_preempt(void)
;;;6188   {
;;;6189       ble_hs_lock();
;;;6190   
;;;6191       if (!ble_gap_is_preempted()) {
;;;6192           ble_gap_preempt_no_lock();
;;;6193       }
;;;6194   
;;;6195       ble_hs_unlock();
;;;6196   }
;;;6197   
;;;6198   /**
;;;6199    * Takes GAP out of the preempted state, allowing new GAP procedures to be
;;;6200    * initiated.  This function should only be called after a call to
;;;6201    * `ble_gap_preempt()`.
;;;6202    */
;;;6203   
;;;6204   static struct ble_npl_mutex preempt_done_mutex;
;;;6205   
;;;6206   void
;;;6207   ble_gap_preempt_done(void)
;;;6208   {
;;;6209       struct ble_gap_event event;
