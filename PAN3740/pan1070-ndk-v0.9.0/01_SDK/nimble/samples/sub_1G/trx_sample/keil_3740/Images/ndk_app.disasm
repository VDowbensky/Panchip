;;;1070       }
;;;1071   
;;;1072       return 0;
;;;1073   
;;;1074   failed:
;;;1075       ble_hs_unlock();
;;;1076       ble_l2cap_sig_tx(conn_handle, txom);
;;;1077       return 0;
;;;1078   }
