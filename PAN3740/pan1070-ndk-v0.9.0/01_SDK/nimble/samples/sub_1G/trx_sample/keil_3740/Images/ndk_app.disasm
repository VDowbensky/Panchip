;;;3447   
;;;3448       for( ; ; )
;;;3449       {
;;;3450           /* See if any tasks have deleted themselves - if so then the idle task
;;;3451            * is responsible for freeing the deleted task's TCB and stack. */
;;;3452           prvCheckTasksWaitingTermination();
;;;3453   
;;;3454           #if ( configUSE_PREEMPTION == 0 )
;;;3455           {
;;;3456               /* If we are not using preemption we keep forcing a task switch to
;;;3457                * see if any other task has become available.  If we are using
;;;3458                * preemption we don't need to do this as any task becoming available
;;;3459                * will automatically get the processor anyway. */
;;;3460               taskYIELD();
;;;3461           }
;;;3462           #endif /* configUSE_PREEMPTION */
;;;3463   
;;;3464           #if ( ( configUSE_PREEMPTION == 1 ) && ( configIDLE_SHOULD_YIELD == 1 ) )
;;;3465           {
;;;3466               /* When using preemption tasks of equal priority will be
;;;3467                * timesliced.  If a task that is sharing the idle priority is ready
;;;3468                * to run then the idle task should yield before the end of the
;;;3469                * timeslice.
;;;3470                *
;;;3471                * A critical region is not required here as we are just reading from
;;;3472                * the list, and an occasional incorrect value will not matter.  If
;;;3473                * the ready list at the idle priority contains more than one task
;;;3474                * then a task other than the idle task is ready to execute. */
;;;3475               if( listCURRENT_LIST_LENGTH( &( pxReadyTasksLists[ tskIDLE_PRIORITY ] ) ) > ( UBaseType_t ) 1 )
;;;3476               {
;;;3477                   taskYIELD();
;;;3478               }
;;;3479               else
;;;3480               {
;;;3481                   mtCOVERAGE_TEST_MARKER();
;;;3482               }
;;;3483           }
;;;3484           #endif /* ( ( configUSE_PREEMPTION == 1 ) && ( configIDLE_SHOULD_YIELD == 1 ) ) */
