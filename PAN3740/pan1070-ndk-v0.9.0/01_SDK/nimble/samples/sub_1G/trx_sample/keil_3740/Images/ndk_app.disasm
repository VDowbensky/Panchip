;;;703        ble_hs_unlock();
;;;704    
;;;705        if (rc != 0) {
;;;706            goto done;
;;;707        }
;;;708    
;;;709        /* Just reuse the request buffer for the response. */
;;;710        txom = *rxom;
;;;711        *rxom = NULL;
;;;712        os_mbuf_adj(txom, OS_MBUF_PKTLEN(txom));
;;;713    
;;;714        cmd = ble_att_cmd_prepare(BLE_ATT_OP_MTU_RSP, sizeof(*cmd), txom);
;;;715        if (cmd == NULL) {
;;;716            *att_err = BLE_ATT_ERR_INSUFFICIENT_RES;
;;;717            rc = BLE_HS_ENOMEM;
