;;;2108       /* The scheduler is suspended if uxSchedulerSuspended is non-zero.  An increment
;;;2109        * is used to allow calls to vTaskSuspendAll() to nest. */
;;;2110       ++uxSchedulerSuspended;
;;;2111   
;;;2112       /* Enforces ordering for ports and optimised compilers that may otherwise place
;;;2113        * the above increment elsewhere. */
;;;2114       portMEMORY_BARRIER();
;;;2115   }
