;;;870    
;;;871    	err = ah(irk, addr->val + 3, hash);
;;;872    	if (err) {
;;;873    		return false;
;;;874    	}
;;;875    
;;;876    	return !memcmp(addr->val, hash, 3);
;;;877    }
