;;;1114       ble_gattc_extract_stalled(&stall_list);
;;;1115   
;;;1116       STAILQ_FOREACH(proc, &stall_list, next) {
;;;1117           resume_cb = ble_gattc_resume_dispatch_get(proc->op);
;;;1118           BLE_HS_DBG_ASSERT(resume_cb != NULL);
;;;1119   
;;;1120           proc->flags &= ~BLE_GATTC_PROC_F_STALLED;
;;;1121           rc = resume_cb(proc);
