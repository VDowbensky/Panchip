;;;1818   /**
;;;1819    * Processes an incoming connection-complete HCI event.
;;;1820    * instance parameter is valid only for slave connection.
;;;1821    */
;;;1822   int
;;;1823   ble_gap_rx_conn_complete(struct ble_gap_conn_complete *evt, uint8_t instance)
;;;1824   {
;;;1825   #if NIMBLE_BLE_CONNECT
;;;1826       struct ble_gap_event event;
;;;1827       struct ble_hs_conn *conn;
;;;1828       int rc;
;;;1829   
;;;1830       STATS_INC(ble_gap_stats, rx_conn_complete);
;;;1831   
;;;1832       /* in that case *only* status field is valid so we determine role
;;;1833        * based on error code
;;;1834        */
;;;1835       if (evt->status != BLE_ERR_SUCCESS) {
;;;1836           switch (evt->status) {
;;;1837           case BLE_ERR_DIR_ADV_TMO:
;;;1838               /* slave role (HD directed advertising)
;;;1839                *
;;;1840                * with ext advertising this is send from set terminated event
;;;1841                */
;;;1842   #if !MYNEWT_VAL(BLE_EXT_ADV)
