;;;362    void pan10xx_platform_init()
;;;363    {
;;;364    #if CONFIG_VECTOR_REMAP_TO_RAM
;;;365        static __ALIGNED(256) uint32_t ram_vector[64] = {0};
;;;366        extern uint32_t __Vectors;
