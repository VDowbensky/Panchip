;;;1121   void
;;;1122   ble_gap_conn_broken(uint16_t conn_handle, int reason)
;;;1123   {
;;;1124   #if NIMBLE_BLE_CONNECT
;;;1125       struct ble_gap_update_entry *entry;
;;;1126       struct ble_gap_snapshot snap;
;;;1127       struct ble_gap_event event;
