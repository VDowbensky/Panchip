;;;3811            * or if the sync is cancelled before receiving that event.
;;;3812            */
;;;3813           ble_gap_sync.op = BLE_GAP_OP_SYNC;
;;;3814           ble_gap_sync.cb = cb;
;;;3815           ble_gap_sync.cb_arg = cb_arg;
;;;3816           ble_gap_sync.psync = psync;
;;;3817       } else {
