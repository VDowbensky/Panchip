;;;2052   
;;;2053           /* Each service requires:
;;;2054            *     o 1 service
;;;2055            *     o 1 attribute
;;;2056            */
;;;2057           res->svcs++;
        0x00013eea:    880a        ..      LDRH     r2,[r1,#0]
        0x00013eec:    1c52        R.      ADDS     r2,r2,#1
        0x00013eee:    800a        ..      STRH     r2,[r1,#0]
;;;2058           res->attrs++;
        0x00013ef0:    894a        J.      LDRH     r2,[r1,#0xa]
        0x00013ef2:    1c52        R.      ADDS     r2,r2,#1
        0x00013ef4:    814a        J.      STRH     r2,[r1,#0xa]
;;;2059   
;;;2060           if (svc->includes != NULL) {
        0x00013ef6:    68b3        .h      LDR      r3,[r6,#8]
        0x00013ef8:    2b00        .+      CMP      r3,#0
        0x00013efa:    d00f        ..      BEQ      0x13f1c ; ble_gatts_count_cfg + 96
;;;2061               for (i = 0; svc->includes[i] != NULL; i++) {
        0x00013efc:    681b        .h      LDR      r3,[r3,#0]
        0x00013efe:    2200        ."      MOVS     r2,#0
        0x00013f00:    2b00        .+      CMP      r3,#0
