;;;1072   //--------------------------------------------------------------------------------------------------
;;;1073   static cy_rslt_t _mtb_kvstore_find_record_in_ram_table(mtb_kvstore_t* obj, const char* key,
;;;1074                                                          uint32_t* ram_table_idx, uint16_t* key_hash,
;;;1075                                                          uint32_t* data_size)
