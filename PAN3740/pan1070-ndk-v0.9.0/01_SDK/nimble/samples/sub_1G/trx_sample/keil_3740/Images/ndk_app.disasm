;;;1951   static int
;;;1952   ble_att_svr_build_write_rsp(struct os_mbuf **rxom, struct os_mbuf **out_txom,
;;;1953                               uint8_t *att_err)
;;;1954   {
;;;1955       struct os_mbuf *txom;
;;;1956       int rc;
;;;1957   
;;;1958       /* Allocate a new buffer for the response.  A write response never reuses
