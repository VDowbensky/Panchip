;;;950     * Checks if the specified peer is already bonded.  If it is, the application
;;;951     * is queried about how to proceed: retry or ignore.  The application should
;;;952     * only indicate a retry if it deleted the old bond.
;;;953     *
;;;954     * @param conn_handle           The handle of the connection over which the
;;;955     *                                  pairing request was received.
;;;956     * @param proc_flags            The security flags associated with the
;;;957     *                                  conflicting SM procedure.
;;;958     * @param key_size              The key size of the conflicting SM procedure.
;;;959     *
;;;960     * @return                      0 if the procedure should continue;
;;;961     *                              nonzero if the request should be ignored.
;;;962     */
;;;963    static int
;;;964    ble_sm_chk_repeat_pairing(uint16_t conn_handle,
;;;965                              ble_sm_proc_flags proc_flags,
;;;966                              uint8_t key_size)
;;;967    {
;;;968        struct ble_gap_repeat_pairing rp;
;;;969        struct ble_store_value_sec bond;
;;;970        int rc;
;;;971    
;;;972        do {
;;;973            /* If the peer isn't bonded, indicate that the pairing procedure should
;;;974             * continue.
;;;975             */
;;;976            rc = ble_sm_read_bond(conn_handle, &bond);
;;;977            switch (rc) {
;;;978            case 0:
;;;979                break;
;;;980            case BLE_HS_ENOENT:
;;;981                return 0;
;;;982            default:
;;;983                return rc;
;;;984            }
;;;985    
;;;986            /* Peer is already bonded.  Ask the application what to do about it. */
;;;987            rp.conn_handle = conn_handle;
;;;988            rp.cur_key_size = bond.key_size;
;;;989            rp.cur_authenticated = bond.authenticated;
;;;990            rp.cur_sc = bond.sc;
;;;991    
;;;992            rp.new_key_size = key_size;
;;;993            rp.new_authenticated = !!(proc_flags & BLE_SM_PROC_F_AUTHENTICATED);
;;;994            rp.new_sc = !!(proc_flags & BLE_SM_PROC_F_SC);
;;;995            rp.new_bonding = !!(proc_flags & BLE_SM_PROC_F_BONDING);
;;;996    
;;;997            rc = ble_gap_repeat_pairing_event(&rp);
;;;998        } while (rc == BLE_GAP_REPEAT_PAIRING_RETRY);
;;;999    
;;;1000       BLE_HS_LOG(DEBUG, "silently ignoring pair request from bonded peer");
;;;1001   
;;;1002       return BLE_HS_EALREADY;
;;;1003   }
