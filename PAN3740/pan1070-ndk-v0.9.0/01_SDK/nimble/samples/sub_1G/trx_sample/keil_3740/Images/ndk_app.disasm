;;;1904           ble_sm_proc_remove(proc, prev);
;;;1905           ble_sm_proc_free(proc);
;;;1906       }
;;;1907   
;;;1908       ble_hs_unlock();
;;;1909   
;;;1910       /* Check if there is storage capacity for a new bond.  If there isn't, ask
;;;1911        * the application to make room.
