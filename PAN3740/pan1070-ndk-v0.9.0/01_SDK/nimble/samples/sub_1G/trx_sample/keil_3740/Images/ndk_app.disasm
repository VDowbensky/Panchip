;;;1844                   ble_gap_adv_finished(0, 0, 0, 0);
;;;1845               }
;;;1846   #endif
;;;1847               break;
;;;1848           case BLE_ERR_UNK_CONN_ID:
;;;1849               /* master role */
;;;1850               if (ble_gap_master_in_progress()) {
;;;1851                   /* Connect procedure successfully cancelled. */
;;;1852                   if (ble_gap_master.preempted_op == BLE_GAP_OP_M_CONN) {
;;;1853                       ble_gap_master_failed(BLE_HS_EPREEMPTED);
;;;1854                   } else {
;;;1855                       ble_gap_master_connect_cancelled();
;;;1856                   }
;;;1857               }
;;;1858               break;
;;;1859           default:
;;;1860               /* this should never happen, unless controller is broken */
;;;1861               BLE_HS_LOG(INFO, "controller reported invalid error code in conn"
;;;1862                                "complete event: %u", evt->status);
;;;1863               assert(0);
;;;1864               break;
;;;1865           }
;;;1866           return 0;
;;;1867       }
;;;1868   
;;;1869       /* Apply the event to the existing connection if it exists. */
;;;1870       if (ble_hs_atomic_conn_flags(evt->connection_handle, NULL) == 0) {
;;;1871           /* XXX: Does this ever happen? */
;;;1872           return 0;
;;;1873       }
;;;1874   
;;;1875       /* This event refers to a new connection. */
;;;1876   
;;;1877       switch (evt->role) {
;;;1878       case BLE_HCI_LE_CONN_COMPLETE_ROLE_MASTER:
;;;1879           rc = ble_gap_accept_master_conn();
;;;1880           if (rc != 0) {
;;;1881               return rc;
;;;1882           }
;;;1883           break;
;;;1884   
;;;1885       case BLE_HCI_LE_CONN_COMPLETE_ROLE_SLAVE:
;;;1886           rc = ble_gap_accept_slave_conn(instance);
;;;1887           if (rc != 0) {
;;;1888               return rc;
;;;1889           }
;;;1890           break;
;;;1891   
;;;1892       default:
;;;1893           BLE_HS_DBG_ASSERT(0);
;;;1894           break;
;;;1895       }
;;;1896   
;;;1897       /* We verified that there is a free connection when the procedure began. */
;;;1898       conn = ble_hs_conn_alloc(evt->connection_handle);
;;;1899       BLE_HS_DBG_ASSERT(conn != NULL);
;;;1900   
;;;1901       conn->bhc_itvl = evt->conn_itvl;
;;;1902       conn->bhc_latency = evt->conn_latency;
;;;1903       conn->bhc_supervision_timeout = evt->supervision_timeout;
;;;1904       conn->bhc_master_clock_accuracy = evt->master_clk_acc;
;;;1905       if (evt->role == BLE_HCI_LE_CONN_COMPLETE_ROLE_MASTER) {
;;;1906           conn->bhc_cb = ble_gap_master.cb;
;;;1907           conn->bhc_cb_arg = ble_gap_master.cb_arg;
;;;1908           conn->bhc_flags |= BLE_HS_CONN_F_MASTER;
;;;1909           conn->bhc_our_addr_type = ble_gap_master.conn.our_addr_type;
;;;1910           ble_gap_master_reset_state();
;;;1911       } else {
;;;1912           conn->bhc_cb = ble_gap_slave[instance].cb;
;;;1913           conn->bhc_cb_arg = ble_gap_slave[instance].cb_arg;
;;;1914           conn->bhc_our_addr_type = ble_gap_slave[instance].our_addr_type;
;;;1915   #if MYNEWT_VAL(BLE_EXT_ADV)
;;;1916           memcpy(conn->bhc_our_rnd_addr, ble_gap_slave[instance].rnd_addr, 6);
