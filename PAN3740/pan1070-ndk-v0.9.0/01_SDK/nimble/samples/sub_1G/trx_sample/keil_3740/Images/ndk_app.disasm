;;;1097       STAILQ_FOREACH(ha, &ble_att_svr_list, ha_next) {
;;;1098           if (ha->ha_handle_id < start_handle) {
;;;1099               continue;
;;;1100           }
;;;1101   
;;;1102           /* Continue to look for end of group in case group is in progress. */
;;;1103           if (!first && ha->ha_handle_id > end_handle) {
;;;1104               break;
;;;1105           }
;;;1106   
;;;1107           /* With group in progress, check if current attribute ends it. */
;;;1108           if (first) {
;;;1109               if (!ble_att_svr_is_valid_group_end(&attr_type.u, ha->ha_uuid)) {
;;;1110                   prev = ha->ha_handle_id;
;;;1111                   continue;
;;;1112               }
;;;1113   
;;;1114               rc = ble_att_svr_fill_type_value_entry(txom, first, prev, mtu,
;;;1115                                                      out_att_err);
;;;1116               if (rc != BLE_HS_EAGAIN) {
;;;1117                   goto done;
;;;1118               }
;;;1119   
;;;1120               first = 0;
;;;1121               prev = 0;
;;;1122   
;;;1123               /* Break in case we were just looking for end of group past the end
;;;1124                * handle ID. */
;;;1125               if (ha->ha_handle_id > end_handle) {
;;;1126                   break;
;;;1127               }
;;;1128           }
