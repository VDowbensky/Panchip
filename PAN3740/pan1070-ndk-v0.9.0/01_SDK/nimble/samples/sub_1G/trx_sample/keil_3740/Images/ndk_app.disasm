;;;592            *crc = _mtb_kvstore_crc16(obj->transaction_buffer, transfer_size, *crc);
;;;593    
;;;594            address += transfer_size;
;;;595            remaining_size -= transfer_size;
;;;596        }
;;;597        return result;
;;;598    }
