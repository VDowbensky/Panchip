;;;1569                                                                  strlen(key),
;;;1570                                                                  old_record_data_size);
;;;1571   
;;;1572       if (((operation == _MTB_KVSTORE_OPER_UPDATE) || (operation == _MTB_KVSTORE_OPER_ADD)) &&
