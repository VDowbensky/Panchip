;;;3015   CONFIG_RAM_CODE void vTaskSwitchContext( void )
;;;3016   {
;;;3017   
;;;3018       if( uxSchedulerSuspended != ( UBaseType_t ) pdFALSE )
;;;3019       {
;;;3020           /* The scheduler is currently suspended - do not allow a context
;;;3021            * switch. */
