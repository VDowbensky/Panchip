;;;1057   
;;;1058   /**
;;;1059    * Fills the supplied mbuf with the variable length Handles-Information-List
;;;1060    * field of a Find-By-Type-Value ATT response.
;;;1061    *
;;;1062    * @param req                   The Find-By-Type-Value-Request being responded
;;;1063    *                                  to.
;;;1064    * @param rxom                  The mbuf containing the received request.
;;;1065    * @param txom                  The destination mbuf where the
;;;1066    *                                  Handles-Information-List field gets
;;;1067    *                                  written.
;;;1068    * @param mtu                   The ATT L2CAP channel MTU.
;;;1069    *
;;;1070    * @return                      0 on success;
;;;1071    *                              BLE_HS_ENOENT if attribute not found;
;;;1072    *                              BLE_HS_EAPP on other error.
;;;1073    */
;;;1074   static int
;;;1075   ble_att_svr_fill_type_value(uint16_t conn_handle,
;;;1076                               uint16_t start_handle, uint16_t end_handle,
;;;1077                               ble_uuid16_t attr_type,
;;;1078                               struct os_mbuf *rxom, struct os_mbuf *txom,
;;;1079                               uint16_t mtu, uint8_t *out_att_err)
;;;1080   {
;;;1081       struct ble_att_svr_entry *ha;
;;;1082       uint8_t buf[16];
;;;1083       uint16_t attr_len;
;;;1084       uint16_t first;
;;;1085       uint16_t prev;
;;;1086       int any_entries;
;;;1087       int rc;
;;;1088   
;;;1089       first = 0;
;;;1090       prev = 0;
;;;1091       rc = 0;
;;;1092   
;;;1093       /* Iterate through the attribute list, keeping track of the current
;;;1094        * matching group.  For each attribute entry, determine if data needs to be
;;;1095        * written to the response.
;;;1096        */
;;;1097       STAILQ_FOREACH(ha, &ble_att_svr_list, ha_next) {
;;;1098           if (ha->ha_handle_id < start_handle) {
;;;1099               continue;
;;;1100           }
;;;1101   
;;;1102           /* Continue to look for end of group in case group is in progress. */
;;;1103           if (!first && ha->ha_handle_id > end_handle) {
;;;1104               break;
;;;1105           }
;;;1106   
;;;1107           /* With group in progress, check if current attribute ends it. */
;;;1108           if (first) {
;;;1109               if (!ble_att_svr_is_valid_group_end(&attr_type.u, ha->ha_uuid)) {
;;;1110                   prev = ha->ha_handle_id;
;;;1111                   continue;
;;;1112               }
;;;1113   
;;;1114               rc = ble_att_svr_fill_type_value_entry(txom, first, prev, mtu,
;;;1115                                                      out_att_err);
;;;1116               if (rc != BLE_HS_EAGAIN) {
;;;1117                   goto done;
;;;1118               }
;;;1119   
;;;1120               first = 0;
;;;1121               prev = 0;
;;;1122   
;;;1123               /* Break in case we were just looking for end of group past the end
;;;1124                * handle ID. */
;;;1125               if (ha->ha_handle_id > end_handle) {
;;;1126                   break;
;;;1127               }
;;;1128           }
;;;1129   
;;;1130           /* Compare the attribute type and value to the request fields to
;;;1131            * determine if this attribute matches.
;;;1132            */
;;;1133           if (ble_uuid_cmp(ha->ha_uuid, &attr_type.u) == 0) {
;;;1134               rc = ble_att_svr_read_flat(conn_handle, ha, 0, sizeof buf, buf,
;;;1135                                          &attr_len, out_att_err);
;;;1136               if (rc != 0) {
;;;1137                   goto done;
;;;1138               }
