;;;1308   /**
;;;1309    * Schedules a notification or indication for the specified peer-CCCD pair.  If
;;;1310    * the update should be sent immediately, it is indicated in the return code.
;;;1311    *
;;;1312    * @param conn                  The connection to schedule the update for.
;;;1313    * @param clt_cfg               The client config entry corresponding to the
;;;1314    *                                  peer and affected characteristic.
;;;1315    *
;;;1316    * @return                      The att_op of the update to send immediately,
;;;1317    *                                  if any.  0 if nothing should get sent.
;;;1318    */
;;;1319   static uint8_t
;;;1320   ble_gatts_schedule_update(struct ble_hs_conn *conn,
;;;1321                             struct ble_gatts_clt_cfg *clt_cfg)
;;;1322   {
;;;1323       uint8_t att_op;
;;;1324   
;;;1325       if (!(clt_cfg->flags & BLE_GATTS_CLT_CFG_F_MODIFIED)) {
;;;1326           /* Characteristic not modified.  Nothing to send. */
;;;1327           att_op = 0;
;;;1328       } else if (clt_cfg->flags & BLE_GATTS_CLT_CFG_F_NOTIFY) {
;;;1329           /* Notifications always get sent immediately. */
;;;1330           att_op = BLE_ATT_OP_NOTIFY_REQ;
;;;1331       } else if (clt_cfg->flags & BLE_GATTS_CLT_CFG_F_INDICATE) {
;;;1332           /* Only one outstanding indication per peer is allowed.  If we
;;;1333            * are still awaiting an ack, mark this CCCD as updated so that
;;;1334            * we know to send the indication upon receiving the expected ack.
;;;1335            * If there isn't an outstanding indication, send this one now.
;;;1336            */
;;;1337           if (conn->bhc_gatt_svr.indicate_val_handle != 0) {
;;;1338               att_op = 0;
;;;1339           } else {
;;;1340               att_op = BLE_ATT_OP_INDICATE_REQ;
;;;1341           }
;;;1342       } else {
;;;1343           /* Peer isn't subscribed to notifications or indications.  Nothing to
;;;1344            * send.
;;;1345            */
;;;1346           att_op = 0;
;;;1347       }
;;;1348   
;;;1349       /* If we will be sending an update, clear the modified flag so that we
;;;1350        * don't double-send.
;;;1351        */
;;;1352       if (att_op != 0) {
;;;1353           clt_cfg->flags &= ~BLE_GATTS_CLT_CFG_F_MODIFIED;
;;;1354       }
;;;1355   
;;;1356       return att_op;
;;;1357   }
