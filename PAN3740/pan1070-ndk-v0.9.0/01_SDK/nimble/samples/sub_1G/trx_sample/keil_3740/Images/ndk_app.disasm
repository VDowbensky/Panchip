;;;1269                                         ble_npl_time_ms_to_ticks32(BLE_GAP_UPDATE_TIMEOUT_MS);
;;;1270               }
;;;1271               break;
;;;1272   
;;;1273           default:
;;;1274               break;
;;;1275           }
;;;1276       }
;;;1277   
;;;1278       /* We aren't failing over to L2CAP, the update procedure is complete. */
;;;1279       if (l2cap_params.itvl_min == 0) {
;;;1280           entry = ble_gap_update_entry_remove(conn_handle);
;;;1281           ble_gap_update_entry_free(entry);
;;;1282       }
;;;1283   
;;;1284       ble_hs_unlock();
;;;1285   
;;;1286       if (l2cap_params.itvl_min != 0) {
;;;1287           rc = ble_l2cap_sig_update(conn_handle, &l2cap_params,
;;;1288                                     ble_gap_update_l2cap_cb, NULL);
;;;1289           if (rc == 0) {
;;;1290               call_cb = 0;
;;;1291           } else {
;;;1292               call_cb = 1;
;;;1293               cb_status = rc;
;;;1294           }
;;;1295       } else {
;;;1296           call_cb = 1;
;;;1297           cb_status = BLE_HS_HCI_ERR(ev->status);
;;;1298       }
;;;1299   
;;;1300       if (call_cb) {
;;;1301           ble_gap_update_notify(conn_handle, cb_status);
;;;1302       }
;;;1303   #endif
