;;;497    static cy_rslt_t _mtb_kvstore_erase_area(mtb_kvstore_t* obj, uint32_t area_address)
;;;498    {
;;;499        // This function operates on the assumption that erasing a sector is atomic. We first erase
;;;500        // everything but the first sector.
;;;501        uint32_t erase_size = obj->bd->erase_size(obj->bd->context, area_address);
;;;502    
;;;503        // Erase from second sector to the end
;;;504        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;505        if (erase_size < _MTB_KVSTORE_AREA_SIZE(obj))
;;;506        {
;;;507            result = obj->bd->erase(obj->bd->context, area_address + erase_size,
;;;508                                    _MTB_KVSTORE_AREA_SIZE(obj) - erase_size);
;;;509        }
;;;510    
;;;511        if (result == CY_RSLT_SUCCESS)
;;;512        {
;;;513            // Erase the first sector.
;;;514            result = obj->bd->erase(obj->bd->context, area_address, erase_size);
;;;515        }
;;;516    
;;;517        return result;
;;;518    }
