;;;853     *
;;;854     * @return                      1 if the proc matches; 0 otherwise.
;;;855     */
;;;856    static int
;;;857    ble_gattc_proc_matches_conn_op(struct ble_gattc_proc *proc, void *arg)
;;;858    {
;;;859        const struct ble_gattc_criteria_conn_op *criteria;
;;;860    
;;;861        criteria = arg;
;;;862    
;;;863        if (criteria->conn_handle != proc->conn_handle) {
;;;864            return 0;
;;;865        }
;;;866    
;;;867        if (criteria->op != proc->op && criteria->op != BLE_GATT_OP_NONE) {
;;;868            return 0;
;;;869        }
;;;870    
;;;871        return 1;
;;;872    }
;;;873    
