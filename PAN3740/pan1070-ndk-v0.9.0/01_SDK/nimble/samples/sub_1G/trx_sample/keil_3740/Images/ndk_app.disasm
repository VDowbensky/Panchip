;;;983    ble_gap_slave_ticks_until_exp(void)
;;;984    {
;;;985        ble_npl_stime_t ticks;
;;;986    
;;;987        if (ble_gap_slave[0].op == BLE_GAP_OP_NULL || !ble_gap_slave[0].exp_set) {
;;;988            /* Timer not set; infinity ticks until next event. */
;;;989            return BLE_HS_FOREVER;
;;;990        }
;;;991    
;;;992        ticks = ble_gap_slave[0].exp_os_ticks - ble_npl_time_get();
;;;993        if (ticks > 0) {
;;;994            /* Timer not expired yet. */
;;;995            return ticks;
;;;996        }
;;;997    
;;;998        /* Timer just expired. */
;;;999        return 0;
;;;1000   }
