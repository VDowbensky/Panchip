;;;1211   static void
;;;1212   ble_sm_enc_event_rx(uint16_t conn_handle, uint8_t evt_status, int encrypted)
;;;1213   {
;;;1214       struct ble_sm_result res;
;;;1215       struct ble_sm_proc *proc;
;;;1216       int authenticated;
;;;1217       int bonded;
;;;1218       int key_size;
;;;1219   
;;;1220       memset(&res, 0, sizeof res);
;;;1221   
;;;1222       /* Assume no change in authenticated and bonded statuses. */
;;;1223       authenticated = 0;
;;;1224       bonded = 0;
;;;1225       key_size = 0;
;;;1226   
;;;1227       ble_hs_lock();
;;;1228   
;;;1229       proc = ble_sm_proc_find(conn_handle, BLE_SM_PROC_STATE_NONE, -1, NULL);
;;;1230       if (proc != NULL) {
;;;1231           switch (proc->state) {
;;;1232           case BLE_SM_PROC_STATE_ENC_START:
;;;1233               /* We are completing a pairing procedure; keys may need to be
;;;1234                * exchanged.
;;;1235                */
;;;1236               if (evt_status == 0) {
;;;1237                   /* If the responder has any keys to send, it sends them
;;;1238                    * first.
;;;1239                    */
;;;1240                   proc->state = BLE_SM_PROC_STATE_KEY_EXCH;
;;;1241                   if (!(proc->flags & BLE_SM_PROC_F_INITIATOR) ||
;;;1242                       proc->rx_key_flags == 0) {
;;;1243   
;;;1244                       res.execute = 1;
;;;1245                   }
;;;1246   
;;;1247                   key_size = proc->key_size;
;;;1248               } else {
;;;1249                   /* Failure or no keys to exchange; procedure is complete. */
;;;1250                   proc->state = BLE_SM_PROC_STATE_NONE;
;;;1251               }
;;;1252               if (proc->flags & BLE_SM_PROC_F_AUTHENTICATED) {
;;;1253                   authenticated = 1;
;;;1254               }
;;;1255               break;
;;;1256   
;;;1257           case BLE_SM_PROC_STATE_ENC_RESTORE:
;;;1258               /* A secure link is being restored via the encryption
;;;1259                * procedure.  Keys were exchanged during pairing; they don't
;;;1260                * get exchanged again now.  Procedure is complete.
;;;1261                */
;;;1262               BLE_HS_DBG_ASSERT(proc->rx_key_flags == 0);
;;;1263               proc->state = BLE_SM_PROC_STATE_NONE;
;;;1264               if (proc->flags & BLE_SM_PROC_F_AUTHENTICATED) {
;;;1265                   authenticated = 1;
;;;1266               }
;;;1267               bonded = 1;
;;;1268               res.restore = 1;
;;;1269   
;;;1270               key_size = proc->key_size;
;;;1271               break;
;;;1272   
;;;1273           default:
;;;1274               /* The encryption change event is unexpected.  We take the
;;;1275                * controller at its word that the state has changed and we
;;;1276                * terminate the procedure.
;;;1277                */
;;;1278               proc->state = BLE_SM_PROC_STATE_NONE;
;;;1279               res.sm_err = BLE_SM_ERR_UNSPECIFIED;
;;;1280               break;
;;;1281           }
;;;1282       }
;;;1283   
;;;1284       if (evt_status == 0) {
;;;1285           /* Set the encrypted state of the connection as indicated in the
;;;1286            * event.
;;;1287            */
;;;1288           ble_sm_update_sec_state(conn_handle, encrypted, authenticated, bonded,
;;;1289                                   key_size);
;;;1290       }
;;;1291   
;;;1292       /* Unless keys need to be exchanged, notify the application of the security
;;;1293        * change.  If key exchange is pending, the application callback is
;;;1294        * triggered after exchange completes.
;;;1295        */
;;;1296       if (proc == NULL || proc->state == BLE_SM_PROC_STATE_NONE) {
;;;1297           res.enc_cb = 1;
;;;1298           res.app_status = BLE_HS_HCI_ERR(evt_status);
;;;1299       }
;;;1300   
;;;1301       ble_hs_unlock();
;;;1302   
;;;1303       res.bonded = bonded;
;;;1304       ble_sm_process_result(conn_handle, &res);
;;;1305   }
