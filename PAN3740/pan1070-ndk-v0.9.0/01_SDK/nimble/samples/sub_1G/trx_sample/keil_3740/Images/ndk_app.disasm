;;;1132       /* Resume timer not set. */
;;;1133       if (ble_gattc_resume_at == 0) {
;;;1134           return BLE_HS_FOREVER;
;;;1135       }
;;;1136   
;;;1137       now = ble_npl_time_get();
;;;1138       diff = ble_gattc_resume_at - now;
;;;1139       if (diff <= 0) {
;;;1140           /* Timer already expired; resume immediately. */
;;;1141           return 0;
;;;1142       }
;;;1143   
;;;1144       return diff;
;;;1145   }
