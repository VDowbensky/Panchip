;;;957     *                                  conflicting SM procedure.
;;;958     * @param key_size              The key size of the conflicting SM procedure.
;;;959     *
;;;960     * @return                      0 if the procedure should continue;
;;;961     *                              nonzero if the request should be ignored.
;;;962     */
;;;963    static int
;;;964    ble_sm_chk_repeat_pairing(uint16_t conn_handle,
;;;965                              ble_sm_proc_flags proc_flags,
;;;966                              uint8_t key_size)
