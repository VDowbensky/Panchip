;;;3876   
;;;3877       cmd.sync_handle = htole16(sync_handle);
;;;3878   
;;;3879       rc = ble_hs_hci_cmd_tx(opcode, &cmd, sizeof(cmd), NULL, 0);
;;;3880       if (rc == 0) {
;;;3881           /* Remove the handle from the list */
;;;3882           ble_hs_periodic_sync_remove(psync);
;;;3883   
;;;3884           /* send sync_lost event, this is to mimic connection behavior and thus
;;;3885            * simplify application error handling
;;;3886            */
;;;3887           ble_npl_eventq_put(ble_hs_evq_get(), &psync->lost_ev);
;;;3888       }
;;;3889   
;;;3890       ble_hs_unlock();
;;;3891   
;;;3892       return rc;
;;;3893   }
