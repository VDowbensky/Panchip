;;;1113           /* Below results means that some of the channels has not been created
;;;1114            * and we have to look closer into the response.
;;;1115            * Any other results means that all the connections has been refused.
;;;1116            */
;;;1117           if ((rsp->result != BLE_L2CAP_COC_ERR_NO_RESOURCES) &&
;;;1118               (rsp->result != BLE_L2CAP_COC_ERR_INVALID_SOURCE_CID) &&
;;;1119               (rsp->result != BLE_L2CAP_COC_ERR_SOURCE_CID_ALREADY_USED)) {
