;;;632    void FMC_SetFlashMode(FLCTL_T *fmc, uint32_t mode, bool enhance)
;;;633    {
        0x0000265c:    b5f7        ..      PUSH     {r0-r2,r4-r7,lr}
        0x0000265e:    4604        .F      MOV      r4,r0
