;;;588    static int
;;;589    ble_sm_proc_matches(struct ble_sm_proc *proc, uint16_t conn_handle,
;;;590                        uint8_t state, int is_initiator)
;;;591    {
;;;592        int proc_is_initiator;
;;;593    
;;;594        if (conn_handle != proc->conn_handle) {
;;;595            return 0;
;;;596        }
;;;597    
;;;598        if (state != BLE_SM_PROC_STATE_NONE && state != proc->state) {
;;;599            return 0;
;;;600        }
;;;601    
;;;602        proc_is_initiator = !!(proc->flags & BLE_SM_PROC_F_INITIATOR);
;;;603        if (is_initiator != -1 && is_initiator != proc_is_initiator) {
;;;604            return 0;
;;;605        }
;;;606    
;;;607        return 1;
;;;608    }
;;;609    
;;;610    /**
;;;611     * Searches the main proc list for an entry whose connection handle and state
;;;612     * code match those specified.
;;;613     *
;;;614     * @param conn_handle           The connection handle to match against.
;;;615     * @param state                 The state code to match against.
;;;616     * @param is_initiator          Matches on the proc's initiator flag:
;;;617     *                                   0=non-initiator only
;;;618     *                                   1=initiator only
;;;619     *                                  -1=don't care
;;;620     * @param out_prev              On success, the entry previous to the result is
;;;621     *                                  written here.
;;;622     *
;;;623     * @return                      The matching proc entry on success;
;;;624     *                                  null on failure.
;;;625     */
;;;626    struct ble_sm_proc *
;;;627    ble_sm_proc_find(uint16_t conn_handle, uint8_t state, int is_initiator,
;;;628                     struct ble_sm_proc **out_prev)
;;;629    {
;;;630        struct ble_sm_proc *proc;
;;;631        struct ble_sm_proc *prev;
;;;632    
;;;633        // BLE_HS_DBG_ASSERT(ble_hs_locked_by_cur_task());
;;;634    
;;;635        prev = NULL;
;;;636        STAILQ_FOREACH(proc, &ble_sm_procs, next) {
;;;637            if (ble_sm_proc_matches(proc, conn_handle, state, is_initiator)) {
;;;638                if (out_prev != NULL) {
;;;639                    *out_prev = prev;
;;;640                }
;;;641                break;
;;;642            }
;;;643    
;;;644            prev = proc;
;;;645        }
;;;646    
;;;647        return proc;
;;;648    }
;;;649    
;;;650    static void
;;;651    ble_sm_insert(struct ble_sm_proc *proc)
;;;652    {
;;;653    #if MYNEWT_VAL(BLE_HS_DEBUG)
;;;654        struct ble_sm_proc *cur;
;;;655    
;;;656        STAILQ_FOREACH(cur, &ble_sm_procs, next) {
;;;657            BLE_HS_DBG_ASSERT(cur != proc);
;;;658        }
;;;659    #endif
;;;660    
;;;661        STAILQ_INSERT_HEAD(&ble_sm_procs, proc, next);
;;;662    }
;;;663    
;;;664    static int32_t
;;;665    ble_sm_extract_expired(struct ble_sm_proc_list *dst_list)
;;;666    {
;;;667        struct ble_sm_proc *proc;
;;;668        struct ble_sm_proc *prev;
;;;669        struct ble_sm_proc *next;
;;;670        ble_npl_time_t now;
;;;671        ble_npl_stime_t next_exp_in;
;;;672        ble_npl_stime_t time_diff;
;;;673    
;;;674        now = ble_npl_time_get();
;;;675        STAILQ_INIT(dst_list);
;;;676    
;;;677        /* Assume each event is either expired or has infinite duration. */
;;;678        next_exp_in = BLE_HS_FOREVER;
;;;679    
;;;680        ble_hs_lock();
;;;681    
;;;682        prev = NULL;
;;;683        proc = STAILQ_FIRST(&ble_sm_procs);
;;;684        while (proc != NULL) {
;;;685            next = STAILQ_NEXT(proc, next);
;;;686    
;;;687            time_diff = proc->exp_os_ticks - now;
;;;688            if (time_diff <= 0) {
;;;689                /* Procedure has expired; move it to the destination list. */
;;;690                if (prev == NULL) {
;;;691                    STAILQ_REMOVE_HEAD(&ble_sm_procs, next);
;;;692                } else {
;;;693                    STAILQ_REMOVE_AFTER(&ble_sm_procs, prev, next);
;;;694                }
;;;695                STAILQ_INSERT_HEAD(dst_list, proc, next);
;;;696            } else {
;;;697                if (time_diff < next_exp_in) {
;;;698                    next_exp_in = time_diff;
;;;699                }
;;;700            }
;;;701    
;;;702            prev = proc;
;;;703            proc = next;
;;;704        }
;;;705    
;;;706        ble_sm_dbg_assert_no_cycles();
;;;707    
;;;708        ble_hs_unlock();
;;;709    
;;;710        return next_exp_in;
;;;711    }
