;;;958                                               uint32_t data_size,
;;;959                                               _mtb_kvstore_operation_t operation,
;;;960                                               const _mtb_kvstore_update_ram_table_info_t* ram_tbl_info,
;;;961                                               const _mtb_kvstore_update_consumed_size_info_t* size_info)
