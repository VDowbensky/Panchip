;;;600    /**
;;;601     * Transmits a response or error message over the specified connection.
;;;602     *
;;;603     * The specified rc and err_status values control what gets sent as follows:
;;;604     *     o If rc == 0: tx an affirmative response.
;;;605     *     o Else if err_status != 0: tx an error response.
;;;606     *     o Else: tx nothing.
;;;607     *
;;;608     * In addition, if transmission of an affirmative response fails, an error is
;;;609     * sent instead.
;;;610     *
;;;611     * @param conn_handle           The handle of the connection to send over.
;;;612     * @param hs_status             The status indicating whether to transmit an
;;;613     *                                  affirmative response or an error.
;;;614     * @param txom                  Contains the affirmative response payload.
;;;615     * @param att_op                If an error is transmitted, this is the value
;;;616     *                                  of the error message's op field.
;;;617     * @param err_status            If an error is transmitted, this is the value
;;;618     *                                  of the error message's status field.
;;;619     * @param err_handle            If an error is transmitted, this is the value
;;;620     *                                  of the error message's attribute handle
;;;621     *                                  field.
;;;622     */
;;;623    static int
;;;624    ble_att_svr_tx_rsp(uint16_t conn_handle, int hs_status, struct os_mbuf *om,
;;;625                       uint8_t att_op, uint8_t err_status, uint16_t err_handle)
;;;626    {
;;;627        struct ble_l2cap_chan *chan;
;;;628        struct ble_hs_conn *conn;
;;;629        int do_tx;
;;;630        int rc;
;;;631    
;;;632        if (hs_status != 0 && err_status == 0) {
;;;633            /* Processing failed, but err_status of 0 means don't send error. */
;;;634            do_tx = 0;
;;;635        } else {
;;;636            do_tx = 1;
;;;637        }
;;;638    
;;;639        if (do_tx) {
;;;640            ble_hs_lock();
;;;641    
;;;642            rc = ble_att_conn_chan_find(conn_handle, &conn, &chan);
;;;643            if (rc != 0) {
;;;644                /* No longer connected. */
;;;645                hs_status = rc;
;;;646            } else {
;;;647                if (hs_status == 0) {
;;;648                    BLE_HS_DBG_ASSERT(om != NULL);
;;;649    
;;;650                    ble_att_inc_tx_stat(om->om_data[0]);
;;;651                    ble_att_truncate_to_mtu(chan, om);
;;;652                    hs_status = ble_l2cap_tx(conn, chan, om);
;;;653                    om = NULL;
;;;654                    if (hs_status != 0) {
;;;655                        err_status = BLE_ATT_ERR_UNLIKELY;
;;;656                    }
;;;657               }
;;;658            }
;;;659    
;;;660            ble_hs_unlock();
;;;661    
;;;662            if (hs_status != 0) {
;;;663                STATS_INC(ble_att_stats, error_rsp_tx);
;;;664    
;;;665                /* Reuse om for error response. */
;;;666                if (om == NULL) {
;;;667                    om = ble_hs_mbuf_l2cap_pkt();
;;;668                } else {
;;;669                    os_mbuf_adj(om, OS_MBUF_PKTLEN(om));
;;;670                }
;;;671                if (om != NULL) {
;;;672                    ble_att_svr_tx_error_rsp(conn_handle, om, att_op,
;;;673                                             err_handle, err_status);
;;;674                    om = NULL;
;;;675                }
;;;676            }
;;;677        }
;;;678    
;;;679        /* Free mbuf if it was not consumed (i.e., if the send failed). */
;;;680        os_mbuf_free_chain(om);
;;;681    
;;;682        return hs_status;
;;;683    }
