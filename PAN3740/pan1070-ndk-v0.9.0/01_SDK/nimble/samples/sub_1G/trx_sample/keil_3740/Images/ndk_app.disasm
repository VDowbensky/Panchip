;;;3928   int
;;;3929   ble_gap_periodic_adv_sync_transfer(uint16_t sync_handle, uint16_t conn_handle,
;;;3930                                      uint16_t service_data)
;;;3931   {
;;;3932       struct ble_hci_le_periodic_adv_sync_transfer_cp cmd;
