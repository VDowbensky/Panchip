;;;2022   static int32_t
;;;2023   ble_gap_master_timer(void)
;;;2024   {
;;;2025       uint32_t ticks_until_exp;
;;;2026   #if NIMBLE_BLE_SCAN || NIMBLE_BLE_CONNECT
;;;2027       int rc;
;;;2028   #endif
;;;2029   
;;;2030       ticks_until_exp = ble_gap_master_ticks_until_exp();
;;;2031       if (ticks_until_exp != 0) {
;;;2032           /* Timer not expired yet. */
;;;2033           return ticks_until_exp;
;;;2034       }
;;;2035   
;;;2036       /*** Timer expired; process event. */
;;;2037   
;;;2038       switch (ble_gap_master.op) {
;;;2039   #if NIMBLE_BLE_CONNECT
;;;2040       case BLE_GAP_OP_M_CONN:
;;;2041           rc = ble_gap_conn_cancel_tx();
;;;2042           if (rc != 0) {
;;;2043               /* Failed to stop connecting; try again in 100 ms. */
;;;2044               return ble_npl_time_ms_to_ticks32(BLE_GAP_CANCEL_RETRY_TIMEOUT_MS);
;;;2045           } else {
;;;2046               /* Stop the timer now that the cancel command has been acked. */
;;;2047               ble_gap_master.exp_set = 0;
;;;2048   
;;;2049               /* Timeout gets reported when we receive a connection complete
;;;2050                * event indicating the connect procedure has been cancelled.
;;;2051                */
;;;2052               /* XXX: Set a timer to reset the controller if a connection
;;;2053                * complete event isn't received within a reasonable interval.
;;;2054                */
;;;2055           }
;;;2056           break;
;;;2057   #endif
;;;2058   
;;;2059       case BLE_GAP_OP_M_DISC:
;;;2060   #if NIMBLE_BLE_SCAN && !MYNEWT_VAL(BLE_EXT_ADV)
;;;2061           /* When a discovery procedure times out, it is not a failure. */
;;;2062           rc = ble_gap_disc_enable_tx(0, 0);
;;;2063           if (rc != 0) {
;;;2064               /* Failed to stop discovery; try again in 100 ms. */
;;;2065               return ble_npl_time_ms_to_ticks32(BLE_GAP_CANCEL_RETRY_TIMEOUT_MS);
;;;2066           }
;;;2067   
;;;2068           ble_gap_disc_complete();
;;;2069   #else
;;;2070           assert(0);
;;;2071   #endif
;;;2072           break;
;;;2073   
;;;2074       default:
;;;2075           BLE_HS_DBG_ASSERT(0);
;;;2076           break;
;;;2077       }
;;;2078   
;;;2079       return BLE_HS_FOREVER;
;;;2080   }
;;;2081   
;;;2082   #if NIMBLE_BLE_ADVERTISE && !MYNEWT_VAL(BLE_EXT_ADV)
;;;2083   static int32_t
;;;2084   ble_gap_slave_timer(void)
;;;2085   {
;;;2086       uint32_t ticks_until_exp;
;;;2087       int rc;
;;;2088   
;;;2089       ticks_until_exp = ble_gap_slave_ticks_until_exp();
;;;2090       if (ticks_until_exp != 0) {
;;;2091           /* Timer not expired yet. */
;;;2092           return ticks_until_exp;
;;;2093       }
;;;2094   
;;;2095       /*** Timer expired; process event. */
;;;2096   
;;;2097       /* Stop advertising. */
;;;2098       rc = ble_gap_adv_enable_tx(0);
;;;2099       if (rc != 0) {
;;;2100           /* Failed to stop advertising; try again in 100 ms. */
;;;2101           return 100;
;;;2102       }
;;;2103   
;;;2104       /* Clear the timer and cancel the current procedure. */
;;;2105       ble_gap_slave_reset_state(0);
