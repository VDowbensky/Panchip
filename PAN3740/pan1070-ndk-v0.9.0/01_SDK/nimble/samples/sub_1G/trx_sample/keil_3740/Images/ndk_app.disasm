;;;3169   
;;;3170           traceTASK_DELAY_UNTIL( ( xTickCount + xTicksToWait ) );
;;;3171           prvAddCurrentTaskToDelayedList( xTicksToWait, xWaitIndefinitely );
;;;3172       }
;;;3173   
;;;3174   #endif /* configUSE_TIMERS */
