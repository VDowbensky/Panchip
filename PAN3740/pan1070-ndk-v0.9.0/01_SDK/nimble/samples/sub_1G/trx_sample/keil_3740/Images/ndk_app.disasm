;;;1845           if (MYNEWT_VAL(BLE_SM_LEGACY) == 0) {
;;;1846               return false;
;;;1847           }
;;;1848       }
;;;1849       /* Fail if Secure Connections level forces MITM protection and remote does not
;;;1850        * support it
;;;1851        */
;;;1852       if (MYNEWT_VAL(BLE_SM_SC_LVL) >= 3 && !(cmd & BLE_SM_PAIR_AUTHREQ_MITM)) {
;;;1853           return false;
;;;1854       }
;;;1855       return true;
;;;1856   }
