;;;1173   
;;;1174   //--------------------------------------------------------------------------------------------------
;;;1175   // _mtb_kvstore_garbage_collection
;;;1176   //--------------------------------------------------------------------------------------------------
;;;1177   static cy_rslt_t _mtb_kvstore_garbage_collection(mtb_kvstore_t* obj,
;;;1178                                                    const _mtb_kvstore_record_info_t* record_info)
;;;1179   {
;;;1180       CY_ASSERT(obj != NULL);
;;;1181       cy_rslt_t result = CY_RSLT_SUCCESS;
;;;1182   
;;;1183       // If we need to update a record then that the new size fits the space remaining space.
;;;1184       // Otherwise return area full error before copying over. We can do this because we track
;;;1185       // the actual consumed size so we use that to check if there is enough space to accommodate
;;;1186       // the updated record.
;;;1187       if ((record_info != NULL) && (record_info->update_rec_info != NULL))
;;;1188       {
;;;1189           // Note that the consumed size is not yet updated so we need to subtract the old record size
;;;1190           // while checking for space left.
;;;1191           uint32_t total_size = obj->consumed_size - record_info->consumed_size_info.old_record_size +
;;;1192                                 record_info->consumed_size_info.new_record_size;
;;;1193           if (total_size > _MTB_KVSTORE_AREA_SIZE(obj))
;;;1194           {
;;;1195               return MTB_KVSTORE_STORAGE_FULL_ERROR;
;;;1196           }
;;;1197       }
;;;1198   
;;;1199       /* Erase the GC area */
