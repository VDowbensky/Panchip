;;;1103   #if NIMBLE_BLE_CONNECT
;;;1104   static void
;;;1105   ble_gap_update_failed(uint16_t conn_handle, int status)
;;;1106   {
;;;1107       struct ble_gap_update_entry *entry;
;;;1108   
;;;1109       STATS_INC(ble_gap_stats, update_fail);
