;;;2316   int
;;;2317   ble_att_svr_rx_prep_write(uint16_t conn_handle, struct os_mbuf **rxom)
;;;2318   {
;;;2319   #if !MYNEWT_VAL(BLE_ATT_SVR_QUEUED_WRITE)
;;;2320       return BLE_HS_ENOTSUP;
;;;2321   #endif
;;;2322   
;;;2323       struct ble_att_prep_write_cmd *req;
;;;2324       struct ble_att_svr_entry *attr_entry;
;;;2325       struct os_mbuf *txom;
;;;2326       uint16_t err_handle;
;;;2327       uint8_t att_err;
;;;2328       int rc;
;;;2329   
;;;2330       /* Initialize some values in case of early error. */
;;;2331       txom = NULL;
;;;2332       att_err = 0;
;;;2333       err_handle = 0;
;;;2334   
;;;2335       rc = ble_att_svr_pullup_req_base(rxom, sizeof(*req), &att_err);
;;;2336       if (rc != 0) {
;;;2337           goto done;
;;;2338       }
;;;2339   
;;;2340       req = (struct ble_att_prep_write_cmd *)(*rxom)->om_data;
;;;2341   
;;;2342       err_handle = le16toh(req->bapc_handle);
;;;2343   
;;;2344       attr_entry = ble_att_svr_find_by_handle(le16toh(req->bapc_handle));
;;;2345   
;;;2346       /* A prepare write request gets rejected for the following reasons:
;;;2347        * 1. Insufficient authorization.
;;;2348        * 2. Insufficient authentication.
;;;2349        * 3. Insufficient encryption key size (XXX: Not checked).
;;;2350        * 4. Insufficient encryption (XXX: Not checked).
;;;2351        * 5. Invalid handle.
;;;2352        * 6. Write not permitted.
;;;2353        */
;;;2354   
;;;2355       /* <5> */
;;;2356       if (attr_entry == NULL) {
;;;2357           rc = BLE_HS_ENOENT;
;;;2358           att_err = BLE_ATT_ERR_INVALID_HANDLE;
;;;2359           goto done;
;;;2360       }
;;;2361   
;;;2362       /* <1>, <2>, <4>, <6> */
;;;2363       rc = ble_att_svr_check_perms(conn_handle, 0, attr_entry, &att_err);
;;;2364       if (rc != 0) {
;;;2365           goto done;
;;;2366       }
;;;2367   
;;;2368       ble_hs_lock();
;;;2369       rc = ble_att_svr_insert_prep_entry(conn_handle, le16toh(req->bapc_handle),
;;;2370                                          le16toh(req->bapc_offset), *rxom,
;;;2371                                          &att_err);
;;;2372       ble_hs_unlock();
;;;2373   
;;;2374       /* Reuse rxom for response.  On success, the response is identical to
;;;2375        * request except for op code.  On error, the buffer contents will get
;;;2376        * cleared before the error gets written.
;;;2377        */
;;;2378       txom = *rxom;
;;;2379       *rxom = NULL;
;;;2380   
;;;2381       if (rc != 0) {
;;;2382           goto done;
;;;2383       }
;;;2384   
;;;2385       /* adjust for ATT header */
;;;2386       os_mbuf_prepend(txom, 1);
;;;2387       txom->om_data[0] = BLE_ATT_OP_PREP_WRITE_RSP;
;;;2388   
;;;2389       rc = 0;
;;;2390   
;;;2391   done:
;;;2392       rc = ble_att_svr_tx_rsp(conn_handle, rc, txom, BLE_ATT_OP_PREP_WRITE_REQ,
;;;2393                               att_err, err_handle);
;;;2394       return rc;
;;;2395   }
;;;2396   
;;;2397   int
;;;2398   ble_att_svr_rx_exec_write(uint16_t conn_handle, struct os_mbuf **rxom)
;;;2399   {
;;;2400   #if !MYNEWT_VAL(BLE_ATT_SVR_QUEUED_WRITE)
;;;2401       return BLE_HS_ENOTSUP;
;;;2402   #endif
;;;2403   
;;;2404       struct ble_att_prep_entry_list prep_list;
;;;2405       struct ble_att_exec_write_req *req;
;;;2406       struct ble_hs_conn *conn;
;;;2407       struct os_mbuf *txom;
;;;2408       uint16_t err_handle;
;;;2409       uint8_t att_err;
;;;2410       uint8_t flags;
;;;2411       int rc;
;;;2412   
;;;2413       /* Initialize some values in case of early error. */
;;;2414       txom = NULL;
;;;2415       err_handle = 0;
;;;2416   
;;;2417       rc = ble_att_svr_pullup_req_base(rxom, sizeof(*req), &att_err);
;;;2418       if (rc != 0) {
;;;2419           flags = 0;
;;;2420           goto done;
;;;2421       }
;;;2422   
;;;2423       req = (struct ble_att_exec_write_req *)(*rxom)->om_data;
;;;2424   
;;;2425       flags = req->baeq_flags;
;;;2426   
;;;2427       /* Just reuse the request buffer for the response. */
;;;2428       txom = *rxom;
;;;2429       *rxom = NULL;
;;;2430       os_mbuf_adj(txom, OS_MBUF_PKTLEN(txom));
;;;2431   
;;;2432       if (ble_att_cmd_prepare(BLE_ATT_OP_EXEC_WRITE_RSP, 0, txom) == NULL) {
;;;2433           att_err = BLE_ATT_ERR_INSUFFICIENT_RES;
;;;2434           rc = BLE_HS_ENOMEM;
;;;2435           goto done;
;;;2436       }
;;;2437   
;;;2438       rc = 0;
