;;;840    
;;;841    static int ah(const uint8_t irk[16], const uint8_t r[3], uint8_t out[3])
;;;842    {
;;;843    	uint8_t res[16];
;;;844    	int err;
;;;845    
;;;846    	/* r' = padding || r */
;;;847    	memcpy(res, r, 3);
;;;848    	(void)memset(res + 3, 0, 13);
;;;849    
;;;850    	err = internal_encrypt_le(irk, res, res);
;;;851    	if (err) {
;;;852    		return err;
;;;853    	}
;;;854    
;;;855    	/* The output of the random address function ah is:
;;;856    	 *      ah(h, r) = e(k, r') mod 2^24
;;;857    	 * The output of the security function e is then truncated to 24 bits
;;;858    	 * by taking the least significant 24 bits of the output of e as the
;;;859    	 * result of ah.
;;;860    	 */
;;;861    	memcpy(out, res, 3);
;;;862    
;;;863    	return 0;
;;;864    }
