;;;1103   static void
;;;1104   ble_gattc_resume_procs(void)
;;;1105   {
;;;1106       struct ble_gattc_proc_list stall_list;
;;;1107       struct ble_gattc_proc *proc;
;;;1108       ble_gattc_resume_fn *resume_cb;
