;;;1837   static bool
;;;1838   ble_sm_verify_auth_requirements(uint8_t cmd)
;;;1839   {
;;;1840       /* For now we check only SC only mode. I.e.: when remote indicates
;;;1841        * to not support SC pairing, let us make sure legacy pairing is supported
;;;1842        * on our side. If not, we can fail right away.
;;;1843        */
;;;1844       if (!(cmd & BLE_SM_PAIR_AUTHREQ_SC)) {
;;;1845           if (MYNEWT_VAL(BLE_SM_LEGACY) == 0) {
;;;1846               return false;
;;;1847           }
;;;1848       }
;;;1849       /* Fail if Secure Connections level forces MITM protection and remote does not
;;;1850        * support it
;;;1851        */
;;;1852       if (MYNEWT_VAL(BLE_SM_SC_LVL) >= 3 && !(cmd & BLE_SM_PAIR_AUTHREQ_MITM)) {
;;;1853           return false;
;;;1854       }
;;;1855       return true;
;;;1856   }
;;;1857   
;;;1858   static void
;;;1859   ble_sm_pair_req_rx(uint16_t conn_handle, struct os_mbuf **om,
;;;1860                      struct ble_sm_result *res)
;;;1861   {
;;;1862       struct ble_sm_pair_cmd *req;
;;;1863       struct ble_sm_proc *proc;
;;;1864       struct ble_sm_proc *prev;
;;;1865       struct ble_hs_conn *conn;
;;;1866       ble_sm_proc_flags proc_flags;
;;;1867       uint8_t key_size;
;;;1868       int rc;
;;;1869   
;;;1870       /* Silence spurious unused-variable warnings. */
;;;1871       proc_flags = 0;
;;;1872       key_size = 0;
;;;1873   
;;;1874       res->app_status = ble_hs_mbuf_pullup_base(om, sizeof(*req));
;;;1875       if (res->app_status != 0) {
;;;1876           return;
;;;1877       }
;;;1878   
;;;1879       req = (struct ble_sm_pair_cmd *)(*om)->om_data;
;;;1880   
;;;1881       ble_hs_lock();
;;;1882   
;;;1883       /* XXX: Check connection state; reject if not appropriate. */
;;;1884       /* XXX: Ensure enough time has passed since the previous failed pairing
;;;1885        * attempt.
;;;1886        */
;;;1887       proc = ble_sm_proc_find(conn_handle, BLE_SM_PROC_STATE_NONE, -1, &prev);
;;;1888       if (proc != NULL) {
;;;1889           /* Fail if procedure is in progress unless we sent a slave security
;;;1890            * request to peer.
;;;1891            */
;;;1892           if (proc->state != BLE_SM_PROC_STATE_SEC_REQ) {
;;;1893               res->sm_err = BLE_SM_ERR_UNSPECIFIED;
;;;1894               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_UNSPECIFIED);
;;;1895               ble_hs_unlock();
;;;1896               return;
;;;1897           }
;;;1898   
;;;1899           /* Remove the procedure because it was allocated when
;;;1900            * sending the Slave Security Request and it will be allocated
;;;1901            * again later in this method. We should probably refactor this
;;;1902            * in the future.
;;;1903            */
;;;1904           ble_sm_proc_remove(proc, prev);
;;;1905           ble_sm_proc_free(proc);
;;;1906       }
;;;1907   
;;;1908       ble_hs_unlock();
;;;1909   
;;;1910       /* Check if there is storage capacity for a new bond.  If there isn't, ask
;;;1911        * the application to make room.
;;;1912        */
;;;1913       rc = ble_sm_chk_store_overflow(conn_handle);
;;;1914       if (rc != 0) {
;;;1915           res->sm_err = BLE_SM_ERR_UNSPECIFIED;
;;;1916           res->app_status = rc;
;;;1917           return;
;;;1918       }
;;;1919   
;;;1920       ble_hs_lock();
;;;1921   
;;;1922       proc = ble_sm_proc_alloc();
;;;1923       if (proc != NULL) {
;;;1924           proc->conn_handle = conn_handle;
;;;1925           proc->state = BLE_SM_PROC_STATE_PAIR;
;;;1926           ble_sm_insert(proc);
;;;1927   
;;;1928           proc->pair_req[0] = BLE_SM_OP_PAIR_REQ;
;;;1929           memcpy(proc->pair_req + 1, req, sizeof(*req));
;;;1930   
;;;1931           conn = ble_hs_conn_find_assert(proc->conn_handle);
;;;1932           if (conn->bhc_flags & BLE_HS_CONN_F_MASTER) {
;;;1933               res->sm_err = BLE_SM_ERR_CMD_NOT_SUPP;
;;;1934               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_CMD_NOT_SUPP);
;;;1935           } else if (MYNEWT_VAL(BLE_SM_SC_LVL) == 1) {
;;;1936               res->sm_err = BLE_SM_ERR_CMD_NOT_SUPP;
;;;1937               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_CMD_NOT_SUPP);
;;;1938           } else if (req->max_enc_key_size < BLE_SM_PAIR_KEY_SZ_MIN) {
;;;1939               res->sm_err = BLE_SM_ERR_ENC_KEY_SZ;
;;;1940               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_ENC_KEY_SZ);
;;;1941           } else if (req->max_enc_key_size > BLE_SM_PAIR_KEY_SZ_MAX) {
;;;1942               res->sm_err = BLE_SM_ERR_INVAL;
;;;1943               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_INVAL);
;;;1944           } else if (MYNEWT_VAL(BLE_SM_SC_ONLY) && (req->max_enc_key_size != BLE_SM_PAIR_KEY_SZ_MAX)) {
;;;1945               /* Fail if Secure Connections Only mode is on and remote does not meet
;;;1946               * key size requirements - MITM was checked in last step
;;;1947               */
;;;1948               res->sm_err = BLE_SM_ERR_ENC_KEY_SZ;
;;;1949               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_ENC_KEY_SZ);
;;;1950           } else if (!ble_sm_verify_auth_requirements(req->authreq)) {
;;;1951               res->sm_err = BLE_SM_ERR_AUTHREQ;
;;;1952               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_AUTHREQ);
;;;1953           } else {
;;;1954               /* The request looks good.  Precalculate our pairing response and
;;;1955                * determine some properties of the imminent link.  We need this
;;;1956                * information in case this is a repeated pairing attempt (i.e., we
;;;1957                * are already bonded to this peer).  In that case, we include the
;;;1958                * information in a notification to the app.
;;;1959                */
;;;1960               ble_sm_pair_rsp_fill(proc);
;;;1961               ble_sm_pair_cfg(proc);
;;;1962   
;;;1963               proc_flags = proc->flags;
;;;1964               key_size = proc->key_size;
;;;1965               res->execute = 1;
;;;1966           }
;;;1967       }
;;;1968   
;;;1969       ble_hs_unlock();
;;;1970   
;;;1971       /* Check if we are already bonded to this peer.  If so, give the
;;;1972        * application an opportunity to delete the old bond.
;;;1973        */
;;;1974       if (res->app_status == 0) {
;;;1975           rc = ble_sm_chk_repeat_pairing(conn_handle, proc_flags, key_size);
;;;1976           if (rc != 0) {
;;;1977               /* The app indicated that the pairing request should be ignored. */
;;;1978               res->app_status = rc;
;;;1979               res->execute = 0;
;;;1980           }
;;;1981       }
;;;1982   }
;;;1983   
;;;1984   static void
;;;1985   ble_sm_pair_rsp_rx(uint16_t conn_handle, struct os_mbuf **om,
;;;1986                      struct ble_sm_result *res)
;;;1987   {
;;;1988       struct ble_sm_pair_cmd *rsp;
;;;1989       struct ble_sm_proc *proc;
;;;1990       uint8_t ioact;
