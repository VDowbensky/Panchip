;;;2102        * https://goo.gl/wu4acr */
;;;2103   
;;;2104       /* portSOFTWARE_BARRIER() is only implemented for emulated/simulated ports that
;;;2105        * do not otherwise exhibit real time behaviour. */
;;;2106       portSOFTWARE_BARRIER();
