;;;1505   
;;;1506       if (proc == NULL) {
;;;1507           return res.app_status;
;;;1508       }
;;;1509   
;;;1510       if (res.app_status == 0) {
;;;1511           if (restore) {
;;;1512               store_rc = ble_sm_retrieve_ltk(le16toh(ev->div), le64toh(ev->rand),
;;;1513                                               addrs.peer_id_addr.type,
;;;1514                                              peer_id_addr, &value_sec);
;;;1515               if (store_rc == 0) {
