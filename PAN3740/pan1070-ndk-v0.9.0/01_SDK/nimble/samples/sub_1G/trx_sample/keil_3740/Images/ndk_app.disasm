;;;442        lp_int_ctrl_reg = ANA->LP_INT_CTRL;
;;;443    
;;;444        /* Clear status registers for next time detecting. And would not clear it in bootloader so that these
;;;445           flags can also be obtained in app. */
;;;446    #if !IS_BOOTLOADER
;;;447        CLK->RSTSTS = CLK->RSTSTS;
;;;448        ANA->LP_INT_CTRL = ANA->LP_INT_CTRL;
