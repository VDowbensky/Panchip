;;;1548                                           : (found_in_table) ? _MTB_KVSTORE_OPER_UPDATE :
;;;1549                                            _MTB_KVSTORE_OPER_ADD;
;;;1550   
;;;1551       // We will be adding a new entry if its not found in the table so
