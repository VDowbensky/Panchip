;;;1080   static int
;;;1081   ble_l2cap_sig_credit_base_con_rsp_rx(uint16_t conn_handle,
;;;1082                                        struct ble_l2cap_sig_hdr *hdr,
;;;1083                                        struct os_mbuf **om)
;;;1084   {
;;;1085       struct ble_l2cap_sig_proc *proc;
;;;1086       struct ble_l2cap_sig_credit_base_connect_rsp *rsp;
;;;1087       struct ble_l2cap_chan *chan;
;;;1088       struct ble_hs_conn *conn;
