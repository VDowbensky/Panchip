;;;1405           _mtb_kvstore_update_consumed_size(obj, operation, &size_info);
;;;1406   
;;;1407   
;;;1408           result = CY_RSLT_SUCCESS;
;;;1409       }
;;;1410   
;;;1411       obj->free_space_offset = offset;
;;;1412   
;;;1413       return result;
;;;1414   }
