;;;964    /**
;;;965     * Fills a Find-By-Type-Value-Response with single entry.
;;;966     *
;;;967     * @param om                    The response mbuf.
;;;968     * @param first                 First handle ID in the current group of IDs.
;;;969     * @param last                  Last handle ID in the current group of ID.
;;;970     * @param mtu                   The ATT L2CAP channel MTU.
;;;971     *
;;;972     * @return                      0 if the response should be sent;
;;;973     *                              BLE_HS_EAGAIN if the entry was successfully
;;;974     *                                  processed and subsequent entries can be
;;;975     *                                  inspected.
;;;976     *                              Other nonzero on error.
;;;977     */
;;;978    static int
;;;979    ble_att_svr_fill_type_value_entry(struct os_mbuf *om, uint16_t first,
;;;980                                         uint16_t last, int mtu,
;;;981                                         uint8_t *out_att_err)
;;;982    {
;;;983        uint16_t u16;
