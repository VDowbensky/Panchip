;;;1090       int i;
;;;1091       uint16_t duplicated_cids[5] = {};
;;;1092   
;;;1093   #if !BLE_MONITOR
;;;1094       BLE_HS_LOG(DEBUG, "L2CAP LE COC connection response received\n");
;;;1095   #endif
;;;1096   
;;;1097       proc = ble_l2cap_sig_proc_extract(conn_handle,
;;;1098                                         BLE_L2CAP_SIG_PROC_OP_CONNECT,
;;;1099                                         hdr->identifier);
;;;1100       if (!proc) {
;;;1101           return 0;
;;;1102       }
;;;1103   
;;;1104       rc = ble_hs_mbuf_pullup_base(om, hdr->length);
;;;1105       if (rc != 0) {
;;;1106           goto done;
;;;1107       }
;;;1108   
;;;1109       rsp = (struct ble_l2cap_sig_credit_base_connect_rsp *)(*om)->om_data;
;;;1110   
;;;1111       if (rsp->result) {
;;;1112           rc = ble_l2cap_sig_coc_err2ble_hs_err(le16toh(rsp->result));
;;;1113           /* Below results means that some of the channels has not been created
;;;1114            * and we have to look closer into the response.
;;;1115            * Any other results means that all the connections has been refused.
;;;1116            */
;;;1117           if ((rsp->result != BLE_L2CAP_COC_ERR_NO_RESOURCES) &&
;;;1118               (rsp->result != BLE_L2CAP_COC_ERR_INVALID_SOURCE_CID) &&
;;;1119               (rsp->result != BLE_L2CAP_COC_ERR_SOURCE_CID_ALREADY_USED)) {
;;;1120               goto done;
;;;1121           }
