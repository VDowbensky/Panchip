;;;1381               if (result != CY_RSLT_SUCCESS)
;;;1382               {
;;;1383                   break;
;;;1384               }
;;;1385           }
;;;1386   
;;;1387           _mtb_kvstore_update_ram_table_info_t ram_tbl_info =
;;;1388           {
;;;1389               .ram_tbl_idx  = ram_tbl_idx,
;;;1390               .entry.hash   = hash,
;;;1391               .entry.offset = curr_offset
;;;1392           };
;;;1393           _mtb_kvstore_update_ram_table(obj, operation, &ram_tbl_info);
;;;1394   
;;;1395           uint32_t old_record_size = (operation == _MTB_KVSTORE_OPER_ADD)
;;;1396                                   ? 0
;;;1397                                   : _mtb_kvstore_get_record_size(obj, obj->active_area_addr, strlen(
;;;1398                                                                      obj->key_buffer),
;;;1399                                                                  old_record_data_size);
;;;1400           _mtb_kvstore_update_consumed_size_info_t size_info =
;;;1401           {
