;;;2316   int
;;;2317   ble_att_svr_rx_prep_write(uint16_t conn_handle, struct os_mbuf **rxom)
;;;2318   {
;;;2319   #if !MYNEWT_VAL(BLE_ATT_SVR_QUEUED_WRITE)
;;;2320       return BLE_HS_ENOTSUP;
;;;2321   #endif
;;;2322   
;;;2323       struct ble_att_prep_write_cmd *req;
;;;2324       struct ble_att_svr_entry *attr_entry;
;;;2325       struct os_mbuf *txom;
;;;2326       uint16_t err_handle;
;;;2327       uint8_t att_err;
;;;2328       int rc;
;;;2329   
;;;2330       /* Initialize some values in case of early error. */
;;;2331       txom = NULL;
;;;2332       att_err = 0;
;;;2333       err_handle = 0;
;;;2334   
;;;2335       rc = ble_att_svr_pullup_req_base(rxom, sizeof(*req), &att_err);
;;;2336       if (rc != 0) {
;;;2337           goto done;
;;;2338       }
;;;2339   
;;;2340       req = (struct ble_att_prep_write_cmd *)(*rxom)->om_data;
;;;2341   
;;;2342       err_handle = le16toh(req->bapc_handle);
;;;2343   
;;;2344       attr_entry = ble_att_svr_find_by_handle(le16toh(req->bapc_handle));
;;;2345   
;;;2346       /* A prepare write request gets rejected for the following reasons:
;;;2347        * 1. Insufficient authorization.
;;;2348        * 2. Insufficient authentication.
;;;2349        * 3. Insufficient encryption key size (XXX: Not checked).
;;;2350        * 4. Insufficient encryption (XXX: Not checked).
