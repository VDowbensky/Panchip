;;;322    /**
;;;323      * @brief Erase specific data in flash code area.
;;;324      *
;;;325      * This function is used to erase specific data in flash Code
;;;326      * Area.
;;;327      *
;;;328      * @note This API is the most recommended function used to erase
;;;329      * data in flash code area.
;;;330      *
;;;331      * @param fmc: where fmc is a flash peripheral.
;;;332      * @param addr: start address to erase, should be 4KB aligned.
;;;333      * @param len: length to erase in bytes.
;;;334      * @retval 0: Success.
;;;335      * @retval -1: Fail.
;;;336      */
;;;337    int FMC_EraseCodeArea(FLCTL_T *fmc, uint32_t addr, uint32_t len)
;;;338    {
;;;339        uint32_t block_64k_start_sector_idx = 0;
;;;340        uint16_t block_64k_sector_num = 0;
;;;341        uint32_t block_32k_start_sector_idx = 0;
