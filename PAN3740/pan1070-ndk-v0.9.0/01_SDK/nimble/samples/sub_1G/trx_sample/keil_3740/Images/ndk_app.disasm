;;;374    /**
;;;375     * Allocates an mbuf to be used for an ATT response.  If an mbuf cannot be
;;;376     * allocated, the received request mbuf is reused for the error response.
;;;377     */
;;;378    static int
;;;379    ble_att_svr_pkt(struct os_mbuf **rxom, struct os_mbuf **out_txom,
;;;380                    uint8_t *out_att_err)
;;;381    {
;;;382        *out_txom = ble_hs_mbuf_l2cap_pkt();
;;;383        if (*out_txom != NULL) {
;;;384            return 0;
;;;385        }
;;;386    
;;;387        /* Allocation failure.  Reuse receive buffer for response. */
;;;388        *out_txom = *rxom;
;;;389        *rxom = NULL;
;;;390        *out_att_err = BLE_ATT_ERR_INSUFFICIENT_RES;
;;;391        return BLE_HS_ENOMEM;
;;;392    }
