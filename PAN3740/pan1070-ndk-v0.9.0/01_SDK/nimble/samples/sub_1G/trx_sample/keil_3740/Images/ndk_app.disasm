;;;547    
;;;548    //--------------------------------------------------------------------------------------------------
;;;549    // _mtb_kvstore_get_record_crc
;;;550    //--------------------------------------------------------------------------------------------------
;;;551    static uint16_t _mtb_kvstore_get_record_crc(_mtb_kvstore_record_header_t* record_header,
;;;552                                                const char* key,
;;;553                                                const uint8_t* data)
;;;554    {
;;;555        CY_ASSERT(record_header != NULL);
;;;556        CY_ASSERT(key != NULL);
;;;557        uint16_t crc = _MTB_KVSTORE_CRC_INIT_VAL;
;;;558    
;;;559        // Compute CRC for header
;;;560        crc = _mtb_kvstore_get_header_crc(record_header, crc);
;;;561        crc = _mtb_kvstore_crc16((uint8_t*)key, record_header->key_size, crc);
;;;562        if ((data != NULL) && (record_header->data_size != 0))
;;;563        {
;;;564            crc = _mtb_kvstore_crc16(data, record_header->data_size, crc);
;;;565        }
;;;566    
;;;567        return crc;
;;;568    }
;;;569    
;;;570    
;;;571    //--------------------------------------------------------------------------------------------------
;;;572    // _mtb_kvstore_buffered_crc_compute
;;;573    //--------------------------------------------------------------------------------------------------
;;;574    static cy_rslt_t _mtb_kvstore_buffered_crc_compute(mtb_kvstore_t* obj, uint32_t address,
;;;575                                                       uint32_t size, uint16_t* crc)
;;;576    {
;;;577        CY_ASSERT(obj != NULL);
;;;578        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;579        uint32_t remaining_size = size;
;;;580        while (remaining_size > 0)
;;;581        {
;;;582            uint32_t transfer_size = (obj->transaction_buffer_size >= remaining_size)
;;;583                                    ? remaining_size
;;;584                                    : obj->transaction_buffer_size;
;;;585    
;;;586            result = obj->bd->read(obj->bd->context, address, transfer_size, obj->transaction_buffer);
;;;587            if (result != CY_RSLT_SUCCESS)
;;;588            {
;;;589                return result;
;;;590            }
;;;591    
;;;592            *crc = _mtb_kvstore_crc16(obj->transaction_buffer, transfer_size, *crc);
;;;593    
;;;594            address += transfer_size;
;;;595            remaining_size -= transfer_size;
;;;596        }
;;;597        return result;
;;;598    }
