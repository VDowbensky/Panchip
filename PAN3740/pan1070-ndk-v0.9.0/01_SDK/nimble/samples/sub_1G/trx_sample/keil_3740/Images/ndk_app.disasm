;;;195    /**
;;;196      * @brief  Enables or disables the Low Speed APB (APB1) peripheral clock.
;;;197      * @note   After reset, the peripheral clock (used for registers read/write access)
;;;198      *         is disabled and the application software has to enable this clock before 
;;;199      *         using it. 
;;;200      * @param  CLK_APB1Periph: specifies the APB1 peripheral to gates its clock.
;;;201      *          This parameter can be any combination of the following values:
;;;202      *            @arg CLK_APB1Periph_I2C0              
;;;203      *            @arg CLK_APB1Periph_SPI0       
;;;204      *            @arg CLK_APB1Periph_UART0     
;;;205      *            @arg CLK_APB1Periph_PWM01    
