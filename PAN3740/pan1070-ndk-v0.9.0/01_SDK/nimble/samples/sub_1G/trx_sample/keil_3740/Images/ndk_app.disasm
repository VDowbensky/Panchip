;;;3176   
;;;3177   BaseType_t xTaskRemoveFromEventList( const List_t * const pxEventList )
;;;3178   {
;;;3179       TCB_t * pxUnblockedTCB;
;;;3180       BaseType_t xReturn;
;;;3181   
;;;3182       /* THIS FUNCTION MUST BE CALLED FROM A CRITICAL SECTION.  It can also be
;;;3183        * called from a critical section within an ISR. */
