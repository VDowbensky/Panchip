;;;399    //--------------------------------------------------------------------------------------------------
;;;400    // _mtb_kvstore_increment_max_keys
;;;401    //--------------------------------------------------------------------------------------------------
;;;402    static cy_rslt_t _mtb_kvstore_increment_max_keys(mtb_kvstore_t* obj)
;;;403    {
;;;404        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;405        uint32_t new_entry_count = obj->max_entries * 2;
;;;406        mtb_kvstore_ram_table_entry_t* new_table = (mtb_kvstore_ram_table_entry_t*)pvPortMalloc(
;;;407            new_entry_count * sizeof(mtb_kvstore_ram_table_entry_t));
;;;408        if (new_table != NULL)
;;;409        {
;;;410            memcpy(new_table, obj->ram_table, obj->max_entries * sizeof(mtb_kvstore_ram_table_entry_t));
;;;411            vPortFree(obj->ram_table);
;;;412            obj->ram_table = new_table;
;;;413            obj->max_entries = new_entry_count;
;;;414        }
;;;415        else
;;;416        {
;;;417            result = MTB_KVSTORE_MEM_ALLOC_ERROR;
;;;418        }
;;;419        return result;
;;;420    }
