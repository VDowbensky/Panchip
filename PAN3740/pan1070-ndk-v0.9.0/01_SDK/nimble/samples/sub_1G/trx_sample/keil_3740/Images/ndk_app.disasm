;;;3669           ble_hs_unlock();
;;;3670           goto done;
;;;3671       }
;;;3672   
;;;3673       rc = ble_gap_periodic_adv_set(instance, &data);
;;;3674   
;;;3675       ble_hs_unlock();
;;;3676   
;;;3677   done:
;;;3678       os_mbuf_free_chain(data);
;;;3679       return rc;
;;;3680   }
