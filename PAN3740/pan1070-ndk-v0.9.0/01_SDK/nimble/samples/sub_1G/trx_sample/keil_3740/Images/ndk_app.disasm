;;;950    //--------------------------------------------------------------------------------------------------
;;;951    // _mtb_kvstore_write_record
;;;952    //--------------------------------------------------------------------------------------------------
;;;953    static cy_rslt_t _mtb_kvstore_write_record(mtb_kvstore_t* obj,
;;;954                                               uint32_t area_address,
;;;955                                               uint32_t offset,
