;;;1205   /**
;;;1206    * Returns a pointer to a GATT error object with the specified fields.  The
;;;1207    * returned object is statically allocated, so this function is not reentrant.
;;;1208    * This function should only ever be called by the ble_hs task.
;;;1209    */
;;;1210   static struct ble_gatt_error *
;;;1211   ble_gattc_error(int status, uint16_t att_handle)
;;;1212   {
