;;;310                key_sec.peer_addr = addrs.peer_id_addr;
;;;311            }
;;;312            ble_hs_unlock();
;;;313    
;;;314            rc = ble_store_read_peer_sec(&key_sec, &value_sec);
;;;315            if (rc == 0 && value_sec.ltk_present) {
;;;316                *out_att_err = BLE_ATT_ERR_INSUFFICIENT_ENC;
;;;317            } else {
;;;318                *out_att_err = BLE_ATT_ERR_INSUFFICIENT_AUTHEN;
;;;319            }
;;;320    
;;;321            return BLE_HS_ATT_ERR(*out_att_err);
;;;322        }
;;;323    
;;;324        if (authen && !sec_state.authenticated) {
