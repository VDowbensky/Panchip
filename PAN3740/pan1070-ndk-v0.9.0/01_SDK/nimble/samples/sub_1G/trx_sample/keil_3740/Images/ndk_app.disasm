;;;2531   int
;;;2532   ble_gap_adv_start(uint8_t own_addr_type, const ble_addr_t *direct_addr,
;;;2533                     int32_t duration_ms,
;;;2534                     const struct ble_gap_adv_params *adv_params,
;;;2535                     ble_gap_event_fn *cb, void *cb_arg)
