;;;3634   static int
;;;3635   ble_gap_periodic_adv_set_data_validate(uint8_t instance,
;;;3636                                          struct os_mbuf *data)
;;;3637   {
;;;3638       /* The corresponding extended advertising instance should be configured */
;;;3639       if (!ble_gap_slave[instance].configured) {
;;;3640           return BLE_HS_EINVAL;
;;;3641       }
;;;3642   
;;;3643       if (ble_gap_slave[instance].legacy_pdu) {
;;;3644           return BLE_HS_EINVAL;
;;;3645       }
;;;3646   
;;;3647       /* One more check states that if the periodic advertising is already
;;;3648        * enabled, the operation shall be 0x03 (Complete).
;;;3649        * This check is handled during sending the data to the controller, as the
;;;3650        * length checks are already checked there, so this saves duplicate code
;;;3651        */
;;;3652   
;;;3653       return 0;
;;;3654   }
;;;3655   
;;;3656   int
;;;3657   ble_gap_periodic_adv_set_data(uint8_t instance, struct os_mbuf *data)
;;;3658   {
;;;3659       int rc;
