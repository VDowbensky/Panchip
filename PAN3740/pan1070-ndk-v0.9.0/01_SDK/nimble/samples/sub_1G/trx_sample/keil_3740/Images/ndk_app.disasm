;;;1284   //--------------------------------------------------------------------------------------------------
;;;1285   // _mtb_kvstore_build_ram_table
;;;1286   //--------------------------------------------------------------------------------------------------
;;;1287   static cy_rslt_t _mtb_kvstore_build_ram_table(mtb_kvstore_t* obj)
;;;1288   {
;;;1289       CY_ASSERT(obj != NULL);
;;;1290       cy_rslt_t result = CY_RSLT_SUCCESS;
;;;1291   
;;;1292       // Each key will occupy at least a page hence the max number of keys
;;;1293       // that fit in the space would be area size / page size.
;;;1294       obj->num_entries = 0;
;;;1295       obj->max_entries = _MTB_KVSTORE_INIT_MAX_KEYS;
;;;1296       obj->free_space_offset = _MTB_KVSTORE_AREA_SIZE(obj);
;;;1297   
;;;1298       //We initially allocate ram table for 32 entries
;;;1299       obj->ram_table =
;;;1300           (mtb_kvstore_ram_table_entry_t*)pvPortMalloc(obj->max_entries *
;;;1301                                                  sizeof(mtb_kvstore_ram_table_entry_t));
;;;1302       if (NULL == obj->ram_table)
;;;1303       {
;;;1304           return MTB_KVSTORE_MEM_ALLOC_ERROR;
;;;1305       }
;;;1306   
;;;1307       // Start looking from the end of the area header.
;;;1308       uint32_t record_size = _mtb_kvstore_get_area_header_record_size(obj, obj->active_area_addr);
;;;1309       // Add area header size to consumed size.
;;;1310       obj->consumed_size = record_size;
;;;1311   
;;;1312       uint32_t offset = record_size;
;;;1313       while ((offset + sizeof(_mtb_kvstore_record_header_t)) < obj->free_space_offset)
;;;1314       {
;;;1315           _mtb_kvstore_record_header_t header;
;;;1316           result = _mtb_kvstore_read_record(obj, obj->active_area_addr, offset, &header,
;;;1317                                             obj->key_buffer, false, NULL, NULL);
;;;1318           if (result != CY_RSLT_SUCCESS)
;;;1319           {
;;;1320               if (MTB_KVSTORE_ERASED_DATA_ERROR == result)
;;;1321               {
;;;1322                   // This is a special case since it is expected that we stop populating
;;;1323                   // the ram table when we encounter free space.
;;;1324                   // Hence we return success even though read record return an error.
;;;1325                   result = CY_RSLT_SUCCESS;
;;;1326               }
;;;1327               else if (MTB_KVSTORE_INVALID_DATA_ERROR == result)
;;;1328               {
;;;1329                   // If a corrupted record was found we run GC operation
;;;1330                   // which will copy all valid record until the current corrupted
;;;1331                   // record was encountered.
;;;1332                   result = _mtb_kvstore_garbage_collection(obj, NULL);
;;;1333                   // The above function will set the free space offset in the new area
;;;1334                   // so we directly return the result. The consumed size
;;;1335                   // is already updated in this loop and will not change even after the
;;;1336                   // GC operation.
;;;1337                   return result;
;;;1338               }
;;;1339               break;
;;;1340           }
;;;1341   
;;;1342           // This should be safe as we allocate 1 extra byte in the key buffer than the max key size.
;;;1343           obj->key_buffer[header.key_size] = '\0';
;;;1344   
;;;1345           uint32_t ram_tbl_idx;
;;;1346           uint16_t hash;
;;;1347           uint32_t old_record_data_size = 0;
;;;1348           result = _mtb_kvstore_find_record_in_ram_table(obj, obj->key_buffer, &ram_tbl_idx, &hash,
;;;1349                                                          &old_record_data_size);
;;;1350           if ((result != CY_RSLT_SUCCESS) && (result != MTB_KVSTORE_ITEM_NOT_FOUND_ERROR))
;;;1351           {
;;;1352               break;
;;;1353           }
;;;1354   
;;;1355           uint32_t curr_offset = offset;
;;;1356           // Add the current record size to the offset to set the next offset.
;;;1357           record_size = _mtb_kvstore_get_record_size(obj, obj->active_area_addr + curr_offset,
;;;1358                                                      header.key_size, header.data_size);
;;;1359           offset += record_size;
;;;1360   
;;;1361           bool delete = (header.flags & _MTB_KVSTORE_DELETE_FLAG) != 0;
;;;1362           bool found_in_table = (result != MTB_KVSTORE_ITEM_NOT_FOUND_ERROR);
;;;1363   
;;;1364           // If key was not found in the RAM table and is marked for deletion
;;;1365           // then do nothing.
;;;1366           if (delete && !found_in_table)
;;;1367           {
;;;1368               continue;
;;;1369           }
;;;1370   
;;;1371           _mtb_kvstore_operation_t operation = (delete)
;;;1372                                               ? _MTB_KVSTORE_OPER_DELETE
;;;1373                                               : (found_in_table) ? _MTB_KVSTORE_OPER_UPDATE :
;;;1374                                                _MTB_KVSTORE_OPER_ADD;
;;;1375   
