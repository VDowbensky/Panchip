;;;2570       if (rc != 0) {
;;;2571           goto done;
;;;2572       }
;;;2573   
;;;2574       BLE_HS_LOG(INFO, "GAP procedure initiated: advertise; ");
;;;2575       ble_gap_log_adv(own_addr_type, direct_addr, adv_params);
;;;2576       // BLE_HS_LOG(INFO, "\n");
