;;;1276       uint32_t new_gc_area_addr = obj->active_area_addr;
;;;1277       obj->active_area_addr = obj->gc_area_addr;
;;;1278       obj->gc_area_addr = new_gc_area_addr;
;;;1279   
;;;1280       return result;
