;;;821                    } else if (*format != BLE_ATT_FIND_INFO_RSP_FORMAT_16BIT) {
;;;822                        rc = 0;
;;;823                        goto done;
;;;824                    }
;;;825    
;;;826                    entry_sz = 4;
;;;827                } else {
;;;828                    if (*format == 0) {
;;;829                        *format = BLE_ATT_FIND_INFO_RSP_FORMAT_128BIT;
;;;830                    } else if (*format != BLE_ATT_FIND_INFO_RSP_FORMAT_128BIT) {
;;;831                        rc = 0;
;;;832                        goto done;
;;;833                    }
;;;834                    entry_sz = 18;
;;;835                }
;;;836    
;;;837                if (OS_MBUF_PKTLEN(om) + entry_sz > mtu) {
;;;838                    rc = 0;
;;;839                    goto done;
;;;840                }
;;;841    
;;;842                buf = os_mbuf_extend(om, entry_sz);
;;;843                if (buf == NULL) {
;;;844                    rc = BLE_HS_ENOMEM;
;;;845                    goto done;
;;;846                }
;;;847    
;;;848                put_le16(buf + 0, ha->ha_handle_id);
;;;849    
;;;850                ble_uuid_flat(ha->ha_uuid, buf + 2);
;;;851    
;;;852                num_entries++;
;;;853            }
;;;854        }
;;;855    
;;;856    done:
;;;857        if (rc == 0 && num_entries == 0) {
