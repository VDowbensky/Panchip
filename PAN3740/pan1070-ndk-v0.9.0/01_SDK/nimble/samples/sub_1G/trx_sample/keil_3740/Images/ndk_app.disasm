;;;892    //--------------------------------------------------------------------------------------------------
;;;893    // _mtb_kvstore_buffered_write
;;;894    //--------------------------------------------------------------------------------------------------
;;;895    static cy_rslt_t _mtb_kvstore_buffered_write(mtb_kvstore_t* obj,
;;;896                                                 const uint8_t* data,
;;;897                                                 uint32_t data_size,
;;;898                                                 uint32_t* write_address,
;;;899                                                 uint32_t* buffer_space_left,
;;;900                                                 bool flush)
;;;901    {
;;;902        CY_ASSERT(obj != NULL);
;;;903        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;904        uint8_t* buffer_offset_ptr = obj->transaction_buffer +
;;;905                                     (obj->transaction_buffer_size - *buffer_space_left);
;;;906        const uint8_t* current_data_ptr = data;
;;;907        uint32_t remaining_size = data_size;
;;;908        while (remaining_size > 0)
;;;909        {
;;;910            uint32_t transfer_size =
;;;911                (*buffer_space_left >= remaining_size) ? remaining_size : *buffer_space_left;
;;;912            memcpy(buffer_offset_ptr, current_data_ptr, transfer_size);
;;;913            *buffer_space_left -= transfer_size;
;;;914            buffer_offset_ptr += transfer_size;
;;;915            remaining_size -= transfer_size;
;;;916            current_data_ptr += transfer_size;
;;;917            if (*buffer_space_left == 0)
;;;918            {
;;;919                result = obj->bd->program(obj->bd->context, *write_address,
;;;920                                          obj->transaction_buffer_size,
;;;921                                          obj->transaction_buffer);
;;;922                if (result != CY_RSLT_SUCCESS)
;;;923                {
;;;924                    return result;
;;;925                }
;;;926                *buffer_space_left = obj->transaction_buffer_size;
;;;927                buffer_offset_ptr = obj->transaction_buffer;
;;;928                *write_address += obj->transaction_buffer_size;
;;;929            }
;;;930        }
;;;931    
;;;932        if ((*buffer_space_left != obj->transaction_buffer_size) && flush)
;;;933        {
;;;934            uint32_t prog_size = obj->bd->program_size(obj->bd->context, *write_address);
;;;935            uint32_t size = _mtb_kvstore_align_up(obj->transaction_buffer_size - *buffer_space_left,
;;;936                                                  prog_size);
;;;937            result = obj->bd->program(obj->bd->context, *write_address,
;;;938                                      size,
;;;939                                      obj->transaction_buffer);
;;;940            if (result != CY_RSLT_SUCCESS)
;;;941            {
;;;942                return result;
;;;943            }
;;;944            *buffer_space_left = obj->transaction_buffer_size;
;;;945        }
;;;946        return result;
;;;947    }
