;;;4866    *                                  If this parameter is NULL, the white list
;;;4867    *                                  is used.
;;;4868    * @param duration_ms           The duration of the discovery procedure.
;;;4869    *                                  On expiration, the procedure ends and a
;;;4870    *                                  BLE_GAP_EVENT_DISC_COMPLETE event is
;;;4871    *                                  reported.  Units are milliseconds.
