;;;368    /**
;;;369     * @brief       Set De-bounce Sampling Cycle Time
;;;370     *
;;;371     * @param[in]   clksrc      The de-bounce counter clock source. It could be GPIO_DBCTL_DBCLKSRC_HCLK or GPIO_DBCTL_DBCLKSRC_RCL.
;;;372     * @param[in]   clksel      The de-bounce sampling cycle selection. It could be \n
;;;373     *                              - \ref GPIO_DBCTL_DBCLKSEL_1, \ref GPIO_DBCTL_DBCLKSEL_2, \ref GPIO_DBCTL_DBCLKSEL_4, \ref GPIO_DBCTL_DBCLKSEL_8, \n
;;;374     *                              - \ref GPIO_DBCTL_DBCLKSEL_16, \ref GPIO_DBCTL_DBCLKSEL_32, \ref GPIO_DBCTL_DBCLKSEL_64, \ref GPIO_DBCTL_DBCLKSEL_128, \n
;;;375     *                              - \ref GPIO_DBCTL_DBCLKSEL_256, \ref GPIO_DBCTL_DBCLKSEL_512, \ref GPIO_DBCTL_DBCLKSEL_1024, \ref GPIO_DBCTL_DBCLKSEL_2048, \n
;;;376     *                              - \ref GPIO_DBCTL_DBCLKSEL_4096, \ref GPIO_DBCTL_DBCLKSEL_8192, \ref GPIO_DBCTL_DBCLKSEL_16384, \ref GPIO_DBCTL_DBCLKSEL_32768.
;;;377     *
;;;378     * @return      None
;;;379     *
;;;380     * @details     Set the interrupt de-bounce sampling cycle time based on the debounce counter clock source. \n
;;;381     *              Example: GPIO_SET_DEBOUNCE_TIME(GPIO_DBCTL_DBCLKSRC_RCL, GPIO_DBCTL_DBCLKSEL_4). \n
;;;382     *              It's meaning the De-debounce counter clock source is internal 10 KHz and sampling cycle selection is 4. \n
;;;383     *              Then the target de-bounce sampling cycle time is (2^4)*(1/(10*1000)) s = 16*0.0001 s = 1600 us,
;;;384     *              and system will sampling interrupt input once per 1600 us.
;;;385     */
;;;386    __STATIC_INLINE void GPIO_SetDebounceTime(GPIO_ClkSrcDef clksrc, GPIO_ClkSelDef clksel)
;;;387    {
;;;388    	GPIO_DB->DBCTL =  (GPIO_DB->DBCTL & ~(GP_DBCTL_DBCLKSRC_Msk | 0xf)) | (clksrc | clksel);
;;;389    }
