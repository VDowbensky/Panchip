;;;156        CLK_PCLK2Config(CONFIG_APB2_CLOCK_DIVISOR >> 1);
;;;157        /*
;;;158         * Note that all clocks on APB are disabled by default after SoC power up, and
;;;159         * the default AHB clocks enabled after SoC power up are:
;;;160         * ACC/eFuse/ROM/RCC_AHB/Systick/GPIO.
;;;161         * Here we disable ACC, eFuse and ROM clock as these modules are not commonly
;;;162         * used. We should re-enabled them once we use later.
;;;163         * Here We also enable APB1 and APB2 clock path to make sure modules on APB can
;;;164         * be easily enabled by each peripheral driver by enabling their clock enable
;;;165         * bits on APB bus.
;;;166         */
;;;167        CLK_AHBPeriphClockCmd(CLK_AHBPeriph_ROM, DISABLE);
;;;168        CLK_AHBPeriphClockCmd(CLK_AHBPeriph_APB1 | CLK_AHBPeriph_APB2, ENABLE);
