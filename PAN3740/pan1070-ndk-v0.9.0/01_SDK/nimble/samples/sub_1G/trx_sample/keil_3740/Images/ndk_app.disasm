;;;310    
;;;311    /**
;;;312     * Indicates whether the set of registered services can be modified.  The
;;;313     * service set is mutable if:
;;;314     *     o No peers are connected, and
;;;315     *     o No GAP operations are active (advertise, discover, or connect).
;;;316     *
;;;317     * @return                      true if the GATT service set can be modified;
;;;318     *                              false otherwise.
;;;319     */
;;;320    static bool
;;;321    ble_gatts_mutable(void)
;;;322    {
;;;323        /* Ensure no active GAP procedures. */
;;;324        if (ble_gap_adv_active() ||
;;;325            ble_gap_disc_active() ||
;;;326            ble_gap_conn_active()) {
;;;327    
;;;328            return false;
;;;329        }
;;;330    
;;;331        /* Ensure no established connections. */
;;;332        if (ble_hs_conn_first() != NULL) {
;;;333            return false;
;;;334        }
;;;335    
;;;336        return true;
;;;337    }
