;;;1161   /**
;;;1162    * Times out expired GATT client procedures.
;;;1163    *
;;;1164    * @return                      The number of ticks until this function should
;;;1165    *                                  be called again.
;;;1166    */
;;;1167   int32_t
;;;1168   ble_gattc_timer(void)
;;;1169   {
;;;1170       struct ble_gattc_proc_list exp_list;
;;;1171       struct ble_gattc_proc *proc;
;;;1172       int32_t ticks_until_resume;
;;;1173       int32_t ticks_until_exp;
;;;1174   
;;;1175       /* Remove timed-out procedures from the main list and insert them into a
;;;1176        * temporary list.  This function also calculates the number of ticks until
;;;1177        * the next expiration will occur.
;;;1178        */
;;;1179       ticks_until_exp = ble_gattc_extract_expired(&exp_list);
;;;1180   
;;;1181       /* Terminate the connection associated with each timed-out procedure. */
;;;1182       while ((proc = STAILQ_FIRST(&exp_list)) != NULL) {
;;;1183           STATS_INC(ble_gattc_stats, proc_timeout);
;;;1184   
;;;1185           ble_gattc_proc_timeout(proc);
;;;1186   
;;;1187           ble_gap_terminate(proc->conn_handle, BLE_ERR_REM_USER_CONN_TERM);
;;;1188   
;;;1189           STAILQ_REMOVE_HEAD(&exp_list, next);
;;;1190           ble_gattc_proc_free(proc);
;;;1191       }
;;;1192   
;;;1193       /* If there are stalled procedures, the GATT client will need to wake up to
;;;1194        * resume them.
;;;1195        */
;;;1196       ticks_until_resume = ble_gattc_ticks_until_resume();
;;;1197       if (ticks_until_resume == 0) {
;;;1198           ble_gattc_resume_procs();
;;;1199           ticks_until_resume = ble_gattc_ticks_until_resume();
;;;1200       }
;;;1201   
;;;1202       return min(ticks_until_exp, ticks_until_resume);
;;;1203   }
