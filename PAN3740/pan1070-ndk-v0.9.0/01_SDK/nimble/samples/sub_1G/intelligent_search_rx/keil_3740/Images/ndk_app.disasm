;;;632    /**
;;;633     * Performs a read or write access on a client characteritic configuration
;;;634     * descriptor (CCCD).
;;;635     *
;;;636     * @param conn                  The connection of the peer doing the accessing.
;;;637     * @apram attr_handle           The handle of the CCCD.
;;;638     * @param att_op                The ATT operation being performed (read or
;;;639     *                                  write).
;;;640     * @param ctxt                  Communication channel between this function and
;;;641     *                                  the caller within the nimble stack.
;;;642     *                                  Semantics depends on the operation being
;;;643     *                                  performed.
;;;644     * @param out_cccd              If the CCCD should be persisted as a result of
;;;645     *                                  the access, the data-to-be-persisted gets
;;;646     *                                  written here.  If no persistence is
;;;647     *                                  necessary, out_cccd->chr_val_handle is set
;;;648     *                                  to 0.
;;;649     *
;;;650     * @return                      0 on success; nonzero on failure.
;;;651     */
;;;652    static int
;;;653    ble_gatts_clt_cfg_access_locked(struct ble_hs_conn *conn, uint16_t attr_handle,
;;;654                                    uint8_t att_op, uint16_t offset,
;;;655                                    struct os_mbuf *om,
;;;656                                    struct ble_store_value_cccd *out_cccd,
;;;657                                    uint8_t *out_prev_clt_cfg_flags,
;;;658                                    uint8_t *out_cur_clt_cfg_flags)
;;;659    {
;;;660        struct ble_gatts_clt_cfg *clt_cfg;
