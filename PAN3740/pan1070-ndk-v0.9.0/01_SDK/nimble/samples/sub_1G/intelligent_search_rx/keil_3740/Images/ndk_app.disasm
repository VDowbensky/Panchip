;;;1269                                         ble_npl_time_ms_to_ticks32(BLE_GAP_UPDATE_TIMEOUT_MS);
;;;1270               }
;;;1271               break;
;;;1272   
;;;1273           default:
;;;1274               break;
;;;1275           }
;;;1276       }
;;;1277   
;;;1278       /* We aren't failing over to L2CAP, the update procedure is complete. */
;;;1279       if (l2cap_params.itvl_min == 0) {
