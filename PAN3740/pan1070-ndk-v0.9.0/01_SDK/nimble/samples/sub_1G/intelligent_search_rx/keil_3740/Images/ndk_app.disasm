;;;2034       }
;;;2035   
;;;2036       /*** Timer expired; process event. */
;;;2037   
;;;2038       switch (ble_gap_master.op) {
;;;2039   #if NIMBLE_BLE_CONNECT
;;;2040       case BLE_GAP_OP_M_CONN:
