;;;1912   /**
;;;1913    * @brief calculate mapm preamble can sleep time
;;;1914    * @param[in] <none>
;;;1915    * @return sleeptime(ms)
;;;1916    */
;;;1917   uint32_t rf_calculate_mapm_preambletime(stc_mapm_cfg_t *mapm_cfg, uint32_t one_chirp_time)
;;;1918   {
;;;1919       uint8_t fnm, gn, pgn, pg1, fn, pn;
;;;1920       uint16_t one_field_chirp, chirp_num;
;;;1921       uint32_t preamble_time;
;;;1922   
;;;1923       pn = mapm_cfg->pn;
;;;1924       pgn = mapm_cfg->pgn;
;;;1925       pg1 = mapm_cfg->pg1;
;;;1926       gn = mapm_cfg->gn;
;;;1927       fnm = mapm_cfg->fnm;
;;;1928       fn = mapm_cfg->fn;
;;;1929       one_field_chirp = pg1 + 2 + (pgn + 2) * gn;
;;;1930       chirp_num = (1 << fnm) * fn * one_field_chirp + pn - one_field_chirp;
;;;1931       preamble_time = one_chirp_time * chirp_num;
;;;1932   
;;;1933       return preamble_time / 1000;
;;;1934   }
