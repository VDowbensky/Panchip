;;;2961   int
;;;2962   ble_gap_ext_adv_start(uint8_t instance, int duration, int max_events)
;;;2963   {
;;;2964       struct ble_hci_le_set_ext_adv_enable_cp *cmd;
;;;2965       uint8_t buf[sizeof(*cmd) + sizeof(cmd->sets[0])];
;;;2966       const uint8_t *rnd_addr;
;;;2967       uint16_t opcode;
;;;2968       int rc;
;;;2969   
;;;2970       if (instance >= BLE_ADV_INSTANCES) {
;;;2971           return BLE_HS_EINVAL;
;;;2972       }
;;;2973   
;;;2974       ble_hs_lock();
;;;2975       if (!ble_gap_slave[instance].configured) {
;;;2976           ble_hs_unlock();
