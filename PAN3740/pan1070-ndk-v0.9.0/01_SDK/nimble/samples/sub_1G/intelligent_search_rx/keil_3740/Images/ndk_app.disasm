;;;3800       }
;;;3801   
;;;3802       cmd.sid = adv_sid;
;;;3803       cmd.skip = params->skip;
;;;3804       cmd.sync_timeout = htole16(params->sync_timeout);
;;;3805       cmd.sync_cte_type = 0x00;
