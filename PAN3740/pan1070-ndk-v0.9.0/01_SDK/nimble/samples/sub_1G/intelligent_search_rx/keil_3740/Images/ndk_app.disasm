;;;789     *                                  Data field gets written.
;;;790     * @param mtu                   The ATT L2CAP channel MTU.
;;;791     * @param format                On success, the format field of the response
;;;792     *                                  gets stored here.  One of:
;;;793     *                                     o BLE_ATT_FIND_INFO_RSP_FORMAT_16BIT
;;;794     *                                     o BLE_ATT_FIND_INFO_RSP_FORMAT_128BIT
;;;795     *
;;;796     * @return                      0 on success; nonzero on failure.
;;;797     */
;;;798    static int
