;;;1005    *
;;;1006    * @param out_ticks_from_now    On success, the ticks until the update
;;;1007    *                                  procedure's expiry time gets written here.
;;;1008    *
;;;1009    * @return                      The connection handle of the update procedure
;;;1010    *                                  that expires soonest, or
;;;1011    *                                  BLE_HS_CONN_HANDLE_NONE if there are no
;;;1012    *                                  active update procedures.
;;;1013    */
