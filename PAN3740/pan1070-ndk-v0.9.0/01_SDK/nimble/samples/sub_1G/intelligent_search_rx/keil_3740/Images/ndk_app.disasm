;;;791     * @param format                On success, the format field of the response
;;;792     *                                  gets stored here.  One of:
;;;793     *                                     o BLE_ATT_FIND_INFO_RSP_FORMAT_16BIT
;;;794     *                                     o BLE_ATT_FIND_INFO_RSP_FORMAT_128BIT
;;;795     *
;;;796     * @return                      0 on success; nonzero on failure.
;;;797     */
;;;798    static int
;;;799    ble_att_svr_fill_info(uint16_t start_handle, uint16_t end_handle,
;;;800                          struct os_mbuf *om, uint16_t mtu, uint8_t *format)
;;;801    {
;;;802        struct ble_att_svr_entry *ha;
;;;803        uint8_t *buf;
;;;804        int num_entries;
;;;805        int entry_sz;
;;;806        int rc;
;;;807    
;;;808        *format = 0;
;;;809        num_entries = 0;
;;;810        rc = 0;
;;;811    
;;;812        STAILQ_FOREACH(ha, &ble_att_svr_list, ha_next) {
;;;813            if (ha->ha_handle_id > end_handle) {
;;;814                rc = 0;
;;;815                goto done;
;;;816            }
;;;817            if (ha->ha_handle_id >= start_handle) {
;;;818                if (ha->ha_uuid->type == BLE_UUID_TYPE_16) {
;;;819                    if (*format == 0) {
;;;820                        *format = BLE_ATT_FIND_INFO_RSP_FORMAT_16BIT;
;;;821                    } else if (*format != BLE_ATT_FIND_INFO_RSP_FORMAT_16BIT) {
;;;822                        rc = 0;
;;;823                        goto done;
;;;824                    }
;;;825    
;;;826                    entry_sz = 4;
;;;827                } else {
;;;828                    if (*format == 0) {
;;;829                        *format = BLE_ATT_FIND_INFO_RSP_FORMAT_128BIT;
;;;830                    } else if (*format != BLE_ATT_FIND_INFO_RSP_FORMAT_128BIT) {
;;;831                        rc = 0;
;;;832                        goto done;
;;;833                    }
;;;834                    entry_sz = 18;
;;;835                }
;;;836    
;;;837                if (OS_MBUF_PKTLEN(om) + entry_sz > mtu) {
;;;838                    rc = 0;
;;;839                    goto done;
;;;840                }
;;;841    
;;;842                buf = os_mbuf_extend(om, entry_sz);
;;;843                if (buf == NULL) {
;;;844                    rc = BLE_HS_ENOMEM;
;;;845                    goto done;
;;;846                }
;;;847    
;;;848                put_le16(buf + 0, ha->ha_handle_id);
;;;849    
;;;850                ble_uuid_flat(ha->ha_uuid, buf + 2);
;;;851    
;;;852                num_entries++;
;;;853            }
;;;854        }
;;;855    
;;;856    done:
;;;857        if (rc == 0 && num_entries == 0) {
;;;858            return BLE_HS_ENOENT;
;;;859        } else {
;;;860            return rc;
;;;861        }
;;;862    }
