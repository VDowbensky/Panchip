;;;898            *att_err = BLE_ATT_ERR_ATTR_NOT_FOUND;
;;;899            rc = BLE_HS_ENOENT;
;;;900            goto done;
;;;901        }
;;;902    
;;;903        rc = 0;
;;;904    
;;;905    done:
;;;906        *out_txom = txom;
;;;907        return rc;
;;;908    }
