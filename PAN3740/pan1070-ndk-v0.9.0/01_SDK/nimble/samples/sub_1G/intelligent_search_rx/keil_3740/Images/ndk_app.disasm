;;;1993       res->app_status = ble_hs_mbuf_pullup_base(om, sizeof(*rsp));
;;;1994       if (res->app_status != 0) {
;;;1995           res->enc_cb = 1;
;;;1996           return;
;;;1997       }
;;;1998   
;;;1999       rsp = (struct ble_sm_pair_cmd *)(*om)->om_data;
;;;2000   
;;;2001       ble_hs_lock();
;;;2002       proc = ble_sm_proc_find(conn_handle, BLE_SM_PROC_STATE_PAIR, 1, NULL);
;;;2003       if (proc != NULL) {
;;;2004           proc->pair_rsp[0] = BLE_SM_OP_PAIR_RSP;
;;;2005           memcpy(proc->pair_rsp + 1, rsp, sizeof(*rsp));
;;;2006   
;;;2007           if (rsp->max_enc_key_size < BLE_SM_PAIR_KEY_SZ_MIN) {
;;;2008               res->sm_err = BLE_SM_ERR_ENC_KEY_SZ;
;;;2009               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_ENC_KEY_SZ);
;;;2010           } else if (rsp->max_enc_key_size > BLE_SM_PAIR_KEY_SZ_MAX) {
;;;2011               res->sm_err = BLE_SM_ERR_INVAL;
;;;2012               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_INVAL);
;;;2013           } else if (MYNEWT_VAL(BLE_SM_SC_ONLY) && (rsp->max_enc_key_size != BLE_SM_PAIR_KEY_SZ_MAX)) {
;;;2014               /* Fail if Secure Connections Only mode is on and remote does not meet
;;;2015               * key size requirements - MITM was checked in last step
;;;2016               */
;;;2017               res->sm_err = BLE_SM_ERR_ENC_KEY_SZ;
;;;2018               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_ENC_KEY_SZ);
;;;2019           } else if (!ble_sm_verify_auth_requirements(rsp->authreq)) {
;;;2020               res->sm_err = BLE_SM_ERR_AUTHREQ;
;;;2021               res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_AUTHREQ);
;;;2022           } else {
;;;2023               ble_sm_pair_cfg(proc);
;;;2024   
;;;2025               rc = ble_sm_io_action(proc, &ioact);
;;;2026               if (rc != 0) {
;;;2027                   res->sm_err = BLE_SM_ERR_AUTHREQ;
;;;2028                   res->app_status = BLE_HS_SM_US_ERR(BLE_SM_ERR_AUTHREQ);
;;;2029                   res->enc_cb = 1;
;;;2030               } else {
;;;2031                   proc->state = ble_sm_state_after_pair(proc);
;;;2032                   if (ble_sm_ioact_state(ioact) == proc->state) {
;;;2033                       res->passkey_params.action = ioact;
;;;2034                   }
;;;2035                   if (ble_sm_proc_can_advance(proc)) {
;;;2036                       res->execute = 1;
;;;2037                   }
;;;2038               }
;;;2039           }
;;;2040       }
;;;2041   
;;;2042       ble_hs_unlock();
;;;2043   }
