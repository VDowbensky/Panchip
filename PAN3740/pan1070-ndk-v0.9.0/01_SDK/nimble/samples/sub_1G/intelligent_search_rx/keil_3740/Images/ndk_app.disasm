;;;2452           ble_hs_unlock();
;;;2453   
;;;2454           if (flags) {
;;;2455               /* Perform attribute writes. */
;;;2456               att_err = ble_att_svr_prep_write(conn_handle, &prep_list,
;;;2457                                                &err_handle);
;;;2458               if (att_err != 0) {
;;;2459                   rc = BLE_HS_EAPP;
;;;2460               }
;;;2461           }
;;;2462   
;;;2463           /* Free the prep entries. */
;;;2464           ble_att_svr_prep_clear(&prep_list);
;;;2465       }
;;;2466   
;;;2467       rc = ble_att_svr_tx_rsp(conn_handle, rc, txom, BLE_ATT_OP_EXEC_WRITE_REQ,
;;;2468                               att_err, err_handle);
;;;2469       return rc;
;;;2470   }
;;;2471   
;;;2472   int
;;;2473   ble_att_svr_rx_notify(uint16_t conn_handle, struct os_mbuf **rxom)
