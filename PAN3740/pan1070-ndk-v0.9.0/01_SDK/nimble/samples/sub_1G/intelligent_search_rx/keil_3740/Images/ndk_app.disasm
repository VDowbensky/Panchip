;;;1219   
;;;1220       rc = ble_l2cap_coc_create_srv_chan(conn, le16toh(req->psm), &chan);
;;;1221       if (rc != 0) {
;;;1222           uint16_t coc_err = ble_l2cap_sig_ble_hs_err2coc_err(rc);
;;;1223           rsp->result = htole16(coc_err);
;;;1224           ble_hs_unlock();
;;;1225           goto failed;
;;;1226       }
;;;1227   
;;;1228       /* Fill up remote configuration. Note MPS is the L2CAP MTU*/
;;;1229       chan->dcid = scid;
;;;1230       chan->peer_coc_mps = le16toh(req->mps);
;;;1231       chan->coc_tx.credits = le16toh(req->credits);
