;;;5497   static bool
;;;5498   ble_gap_validate_conn_params(const struct ble_gap_upd_params *params)
;;;5499   {
;;;5500   
;;;5501       /* Requirements from Bluetooth spec. v4.2 [Vol 2, Part E], 7.8.18 */
;;;5502       if (params->itvl_min > params->itvl_max) {
;;;5503           return false;
;;;5504       }
;;;5505   
;;;5506       if (params->itvl_min < 0x0006 || params->itvl_max > 0x0C80) {
;;;5507           return false;
;;;5508       }
;;;5509   
;;;5510       if (params->latency > 0x01F3) {
;;;5511           return false;
;;;5512       }
;;;5513   
;;;5514       /* According to specification mentioned above we should make sure that:
;;;5515        * supervision_timeout_ms > (1 + latency) * 2 * max_interval_ms
;;;5516        *    =>
;;;5517        * supervision_timeout * 10 ms > (1 + latency) * 2 * itvl_max * 1.25ms
;;;5518        */
;;;5519       if (params->supervision_timeout <=
;;;5520                      (((1 + params->latency) * params->itvl_max) / 4)) {
;;;5521           return false;
;;;5522       }
;;;5523   
;;;5524       return true;
;;;5525   }
;;;5526   #endif
;;;5527   
;;;5528   int
;;;5529   ble_gap_update_params(uint16_t conn_handle,
;;;5530                         const struct ble_gap_upd_params *params)
;;;5531   {
;;;5532   #if NIMBLE_BLE_CONNECT
;;;5533       struct ble_l2cap_sig_update_params l2cap_params;
;;;5534       struct ble_gap_update_entry *entry;
;;;5535       struct ble_gap_update_entry *dup;
;;;5536       struct ble_hs_conn *conn;
;;;5537       int l2cap_update;
;;;5538       int rc;
;;;5539   
;;;5540       l2cap_update = 0;
;;;5541   
;;;5542       /* Validate parameters with a spec */
;;;5543       if (!ble_gap_validate_conn_params(params)) {
;;;5544           return BLE_HS_EINVAL;
;;;5545       }
;;;5546   
;;;5547       STATS_INC(ble_gap_stats, update);
;;;5548       memset(&l2cap_params, 0, sizeof l2cap_params);
;;;5549       entry = NULL;
;;;5550   
;;;5551       ble_hs_lock();
;;;5552   
;;;5553       conn = ble_hs_conn_find(conn_handle);
;;;5554       if (conn == NULL) {
;;;5555           rc = BLE_HS_ENOTCONN;
;;;5556           goto done;
;;;5557       }
;;;5558   
;;;5559       /* Don't allow two concurrent updates to the same connection. */
;;;5560       dup = ble_gap_update_entry_find(conn_handle, NULL);
;;;5561       if (dup != NULL) {
;;;5562           rc = BLE_HS_EALREADY;
;;;5563           goto done;
;;;5564       }
;;;5565   
;;;5566       entry = ble_gap_update_entry_alloc();
;;;5567       if (entry == NULL) {
;;;5568           rc = BLE_HS_ENOMEM;
;;;5569           goto done;
;;;5570       }
;;;5571   
;;;5572       entry->conn_handle = conn_handle;
;;;5573       entry->params = *params;
;;;5574   
;;;5575       entry->exp_os_ticks = ble_npl_time_get() +
;;;5576                             ble_npl_time_ms_to_ticks32(BLE_GAP_UPDATE_TIMEOUT_MS);
;;;5577   
;;;5578       BLE_HS_LOG(INFO, "GAP procedure initiated: ");
;;;5579       ble_gap_log_update(conn_handle, params);
;;;5580       // BLE_HS_LOG(INFO, "\n");
;;;5581   
;;;5582       /*
;;;5583        * If LL update procedure is not supported on this connection and we are
;;;5584        * the slave, fail over to the L2CAP update procedure.
;;;5585        */
;;;5586       if ((conn->supported_feat & BLE_HS_HCI_LE_FEAT_CONN_PARAM_REQUEST) == 0 &&
;;;5587               !(conn->bhc_flags & BLE_HS_CONN_F_MASTER)) {
;;;5588           l2cap_update = 1;
;;;5589           rc = 0;
;;;5590       } else {
;;;5591           rc = ble_gap_update_tx(conn_handle, params);
;;;5592       }
;;;5593   
;;;5594   done:
;;;5595       ble_hs_unlock();
;;;5596   
;;;5597       if (!l2cap_update) {
;;;5598           ble_hs_timer_resched();
;;;5599       } else {
;;;5600           ble_gap_update_to_l2cap(params, &l2cap_params);
;;;5601   
;;;5602           rc = ble_l2cap_sig_update(conn_handle, &l2cap_params,
;;;5603                                                 ble_gap_update_l2cap_cb, NULL);
;;;5604       }
;;;5605   
;;;5606       ble_hs_lock();
;;;5607       if (rc == 0) {
;;;5608           SLIST_INSERT_HEAD(&ble_gap_update_entries, entry, next);
;;;5609       } else {
;;;5610           ble_gap_update_entry_free(entry);
;;;5611           STATS_INC(ble_gap_stats, update_fail);
;;;5612       }
;;;5613       ble_hs_unlock();
;;;5614   
;;;5615       return rc;
;;;5616   #else
;;;5617       return BLE_HS_ENOTSUP;
;;;5618   #endif
;;;5619   }
