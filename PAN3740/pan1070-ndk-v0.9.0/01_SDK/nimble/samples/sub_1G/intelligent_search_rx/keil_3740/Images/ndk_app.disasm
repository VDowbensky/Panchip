;;;312                sector_idx <= range_start_sector_idx + range_sector_num;
;;;313                sector_idx += chunk_pattern) {
;;;314            if (*chunk_start_sector_idx == 0) {
;;;315                *chunk_start_sector_idx = (sector_idx == 0) ? chunk_pattern : sector_idx;    //Found chunk start position (and should not be 1st block)
;;;316            } else {
;;;317                *chunk_sector_num += chunk_pattern; //Found multiple expected chunk
;;;318            }
;;;319        }
;;;320    }
