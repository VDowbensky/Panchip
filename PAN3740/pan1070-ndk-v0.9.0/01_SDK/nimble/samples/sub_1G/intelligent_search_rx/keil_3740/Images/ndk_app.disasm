;;;1163       //ble_store_config_conf_save_all();
;;;1164   
;;;1165       event.type = BLE_GAP_EVENT_DISCONNECT;
;;;1166       event.disconnect.reason = reason;
;;;1167   
;;;1168       ble_gap_event_listener_call(&event);
;;;1169       ble_gap_call_event_cb(&event, snap.cb, snap.cb_arg);
;;;1170   
;;;1171       STATS_INC(ble_gap_stats, disconnect);
;;;1172   #endif
;;;1173   }
