;;;3090   
;;;3091   void vTaskPlaceOnEventList( List_t * const pxEventList,
;;;3092                               const TickType_t xTicksToWait )
;;;3093   {
;;;3094       configASSERT( pxEventList );
;;;3095   
;;;3096       /* THIS FUNCTION MUST BE CALLED WITH EITHER INTERRUPTS DISABLED OR THE
;;;3097        * SCHEDULER SUSPENDED AND THE QUEUE BEING ACCESSED LOCKED. */
;;;3098   
;;;3099       /* Place the event list item of the TCB in the appropriate event list.
;;;3100        * This is placed in the list in priority order so the highest priority task
;;;3101        * is the first to be woken by the event.
;;;3102        *
;;;3103        * Note: Lists are sorted in ascending order by ListItem_t.xItemValue.
;;;3104        * Normally, the xItemValue of a TCB's ListItem_t members is:
;;;3105        *      xItemValue = ( configMAX_PRIORITIES - uxPriority )
;;;3106        * Therefore, the event list is sorted in descending priority order.
;;;3107        *
;;;3108        * The queue that contains the event list is locked, preventing
;;;3109        * simultaneous access from interrupts. */
;;;3110       vListInsert( pxEventList, &( pxCurrentTCB->xEventListItem ) );
;;;3111   
;;;3112       prvAddCurrentTaskToDelayedList( xTicksToWait, pdTRUE );
;;;3113   }
;;;3114   /*-----------------------------------------------------------*/
;;;3115   
;;;3116   void vTaskPlaceOnUnorderedEventList( List_t * pxEventList,
;;;3117                                        const TickType_t xItemValue,
;;;3118                                        const TickType_t xTicksToWait )
;;;3119   {
;;;3120       configASSERT( pxEventList );
;;;3121   
;;;3122       /* THIS FUNCTION MUST BE CALLED WITH THE SCHEDULER SUSPENDED.  It is used by
;;;3123        * the event groups implementation. */
;;;3124       configASSERT( uxSchedulerSuspended != 0 );
;;;3125   
;;;3126       /* Store the item value in the event list item.  It is safe to access the
;;;3127        * event list item here as interrupts won't access the event list item of a
;;;3128        * task that is not in the Blocked state. */
;;;3129       listSET_LIST_ITEM_VALUE( &( pxCurrentTCB->xEventListItem ), xItemValue | taskEVENT_LIST_ITEM_VALUE_IN_USE );
;;;3130   
;;;3131       /* Place the event list item of the TCB at the end of the appropriate event
;;;3132        * list.  It is safe to access the event list here because it is part of an
;;;3133        * event group implementation - and interrupts don't access event groups
;;;3134        * directly (instead they access them indirectly by pending function calls to
;;;3135        * the task level). */
;;;3136       listINSERT_END( pxEventList, &( pxCurrentTCB->xEventListItem ) );
;;;3137   
;;;3138       prvAddCurrentTaskToDelayedList( xTicksToWait, pdTRUE );
;;;3139   }
;;;3140   /*-----------------------------------------------------------*/
