;;;650    static void
;;;651    ble_sm_insert(struct ble_sm_proc *proc)
;;;652    {
;;;653    #if MYNEWT_VAL(BLE_HS_DEBUG)
;;;654        struct ble_sm_proc *cur;
;;;655    
;;;656        STAILQ_FOREACH(cur, &ble_sm_procs, next) {
;;;657            BLE_HS_DBG_ASSERT(cur != proc);
;;;658        }
;;;659    #endif
;;;660    
;;;661        STAILQ_INSERT_HEAD(&ble_sm_procs, proc, next);
;;;662    }
;;;663    
;;;664    static int32_t
;;;665    ble_sm_extract_expired(struct ble_sm_proc_list *dst_list)
;;;666    {
;;;667        struct ble_sm_proc *proc;
;;;668        struct ble_sm_proc *prev;
;;;669        struct ble_sm_proc *next;
;;;670        ble_npl_time_t now;
;;;671        ble_npl_stime_t next_exp_in;
;;;672        ble_npl_stime_t time_diff;
;;;673    
;;;674        now = ble_npl_time_get();
;;;675        STAILQ_INIT(dst_list);
;;;676    
;;;677        /* Assume each event is either expired or has infinite duration. */
;;;678        next_exp_in = BLE_HS_FOREVER;
;;;679    
;;;680        ble_hs_lock();
;;;681    
;;;682        prev = NULL;
;;;683        proc = STAILQ_FIRST(&ble_sm_procs);
;;;684        while (proc != NULL) {
;;;685            next = STAILQ_NEXT(proc, next);
;;;686    
;;;687            time_diff = proc->exp_os_ticks - now;
;;;688            if (time_diff <= 0) {
;;;689                /* Procedure has expired; move it to the destination list. */
;;;690                if (prev == NULL) {
;;;691                    STAILQ_REMOVE_HEAD(&ble_sm_procs, next);
;;;692                } else {
;;;693                    STAILQ_REMOVE_AFTER(&ble_sm_procs, prev, next);
;;;694                }
;;;695                STAILQ_INSERT_HEAD(dst_list, proc, next);
;;;696            } else {
;;;697                if (time_diff < next_exp_in) {
;;;698                    next_exp_in = time_diff;
;;;699                }
;;;700            }
;;;701    
;;;702            prev = proc;
;;;703            proc = next;
;;;704        }
;;;705    
;;;706        ble_sm_dbg_assert_no_cycles();
;;;707    
;;;708        ble_hs_unlock();
;;;709    
;;;710        return next_exp_in;
;;;711    }
