        0x0000e7fc:    4668        hF      MOV      r0,sp
        0x0000e7fe:    8286        ..      STRH     r6,[r0,#0x14]
        0x0000e800:    0020         .      MOVS     r0,r4
;;;227        } else {
;;;228            att_err = 0;
;;;229        }
;;;230    
;;;231        if (out_att_err != NULL) {
;;;232            *out_att_err = att_err;
;;;233        }
;;;234    
;;;235        return rc;
;;;236    }
