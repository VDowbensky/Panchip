;;;1389       req->psm = htole16(psm);
;;;1390       req->scid = htole16(chan->scid);
;;;1391       req->mtu = htole16(chan->coc_rx.mtu);
;;;1392       req->mps = htole16(chan->my_coc_mps);
;;;1393       req->credits = htole16(chan->coc_rx.credits);
;;;1394   
;;;1395       ble_hs_unlock();
;;;1396   
;;;1397       rc = ble_l2cap_sig_tx(proc->conn_handle, txom);
;;;1398       if (rc != 0) {
;;;1399           ble_hs_lock();
;;;1400           conn = ble_hs_conn_find_assert(conn_handle);
;;;1401           ble_l2cap_chan_free(conn, chan);
;;;1402           ble_hs_unlock();
;;;1403       }
;;;1404   
;;;1405   done:
;;;1406       ble_l2cap_sig_process_status(proc, rc);
;;;1407   
;;;1408       return rc;
;;;1409   }
