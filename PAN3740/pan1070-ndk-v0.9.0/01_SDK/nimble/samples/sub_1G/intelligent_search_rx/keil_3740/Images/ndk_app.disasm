;;;2397   int
;;;2398   ble_att_svr_rx_exec_write(uint16_t conn_handle, struct os_mbuf **rxom)
;;;2399   {
;;;2400   #if !MYNEWT_VAL(BLE_ATT_SVR_QUEUED_WRITE)
;;;2401       return BLE_HS_ENOTSUP;
