;;;3263       #if ( configUSE_TICKLESS_IDLE != 0 )
;;;3264       {
;;;3265           /* If a task is blocked on a kernel object then xNextTaskUnblockTime
;;;3266            * might be set to the blocked task's time out time.  If the task is
