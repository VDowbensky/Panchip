;;;1517   //--------------------------------------------------------------------------------------------------
;;;1518   // _mtb_kvstore_write_with_flags
;;;1519   //--------------------------------------------------------------------------------------------------
;;;1520   static cy_rslt_t _mtb_kvstore_write_with_flags(mtb_kvstore_t* obj, const char* key,
;;;1521                                                  const uint8_t* data,
;;;1522                                                  uint32_t size, bool delete)
;;;1523   {
;;;1524       CY_ASSERT(obj != NULL);
;;;1525       cy_rslt_t result = CY_RSLT_SUCCESS;
;;;1526   
;;;1527       uint32_t ram_tbl_idx;
;;;1528       uint16_t hash;
;;;1529       uint32_t old_record_data_size = 0;
;;;1530       result = _mtb_kvstore_find_record_in_ram_table(obj, key, &ram_tbl_idx, &hash,
;;;1531                                                      &old_record_data_size);
