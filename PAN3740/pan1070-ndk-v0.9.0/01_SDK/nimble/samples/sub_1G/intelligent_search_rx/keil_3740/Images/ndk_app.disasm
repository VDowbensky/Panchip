;;;3313   
;;;3314   BaseType_t xTaskCheckForTimeOut( TimeOut_t * const pxTimeOut,
;;;3315                                    TickType_t * const pxTicksToWait )
;;;3316   {
;;;3317       BaseType_t xReturn;
;;;3318   
;;;3319       configASSERT( pxTimeOut );
;;;3320       configASSERT( pxTicksToWait );
;;;3321   
;;;3322       taskENTER_CRITICAL();
;;;3323       {
;;;3324           /* Minor optimisation.  The tick count cannot change in this block. */
;;;3325           const TickType_t xConstTickCount = xTickCount;
;;;3326           const TickType_t xElapsedTime = xConstTickCount - pxTimeOut->xTimeOnEntering;
;;;3327   
;;;3328           #if ( INCLUDE_xTaskAbortDelay == 1 )
;;;3329               if( pxCurrentTCB->ucDelayAborted != ( uint8_t ) pdFALSE )
;;;3330               {
;;;3331                   /* The delay was aborted, which is not the same as a time out,
;;;3332                    * but has the same result. */
;;;3333                   pxCurrentTCB->ucDelayAborted = pdFALSE;
;;;3334                   xReturn = pdTRUE;
;;;3335               }
;;;3336               else
;;;3337           #endif
;;;3338   
;;;3339           #if ( INCLUDE_vTaskSuspend == 1 )
;;;3340               if( *pxTicksToWait == portMAX_DELAY )
;;;3341               {
;;;3342                   /* If INCLUDE_vTaskSuspend is set to 1 and the block time
;;;3343                    * specified is the maximum block time then the task should block
;;;3344                    * indefinitely, and therefore never time out. */
;;;3345                   xReturn = pdFALSE;
;;;3346               }
;;;3347               else
;;;3348           #endif
;;;3349   
;;;3350           if( ( xNumOfOverflows != pxTimeOut->xOverflowCount ) && ( xConstTickCount >= pxTimeOut->xTimeOnEntering ) ) /*lint !e525 Indentation preferred as is to make code within pre-processor directives clearer. */
;;;3351           {
;;;3352               /* The tick count is greater than the time at which
;;;3353                * vTaskSetTimeout() was called, but has also overflowed since
;;;3354                * vTaskSetTimeOut() was called.  It must have wrapped all the way
;;;3355                * around and gone past again. This passed since vTaskSetTimeout()
;;;3356                * was called. */
;;;3357               xReturn = pdTRUE;
;;;3358               *pxTicksToWait = ( TickType_t ) 0;
;;;3359           }
;;;3360           else if( xElapsedTime < *pxTicksToWait ) /*lint !e961 Explicit casting is only redundant with some compilers, whereas others require it to prevent integer conversion errors. */
;;;3361           {
;;;3362               /* Not a genuine timeout. Adjust parameters for time remaining. */
;;;3363               *pxTicksToWait -= xElapsedTime;
;;;3364               vTaskInternalSetTimeOutState( pxTimeOut );
;;;3365               xReturn = pdFALSE;
;;;3366           }
;;;3367           else
;;;3368           {
;;;3369               *pxTicksToWait = ( TickType_t ) 0;
;;;3370               xReturn = pdTRUE;
;;;3371           }
;;;3372       }
;;;3373       taskEXIT_CRITICAL();
;;;3374   
;;;3375       return xReturn;
;;;3376   }
