;;;1110   //--------------------------------------------------------------------------------------------------
;;;1111   // _mtb_kvstore_copy_record
;;;1112   //--------------------------------------------------------------------------------------------------
;;;1113   static cy_rslt_t _mtb_kvstore_copy_record(mtb_kvstore_t* obj,
;;;1114                                             uint32_t src_area_addr,
;;;1115                                             uint32_t src_offset,
;;;1116                                             uint32_t dst_area_addr,
;;;1117                                             uint32_t dst_offset,
;;;1118                                             uint32_t* next_dst_offset)
;;;1119   {
;;;1120       CY_ASSERT(obj != NULL);
;;;1121       cy_rslt_t result = CY_RSLT_SUCCESS;
;;;1122   
;;;1123       uint32_t src_record_addr = src_area_addr + src_offset;
;;;1124       uint32_t dst_record_addr = dst_area_addr + dst_offset;
;;;1125   
;;;1126       _mtb_kvstore_record_header_t header;
;;;1127       uint32_t header_size = sizeof(_mtb_kvstore_record_header_t);
;;;1128       // Read header for the record
;;;1129       result = obj->bd->read(obj->bd->context, src_record_addr, header_size, (uint8_t*)&header);
;;;1130       if (result != CY_RSLT_SUCCESS)
;;;1131       {
;;;1132           return result;
;;;1133       }
;;;1134   
;;;1135       uint32_t record_size = _mtb_kvstore_get_record_size(obj, src_record_addr, header.key_size,
;;;1136                                                           header.data_size);
;;;1137       if ((dst_offset + record_size) > (_MTB_KVSTORE_AREA_SIZE(obj)))
;;;1138       {
;;;1139           return MTB_KVSTORE_STORAGE_FULL_ERROR;
;;;1140       }
;;;1141   
;;;1142       uint32_t remaining_size = record_size;
;;;1143       uint32_t read_addr = src_record_addr;
;;;1144       uint32_t write_addr = dst_record_addr;
;;;1145   
;;;1146       while (remaining_size > 0)
;;;1147       {
;;;1148           uint32_t transfer_size =
;;;1149               (obj->transaction_buffer_size >=
;;;1150                remaining_size) ? remaining_size : obj->transaction_buffer_size;
;;;1151           result = obj->bd->read(obj->bd->context, read_addr, transfer_size, obj->transaction_buffer);
;;;1152           if (result != CY_RSLT_SUCCESS)
;;;1153           {
;;;1154               return result;
;;;1155           }
;;;1156   
;;;1157           result = obj->bd->program(obj->bd->context, write_addr, transfer_size,
;;;1158                                     obj->transaction_buffer);
;;;1159           if (result != CY_RSLT_SUCCESS)
;;;1160           {
;;;1161               return result;
;;;1162           }
;;;1163           remaining_size -= transfer_size;
;;;1164           read_addr += transfer_size;
;;;1165           write_addr += transfer_size;
;;;1166       }
;;;1167   
;;;1168       *next_dst_offset = dst_offset + record_size;
;;;1169   
;;;1170       return result;
;;;1171   }
