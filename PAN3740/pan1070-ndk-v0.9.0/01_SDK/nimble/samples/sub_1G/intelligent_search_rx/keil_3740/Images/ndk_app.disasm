;;;791        if (result != CY_RSLT_SUCCESS)
;;;792        {
;;;793            return result;
;;;794        }
;;;795    
;;;796        // Improper use case: reading after the value ended
;;;797        if (offset_bytes > record_header->data_size)
;;;798        {
;;;799            return MTB_KVSTORE_BAD_PARAM_ERROR;
;;;800        }
;;;801    
;;;802        if ((record_header->magic == 0xFFFFFFFFU) || (record_header->magic == 0U))
;;;803        {
;;;804            return MTB_KVSTORE_ERASED_DATA_ERROR;
;;;805        }
;;;806    
;;;807        if (record_header->magic != _MTB_KVSTORE_HEADER_MAGIC)
