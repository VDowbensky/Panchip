        0x0000263e:    7122        "q      STRB     r2,[r4,#4]
;;;430    	while(fmc->X_FL_TRIG){};
        0x00002640:    7920         y      LDRB     r0,[r4,#4]
        0x00002642:    2800        .(      CMP      r0,#0
        0x00002644:    d1fc        ..      BNE      0x2640 ; FMC_SetFlashMode + 228
;;;431        FMC_TrigErrorHandler(fmc);
        0x00002646:    4620         F      MOV      r0,r4
