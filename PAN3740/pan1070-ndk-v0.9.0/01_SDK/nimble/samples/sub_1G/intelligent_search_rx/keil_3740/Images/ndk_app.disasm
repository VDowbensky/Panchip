        0x0000c98a:    f015f9c7    ....    BL       vPortFree ; 0x21d1c
;;;412            obj->ram_table = new_table;
;;;413            obj->max_entries = new_entry_count;
        0x0000c98e:    6167        ga      STR      r7,[r4,#0x14]
        0x0000c990:    60e5        .`      STR      r5,[r4,#0xc]
;;;414        }
;;;415        else
;;;416        {
;;;417            result = MTB_KVSTORE_MEM_ALLOC_ERROR;
;;;418        }
;;;419        return result;
;;;420    }
