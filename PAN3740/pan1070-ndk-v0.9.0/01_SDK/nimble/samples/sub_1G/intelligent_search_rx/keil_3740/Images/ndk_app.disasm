;;;4855   
;;;4856   /**
;;;4857    * Initiates a connect procedure.
;;;4858    *
;;;4859    * @param own_addr_type         The type of address the stack should use for
;;;4860    *                                  itself during connection establishment.
;;;4861    *                                      o BLE_OWN_ADDR_PUBLIC
;;;4862    *                                      o BLE_OWN_ADDR_RANDOM
;;;4863    *                                      o BLE_OWN_ADDR_RPA_PUBLIC_DEFAULT
;;;4864    *                                      o BLE_OWN_ADDR_RPA_RANDOM_DEFAULT
;;;4865    * @param peer_addr             The address of the peer to connect to.
;;;4866    *                                  If this parameter is NULL, the white list
;;;4867    *                                  is used.
;;;4868    * @param duration_ms           The duration of the discovery procedure.
