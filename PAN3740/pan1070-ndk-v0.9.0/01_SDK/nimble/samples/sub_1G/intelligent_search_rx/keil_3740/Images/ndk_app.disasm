;;;1179       ticks_until_exp = ble_gattc_extract_expired(&exp_list);
;;;1180   
;;;1181       /* Terminate the connection associated with each timed-out procedure. */
;;;1182       while ((proc = STAILQ_FIRST(&exp_list)) != NULL) {
;;;1183           STATS_INC(ble_gattc_stats, proc_timeout);
;;;1184   
;;;1185           ble_gattc_proc_timeout(proc);
;;;1186   
;;;1187           ble_gap_terminate(proc->conn_handle, BLE_ERR_REM_USER_CONN_TERM);
;;;1188   
;;;1189           STAILQ_REMOVE_HEAD(&exp_list, next);
;;;1190           ble_gattc_proc_free(proc);
;;;1191       }
;;;1192   
;;;1193       /* If there are stalled procedures, the GATT client will need to wake up to
;;;1194        * resume them.
;;;1195        */
;;;1196       ticks_until_resume = ble_gattc_ticks_until_resume();
