;;;949    
;;;950    //--------------------------------------------------------------------------------------------------
;;;951    // _mtb_kvstore_write_record
;;;952    //--------------------------------------------------------------------------------------------------
;;;953    static cy_rslt_t _mtb_kvstore_write_record(mtb_kvstore_t* obj,
;;;954                                               uint32_t area_address,
;;;955                                               uint32_t offset,
;;;956                                               const char* key,
;;;957                                               const uint8_t* data,
;;;958                                               uint32_t data_size,
;;;959                                               _mtb_kvstore_operation_t operation,
;;;960                                               const _mtb_kvstore_update_ram_table_info_t* ram_tbl_info,
;;;961                                               const _mtb_kvstore_update_consumed_size_info_t* size_info)
;;;962    {
;;;963        CY_ASSERT(obj != NULL);
;;;964        CY_ASSERT(key != NULL);
;;;965        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;966    
;;;967        // Calculate write size
;;;968        uint32_t record_address = area_address + offset;
;;;969        size_t header_size = sizeof(_mtb_kvstore_record_header_t);
;;;970        uint32_t prog_size = obj->bd->program_size(obj->bd->context, record_address);
;;;971    
;;;972        // Ensure that the buffer is large enough
;;;973        CY_ASSERT(obj->transaction_buffer_size >= header_size);
;;;974        // Check that the address written to is aligned to program page boundary
;;;975        CY_ASSERT(_mtb_kvstore_is_aligned(area_address, prog_size));
;;;976        // The following transactions assume that the buffer size is aligned to the program
;;;977        // size. We do that in init but just to make sure we check it below.
;;;978        CY_ASSERT((obj->transaction_buffer_size % prog_size) == 0);
;;;979    
;;;980        // Setup the area header.
;;;981        _mtb_kvstore_record_header_t record_header;
;;;982        _mtb_kvstore_setup_record_header(key, data, data_size,
;;;983                                         _MTB_KVSTORE_FORMAT_VERSION,
;;;984                                         operation,
;;;985                                         &record_header);
;;;986    
;;;987        // Check that total size does not exceed size of area.
;;;988        uint32_t record_size = _mtb_kvstore_get_record_size(obj, record_address,
;;;989                                                            record_header.key_size,
;;;990                                                            record_header.data_size);
;;;991        CY_ASSERT((offset + record_size) <= _MTB_KVSTORE_AREA_SIZE(obj));
;;;992        CY_UNUSED_PARAMETER(prog_size);
;;;993        CY_UNUSED_PARAMETER(record_size);
;;;994    
;;;995        uint32_t buffer_space_left = obj->transaction_buffer_size;
;;;996        result = _mtb_kvstore_buffered_write(obj, (uint8_t*)&record_header, header_size,
;;;997                                             &record_address,
;;;998                                             &buffer_space_left, false);
;;;999        if (result != CY_RSLT_SUCCESS)
;;;1000       {
;;;1001           return result;
;;;1002       }
;;;1003   
;;;1004       result = _mtb_kvstore_buffered_write(obj, (uint8_t*)key, record_header.key_size,
;;;1005                                            &record_address, &buffer_space_left, false);
;;;1006       if (result != CY_RSLT_SUCCESS)
;;;1007       {
;;;1008           return result;
;;;1009       }
;;;1010   
