;;;2066           }
;;;2067   
;;;2068           ble_gap_disc_complete();
;;;2069   #else
;;;2070           assert(0);
;;;2071   #endif
;;;2072           break;
;;;2073   
;;;2074       default:
;;;2075           BLE_HS_DBG_ASSERT(0);
;;;2076           break;
;;;2077       }
;;;2078   
;;;2079       return BLE_HS_FOREVER;
;;;2080   }
