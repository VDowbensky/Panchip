;;;1583   /**
;;;1584    * Sends notifications or indications for the specified characteristic to all
;;;1585    * connected devices.  The bluetooth spec does not allow more than one
;;;1586    * concurrent indication for a single peer, so this function will hold off on
;;;1587    * sending such indications.
;;;1588    */
