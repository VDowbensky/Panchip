;;;1065   /**
;;;1066     * @brief        Calculate and read the CRC32 checksum of a specified flash area.
;;;1067     * @param[in]    addr     Start address of the flash area to be executed CRC32 checksum calculation.
;;;1068     * @param[in]    count    Number of bytes to be calculated.
;;;1069     * @param[out]   chksum   If success, it will contain the result of CRC32 checksum calculation.
;;;1070     * @retval   0   Success
;;;1071     * @retval   -1  Invalid parameter.
;;;1072     */
;;;1073   int32_t FMC_GetCrc32Sum(FLCTL_T *fmc,uint32_t addr, uint32_t count, uint32_t *chksum)
;;;1074   {
;;;1075   	unsigned char offset =0;
;;;1076   
;;;1077       // TODO:
;;;1078       // There is limitation for flash READ cmd (0x03) used here:
