;;;3661           rc = BLE_HS_EINVAL;
;;;3662           goto done;
;;;3663       }
;;;3664   
;;;3665       ble_hs_lock();
;;;3666   
;;;3667       rc = ble_gap_periodic_adv_set_data_validate(instance, data);
;;;3668       if (rc != 0) {
;;;3669           ble_hs_unlock();
;;;3670           goto done;
;;;3671       }
;;;3672   
;;;3673       rc = ble_gap_periodic_adv_set(instance, &data);
;;;3674   
;;;3675       ble_hs_unlock();
;;;3676   
;;;3677   done:
;;;3678       os_mbuf_free_chain(data);
;;;3679       return rc;
;;;3680   }
