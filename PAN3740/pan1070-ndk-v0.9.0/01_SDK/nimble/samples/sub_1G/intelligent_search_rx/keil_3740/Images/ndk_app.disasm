;;;950    //--------------------------------------------------------------------------------------------------
;;;951    // _mtb_kvstore_write_record
;;;952    //--------------------------------------------------------------------------------------------------
;;;953    static cy_rslt_t _mtb_kvstore_write_record(mtb_kvstore_t* obj,
;;;954                                               uint32_t area_address,
;;;955                                               uint32_t offset,
;;;956                                               const char* key,
;;;957                                               const uint8_t* data,
;;;958                                               uint32_t data_size,
;;;959                                               _mtb_kvstore_operation_t operation,
;;;960                                               const _mtb_kvstore_update_ram_table_info_t* ram_tbl_info,
;;;961                                               const _mtb_kvstore_update_consumed_size_info_t* size_info)
;;;962    {
