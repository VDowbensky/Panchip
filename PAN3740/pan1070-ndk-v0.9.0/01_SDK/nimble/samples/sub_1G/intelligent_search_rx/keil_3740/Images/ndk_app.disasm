;;;982        _mtb_kvstore_setup_record_header(key, data, data_size,
;;;983                                         _MTB_KVSTORE_FORMAT_VERSION,
;;;984                                         operation,
;;;985                                         &record_header);
;;;986    
;;;987        // Check that total size does not exceed size of area.
;;;988        uint32_t record_size = _mtb_kvstore_get_record_size(obj, record_address,
        0x0000c83e:    9206        ..      STR      r2,[sp,#0x18]
        0x0000c840:    4668        hF      MOV      r0,sp
        0x0000c842:    8a00        ..      LDRH     r0,[r0,#0x10]
        0x0000c844:    9008        ..      STR      r0,[sp,#0x20]
;;; ..\..\..\..\component\kv_store\mtb_kvstore.c (361)
        0x0000c846:    68a2        .h      LDR      r2,[r4,#8]
;;;362        return _mtb_kvstore_align_up(sizeof(_mtb_kvstore_record_header_t) + key_size + data_size,
;;;363                                     prog_size);
;;;364    }
