;;;2567       }
;;;2568   
;;;2569       rc = ble_hs_id_use_addr(own_addr_type);
;;;2570       if (rc != 0) {
;;;2571           goto done;
;;;2572       }
;;;2573   
;;;2574       BLE_HS_LOG(INFO, "GAP procedure initiated: advertise; ");
;;;2575       ble_gap_log_adv(own_addr_type, direct_addr, adv_params);
;;;2576       // BLE_HS_LOG(INFO, "\n");
;;;2577   
;;;2578       ble_gap_slave[0].cb = cb;
;;;2579       ble_gap_slave[0].cb_arg = cb_arg;
;;;2580       ble_gap_slave[0].our_addr_type = own_addr_type;
;;;2581   
;;;2582       if (adv_params->conn_mode != BLE_GAP_CONN_MODE_NON) {
