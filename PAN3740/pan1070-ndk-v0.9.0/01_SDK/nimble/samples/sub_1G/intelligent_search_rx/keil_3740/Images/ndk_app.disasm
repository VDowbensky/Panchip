;;;1818   /**
;;;1819    * Processes an incoming connection-complete HCI event.
;;;1820    * instance parameter is valid only for slave connection.
;;;1821    */
;;;1822   int
;;;1823   ble_gap_rx_conn_complete(struct ble_gap_conn_complete *evt, uint8_t instance)
;;;1824   {
;;;1825   #if NIMBLE_BLE_CONNECT
;;;1826       struct ble_gap_event event;
;;;1827       struct ble_hs_conn *conn;
;;;1828       int rc;
;;;1829   
;;;1830       STATS_INC(ble_gap_stats, rx_conn_complete);
;;;1831   
;;;1832       /* in that case *only* status field is valid so we determine role
;;;1833        * based on error code
;;;1834        */
;;;1835       if (evt->status != BLE_ERR_SUCCESS) {
;;;1836           switch (evt->status) {
;;;1837           case BLE_ERR_DIR_ADV_TMO:
;;;1838               /* slave role (HD directed advertising)
;;;1839                *
;;;1840                * with ext advertising this is send from set terminated event
;;;1841                */
;;;1842   #if !MYNEWT_VAL(BLE_EXT_ADV)
;;;1843               if (ble_gap_adv_active()) {
;;;1844                   ble_gap_adv_finished(0, 0, 0, 0);
;;;1845               }
;;;1846   #endif
;;;1847               break;
;;;1848           case BLE_ERR_UNK_CONN_ID:
;;;1849               /* master role */
;;;1850               if (ble_gap_master_in_progress()) {
;;;1851                   /* Connect procedure successfully cancelled. */
;;;1852                   if (ble_gap_master.preempted_op == BLE_GAP_OP_M_CONN) {
;;;1853                       ble_gap_master_failed(BLE_HS_EPREEMPTED);
;;;1854                   } else {
;;;1855                       ble_gap_master_connect_cancelled();
;;;1856                   }
;;;1857               }
;;;1858               break;
;;;1859           default:
;;;1860               /* this should never happen, unless controller is broken */
;;;1861               BLE_HS_LOG(INFO, "controller reported invalid error code in conn"
;;;1862                                "complete event: %u", evt->status);
;;;1863               assert(0);
;;;1864               break;
;;;1865           }
;;;1866           return 0;
;;;1867       }
;;;1868   
;;;1869       /* Apply the event to the existing connection if it exists. */
;;;1870       if (ble_hs_atomic_conn_flags(evt->connection_handle, NULL) == 0) {
;;;1871           /* XXX: Does this ever happen? */
;;;1872           return 0;
;;;1873       }
;;;1874   
;;;1875       /* This event refers to a new connection. */
;;;1876   
;;;1877       switch (evt->role) {
;;;1878       case BLE_HCI_LE_CONN_COMPLETE_ROLE_MASTER:
