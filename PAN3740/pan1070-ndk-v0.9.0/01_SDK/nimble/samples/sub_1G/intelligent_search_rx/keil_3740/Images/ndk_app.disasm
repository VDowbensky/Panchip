;;;4410   int
;;;4411   ble_gap_ext_disc(uint8_t own_addr_type, uint16_t duration, uint16_t period,
;;;4412                    uint8_t filter_duplicates, uint8_t filter_policy,
;;;4413                    uint8_t limited,
;;;4414                    const struct ble_gap_ext_disc_params *uncoded_params,
;;;4415                    const struct ble_gap_ext_disc_params *coded_params,
;;;4416                    ble_gap_event_fn *cb, void *cb_arg)
;;;4417   {
;;;4418   #if NIMBLE_BLE_SCAN && MYNEWT_VAL(BLE_EXT_ADV)
;;;4419       struct ble_hs_hci_ext_scan_param ucp;
;;;4420       struct ble_hs_hci_ext_scan_param cp;
;;;4421       int rc;
;;;4422   
;;;4423       STATS_INC(ble_gap_stats, discover);
;;;4424   
;;;4425       ble_hs_lock();
;;;4426   
;;;4427       rc = ble_gap_disc_ext_validate(own_addr_type);
;;;4428       if (rc != 0) {
;;;4429           goto done;
;;;4430       }
;;;4431   
;;;4432       /* Make a copy of the parameter structure and fill unspecified values with
;;;4433        * defaults.
;;;4434        */
;;;4435   
;;;4436       if (uncoded_params) {
;;;4437           ble_gap_ext_scan_params_to_hci(uncoded_params, &ucp);
;;;4438           ble_gap_ext_disc_fill_dflts(limited, &ucp);
;;;4439   
;;;4440           /* XXX: We should do it only once */
;;;4441           if (!uncoded_params->passive) {
;;;4442               rc = ble_hs_id_use_addr(own_addr_type);
;;;4443               if (rc != 0) {
;;;4444                   goto done;
;;;4445               }
;;;4446           }
;;;4447       }
;;;4448   
;;;4449       if (coded_params) {
;;;4450           ble_gap_ext_scan_params_to_hci(coded_params, &cp);
;;;4451           ble_gap_ext_disc_fill_dflts(limited, &cp);
;;;4452   
;;;4453           /* XXX: We should do it only once */
;;;4454           if (!coded_params->passive) {
;;;4455               rc = ble_hs_id_use_addr(own_addr_type);
;;;4456               if (rc != 0) {
;;;4457                   goto done;
;;;4458               }
;;;4459           }
;;;4460       }
;;;4461   
;;;4462       ble_gap_master.disc.limited = limited;
;;;4463       ble_gap_master.cb = cb;
;;;4464       ble_gap_master.cb_arg = cb_arg;
;;;4465   
;;;4466       rc = ble_gap_ext_disc_tx_params(own_addr_type, filter_policy,
;;;4467                                       uncoded_params ? &ucp : NULL,
;;;4468                                       coded_params ? &cp : NULL);
;;;4469       if (rc != 0) {
;;;4470           goto done;
;;;4471       }
;;;4472   
;;;4473       ble_gap_master.op = BLE_GAP_OP_M_DISC;
;;;4474   
;;;4475       rc = ble_gap_ext_disc_enable_tx(1, filter_duplicates, duration, period);
;;;4476       if (rc != 0) {
;;;4477           ble_gap_master_reset_state();
;;;4478           goto done;
;;;4479       }
;;;4480   
;;;4481       rc = 0;
;;;4482   
;;;4483   done:
;;;4484       ble_hs_unlock();
;;;4485   
;;;4486       if (rc != 0) {
;;;4487           STATS_INC(ble_gap_stats, discover_fail);
;;;4488       }
;;;4489       return rc;
;;;4490   #else
;;;4491       return BLE_HS_ENOTSUP;
;;;4492   #endif
;;;4493   }
;;;4494   
;;;4495   #if NIMBLE_BLE_SCAN && !MYNEWT_VAL(BLE_EXT_ADV)
;;;4496   static void
;;;4497   ble_gap_disc_fill_dflts(struct ble_gap_disc_params *disc_params)
;;;4498   {
;;;4499      if (disc_params->itvl == 0) {
;;;4500           if (disc_params->limited) {
;;;4501               disc_params->itvl = BLE_GAP_LIM_DISC_SCAN_INT;
