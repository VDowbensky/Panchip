;;;601    //--------------------------------------------------------------------------------------------------
;;;602    // _mtb_kvstore_validate_key
;;;603    //--------------------------------------------------------------------------------------------------
;;;604    static cy_rslt_t _mtb_kvstore_validate_key(mtb_kvstore_t* obj, uint32_t key_addr,
;;;605                                               const char* user_key, uint32_t key_size)
;;;606    {
;;;607        CY_ASSERT(obj != NULL);
;;;608    
;;;609        if (strlen(user_key) != key_size)
;;;610        {
;;;611            return MTB_KVSTORE_ITEM_NOT_FOUND_ERROR;
;;;612        }
;;;613    
;;;614        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;615        uint32_t remaining_size = key_size;
;;;616        while (remaining_size > 0)
;;;617        {
;;;618            uint32_t transfer_size =
;;;619                (obj->transaction_buffer_size >=
;;;620                 remaining_size) ? remaining_size : obj->transaction_buffer_size;
;;;621            result = obj->bd->read(obj->bd->context, key_addr, transfer_size, obj->transaction_buffer);
;;;622            if (result != CY_RSLT_SUCCESS)
;;;623            {
;;;624                return result;
;;;625            }
;;;626    
;;;627            if (memcmp((uint8_t*)user_key, obj->transaction_buffer, transfer_size) != 0)
;;;628            {
;;;629                return MTB_KVSTORE_ITEM_NOT_FOUND_ERROR;
;;;630            }
;;;631    
;;;632            key_addr += transfer_size;
;;;633            remaining_size -= transfer_size;
;;;634        }
;;;635    
;;;636        return result;
;;;637    }
