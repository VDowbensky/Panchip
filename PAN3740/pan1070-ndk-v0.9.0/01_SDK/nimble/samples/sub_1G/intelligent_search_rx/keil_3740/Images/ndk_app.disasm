;;;945        prev = NULL;
;;;946        proc = STAILQ_FIRST(&ble_gattc_procs);
;;;947        while (proc != NULL) {
;;;948            next = STAILQ_NEXT(proc, next);
;;;949    
;;;950            if (cb(proc, arg)) {
;;;951                if (prev == NULL) {
;;;952                    STAILQ_REMOVE_HEAD(&ble_gattc_procs, next);
;;;953                } else {
;;;954                    STAILQ_REMOVE_AFTER(&ble_gattc_procs, prev, next);
;;;955                }
;;;956                STAILQ_INSERT_TAIL(dst_list, proc, next);
;;;957    
;;;958                if (max_procs > 0) {
