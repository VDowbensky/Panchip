;;;103    /**
;;;104     * @brief Get Size of Flash Code Area in Bytes
;;;105     * @param fmc Flash memory controller base
;;;106     * @note There are 2 hw defined areas for pan1070 flash: Code Area and Info Area.
;;;107     *       The Info Area is fixed to 4K Bytes, and all remained flash belongs to
;;;108     *       the Code Area. Commonly and as default we can only access the Code Area
;;;109     *       from address 0 to CodeAreaSize-1, and we can access the Info Area (from
;;;110     *       address 0 to 4095) using special access API introduces later.
;;;111     * @return Size in bytes
;;;112     */
;;;113    uint32_t FMC_GetFlashCodeAreaSize(FLCTL_T *fmc)
;;;114    {
;;;115        if (flash_ids.memory_density_id == 0)
;;;116        {
;;;117            FMC_GetFlashJedecId(fmc);
;;;118        }
;;;119        return BIT(flash_ids.memory_density_id) - SECTOR_SIZE;
;;;120    }
