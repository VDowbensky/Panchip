;;;3758       if (addr && (addr->type > BLE_ADDR_RANDOM)) {
;;;3759           return BLE_HS_EINVAL;
;;;3760       }
;;;3761       if (adv_sid > 0x0f) {
;;;3762           return BLE_HS_EINVAL;
