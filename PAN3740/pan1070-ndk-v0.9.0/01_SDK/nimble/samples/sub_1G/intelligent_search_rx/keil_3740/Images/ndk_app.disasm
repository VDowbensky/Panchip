;;;989            rp.cur_authenticated = bond.authenticated;
;;;990            rp.cur_sc = bond.sc;
;;;991    
;;;992            rp.new_key_size = key_size;
;;;993            rp.new_authenticated = !!(proc_flags & BLE_SM_PROC_F_AUTHENTICATED);
;;;994            rp.new_sc = !!(proc_flags & BLE_SM_PROC_F_SC);
;;;995            rp.new_bonding = !!(proc_flags & BLE_SM_PROC_F_BONDING);
;;;996    
;;;997            rc = ble_gap_repeat_pairing_event(&rp);
;;;998        } while (rc == BLE_GAP_REPEAT_PAIRING_RETRY);
