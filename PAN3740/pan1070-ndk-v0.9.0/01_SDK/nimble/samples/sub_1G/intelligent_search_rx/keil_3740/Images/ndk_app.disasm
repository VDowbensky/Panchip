;;;888            goto done;
;;;889        }
;;;890    
;;;891        /* Write the variable length Information Data field, populating the format
;;;892         * field as appropriate.
;;;893         */
;;;894        mtu = ble_att_mtu(conn_handle);
;;;895        rc = ble_att_svr_fill_info(start_handle, end_handle, txom, mtu,
;;;896                                   &rsp->bafp_format);
