;;;1725   void
;;;1726   ble_gap_rx_periodic_adv_sync_transfer(const struct ble_hci_ev_le_subev_periodic_adv_sync_transfer *ev)
;;;1727   {
;;;1728       struct ble_hci_le_periodic_adv_term_sync_cp cmd_term;
;;;1729       struct ble_gap_event event;
;;;1730       struct ble_hs_conn *conn;
