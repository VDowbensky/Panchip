;;;133    void sys_clock_Init(void)
;;;134    {
;;;135        /* Unlock protected registers */
;;;136        SYS_UnlockReg();
;;;137    
;;;138        ANA->LP_FSYN_LDO |= 0X1;
;;;139    
;;;140        CLK_XthStartupConfig();
;;;141        CLK->XTH_CTRL |= CLK_XTHCTL_XTH_EN_Msk;
;;;142        CLK_WaitClockReady(CLK_SYS_SRCSEL_XTH);
;;;143    
;;;144    #if (CONFIG_SYSTEM_CLOCK == 32)
;;;145        CLK_HCLKConfig(1);
;;;146        CLK_SYSCLKConfig(CLK_DPLL_REF_CLKSEL_XTH, CLK_DPLL_OUT_64M);
;;;147    #elif (CONFIG_SYSTEM_CLOCK == 48)
;;;148        CLK_HCLKConfig(0);
;;;149        CLK_SYSCLKConfig(CLK_DPLL_REF_CLKSEL_XTH, CLK_DPLL_OUT_48M);
;;;150    #endif
;;;151        CLK_RefClkSrcConfig(CLK_SYS_SRCSEL_DPLL);
;;;152    
;;;153        CLK->RCH_CTRL &= ~BIT(0);
;;;154    
;;;155        CLK_PCLK1Config(CONFIG_APB1_CLOCK_DIVISOR >> 1);
;;;156        CLK_PCLK2Config(CONFIG_APB2_CLOCK_DIVISOR >> 1);
;;;157        /*
;;;158         * Note that all clocks on APB are disabled by default after SoC power up, and
;;;159         * the default AHB clocks enabled after SoC power up are:
;;;160         * ACC/eFuse/ROM/RCC_AHB/Systick/GPIO.
;;;161         * Here we disable ACC, eFuse and ROM clock as these modules are not commonly
;;;162         * used. We should re-enabled them once we use later.
;;;163         * Here We also enable APB1 and APB2 clock path to make sure modules on APB can
;;;164         * be easily enabled by each peripheral driver by enabling their clock enable
;;;165         * bits on APB bus.
;;;166         */
;;;167        CLK_AHBPeriphClockCmd(CLK_AHBPeriph_ROM, DISABLE);
;;;168        CLK_AHBPeriphClockCmd(CLK_AHBPeriph_APB1 | CLK_AHBPeriph_APB2, ENABLE);
;;;169    
;;;170        /*Basic clock for BLE*/
;;;171        CLK_AHBPeriphClockCmd(CLK_AHBPeriph_BLE_32M | CLK_AHBPeriph_BLE_32K, ENABLE);
;;;172    
;;;173        CLK_AHBPeriphClockCmd(CLK_AHBPeriph_USB_AHB | CLK_AHBPeriph_USB_48M, DISABLE);
;;;174    }
