;;;3030               }
;;;3031               break;
;;;3032           default:
;;;3033               break;
;;;3034           }
;;;3035       }
;;;3036   
;;;3037       opcode = BLE_HCI_OP(BLE_HCI_OGF_LE, BLE_HCI_OCF_LE_SET_EXT_ADV_ENABLE);
