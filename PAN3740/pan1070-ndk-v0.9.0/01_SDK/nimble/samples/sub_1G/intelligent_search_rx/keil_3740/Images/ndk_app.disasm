;;;966    
;;;967        // Calculate write size
;;;968        uint32_t record_address = area_address + offset;
;;;969        size_t header_size = sizeof(_mtb_kvstore_record_header_t);
;;;970        uint32_t prog_size = obj->bd->program_size(obj->bd->context, record_address);
;;;971    
;;;972        // Ensure that the buffer is large enough
;;;973        CY_ASSERT(obj->transaction_buffer_size >= header_size);
;;;974        // Check that the address written to is aligned to program page boundary
;;;975        CY_ASSERT(_mtb_kvstore_is_aligned(area_address, prog_size));
;;;976        // The following transactions assume that the buffer size is aligned to the program
;;;977        // size. We do that in init but just to make sure we check it below.
