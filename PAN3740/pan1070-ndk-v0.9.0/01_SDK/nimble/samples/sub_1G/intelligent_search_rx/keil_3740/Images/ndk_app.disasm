;;;423    //--------------------------------------------------------------------------------------------------
;;;424    // _mtb_kvstore_update_ram_table
;;;425    //--------------------------------------------------------------------------------------------------
;;;426    static void _mtb_kvstore_update_ram_table(mtb_kvstore_t* obj, _mtb_kvstore_operation_t operation,
;;;427                                              const _mtb_kvstore_update_ram_table_info_t* info)
;;;428    {
;;;429        switch (operation)
;;;430        {
;;;431            case _MTB_KVSTORE_OPER_DELETE:
;;;432                CY_ASSERT(info->ram_tbl_idx < obj->num_entries);
;;;433                obj->num_entries--;
;;;434                if (info->ram_tbl_idx < obj->num_entries)
;;;435                {
;;;436                    memmove(&obj->ram_table[info->ram_tbl_idx], &obj->ram_table[info->ram_tbl_idx + 1],
;;;437                            (obj->num_entries - info->ram_tbl_idx) *
;;;438                            sizeof(mtb_kvstore_ram_table_entry_t));
;;;439                }
;;;440                break;
;;;441    
;;;442            case _MTB_KVSTORE_OPER_ADD:
;;;443                CY_ASSERT(obj->num_entries < obj->max_entries);
;;;444                CY_ASSERT(info->ram_tbl_idx <= obj->num_entries);
;;;445                if (info->ram_tbl_idx < obj->num_entries)
;;;446                {
;;;447                    memmove(&obj->ram_table[info->ram_tbl_idx + 1], &obj->ram_table[info->ram_tbl_idx],
;;;448                            (obj->num_entries - info->ram_tbl_idx) *
;;;449                            sizeof(mtb_kvstore_ram_table_entry_t));
;;;450                }
;;;451                obj->num_entries++;
;;;452                obj->ram_table[info->ram_tbl_idx].hash = info->entry.hash;
;;;453                obj->ram_table[info->ram_tbl_idx].offset = info->entry.offset;
;;;454                break;
;;;455    
;;;456            case _MTB_KVSTORE_OPER_UPDATE:
;;;457                obj->ram_table[info->ram_tbl_idx].hash = info->entry.hash;
;;;458                obj->ram_table[info->ram_tbl_idx].offset = info->entry.offset;
;;;459                break;
;;;460    
;;;461            default:
;;;462                CY_ASSERT(false);
;;;463        }
;;;464    }
