        0x0000c848:    9907        ..      LDR      r1,[sp,#0x1c]
;;; ..\..\..\..\component\kv_store\mtb_kvstore.c (361)
        0x0000c84a:    6990        .i      LDR      r0,[r2,#0x18]
        0x0000c84c:    6912        .i      LDR      r2,[r2,#0x10]
        0x0000c84e:    9f05        ..      LDR      r7,[sp,#0x14]
        0x0000c850:    4790        .G      BLX      r2
        0x0000c852:    4601        .F      MOV      r1,r0
