;;;3749   ble_gap_periodic_adv_sync_create(const ble_addr_t *addr, uint8_t adv_sid,
;;;3750                                    const struct ble_gap_periodic_sync_params *params,
;;;3751                                    ble_gap_event_fn *cb, void *cb_arg)
;;;3752   {
