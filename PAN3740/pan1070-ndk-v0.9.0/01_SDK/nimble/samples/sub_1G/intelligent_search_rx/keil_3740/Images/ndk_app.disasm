;;;521    //--------------------------------------------------------------------------------------------------
;;;522    // _mtb_kvstore_get_header_crc
;;;523    //--------------------------------------------------------------------------------------------------
;;;524    static uint16_t _mtb_kvstore_get_header_crc(_mtb_kvstore_record_header_t* record_header,
;;;525                                                uint16_t init_crc)
;;;526    {
;;;527        uint16_t crc = init_crc;
;;;528    
;;;529        // Compute CRC for header
;;;530        crc = _mtb_kvstore_crc16((uint8_t*)&record_header->magic, sizeof(record_header->magic), crc);
;;;531        crc =
;;;532            _mtb_kvstore_crc16((uint8_t*)&record_header->format_version,
;;;533                               sizeof(record_header->format_version), crc);
;;;534        crc = _mtb_kvstore_crc16((uint8_t*)&record_header->flags, sizeof(record_header->flags), crc);
;;;535        crc =
;;;536            _mtb_kvstore_crc16((uint8_t*)&record_header->header_size,
;;;537                               sizeof(record_header->header_size),
;;;538                               crc);
;;;539        crc = _mtb_kvstore_crc16((uint8_t*)&record_header->key_size, sizeof(record_header->key_size),
;;;540                                 crc);
;;;541        crc = _mtb_kvstore_crc16((uint8_t*)&record_header->data_size, sizeof(record_header->data_size),
;;;542                                 crc);
;;;543    
;;;544        return crc;
;;;545    }
