;;;1858   static void
;;;1859   ble_sm_pair_req_rx(uint16_t conn_handle, struct os_mbuf **om,
;;;1860                      struct ble_sm_result *res)
;;;1861   {
;;;1862       struct ble_sm_pair_cmd *req;
;;;1863       struct ble_sm_proc *proc;
;;;1864       struct ble_sm_proc *prev;
;;;1865       struct ble_hs_conn *conn;
;;;1866       ble_sm_proc_flags proc_flags;
;;;1867       uint8_t key_size;
