;;;796        case 0:
;;;797            return 0;
;;;798    
;;;799        case BLE_HS_ENOMEM:
;;;800            ble_gattc_proc_set_resume_timer(proc);
;;;801            return 0;
;;;802    
;;;803        default:
;;;804            return status;
;;;805        }
;;;806    }
