;;;767    //--------------------------------------------------------------------------------------------------
;;;768    // _mtb_kvstore_read_partial_record
;;;769    //--------------------------------------------------------------------------------------------------
;;;770    static cy_rslt_t _mtb_kvstore_read_partial_record(mtb_kvstore_t* obj,
;;;771                                                      uint32_t area_address,
;;;772                                                      uint32_t offset,
;;;773                                                      _mtb_kvstore_record_header_t* record_header,
;;;774                                                      const char* key,
;;;775                                                      bool validate_key,
;;;776                                                      uint8_t* data,
;;;777                                                      uint32_t* data_size,
;;;778                                                      const uint32_t offset_bytes)
;;;779    {
;;;780        CY_ASSERT(obj != NULL);
;;;781        cy_rslt_t result = CY_RSLT_SUCCESS;
;;;782    
;;;783        uint32_t record_start_addr = area_address + offset;
;;;784        uint8_t header_size = sizeof(_mtb_kvstore_record_header_t);
;;;785    
;;;786        CY_ASSERT(record_header != NULL);
;;;787    
;;;788        // Read header for the record
;;;789        result =
;;;790            obj->bd->read(obj->bd->context, record_start_addr, header_size, (uint8_t*)record_header);
;;;791        if (result != CY_RSLT_SUCCESS)
;;;792        {
;;;793            return result;
;;;794        }
;;;795    
;;;796        // Improper use case: reading after the value ended
;;;797        if (offset_bytes > record_header->data_size)
;;;798        {
;;;799            return MTB_KVSTORE_BAD_PARAM_ERROR;
;;;800        }
;;;801    
;;;802        if ((record_header->magic == 0xFFFFFFFFU) || (record_header->magic == 0U))
;;;803        {
;;;804            return MTB_KVSTORE_ERASED_DATA_ERROR;
;;;805        }
;;;806    
;;;807        if (record_header->magic != _MTB_KVSTORE_HEADER_MAGIC)
;;;808        {
;;;809            return MTB_KVSTORE_INVALID_DATA_ERROR;
;;;810        }
;;;811    
;;;812        if ((record_header->key_size == 0U) || (record_header->key_size >= MTB_KVSTORE_MAX_KEY_SIZE))
;;;813        {
;;;814            return MTB_KVSTORE_INVALID_DATA_ERROR;
;;;815        }
;;;816    
;;;817        // Copy key into the provided key area
;;;818        uint32_t key_addr = record_start_addr + record_header->header_size;
;;;819        if (key != NULL)
;;;820        {
;;;821            if (validate_key)
;;;822            {
;;;823                result = _mtb_kvstore_validate_key(obj, key_addr, key, record_header->key_size);
;;;824                if (result != CY_RSLT_SUCCESS)
;;;825                {
;;;826                    return result;
;;;827                }
;;;828            }
;;;829            else
;;;830            {
;;;831                result = obj->bd->read(obj->bd->context, key_addr, record_header->key_size,
;;;832                                       (uint8_t*)key);
;;;833                if (result != CY_RSLT_SUCCESS)
;;;834                {
;;;835                    return result;
;;;836                }
;;;837            }
;;;838        }
;;;839    
;;;840        uint32_t data_addr = key_addr + record_header->key_size;
;;;841        if ((data != NULL) && (data_size != NULL))
;;;842        {
;;;843            // Don't read past the value in memory
;;;844            if (*data_size > (record_header->data_size - offset_bytes))
;;;845            {
;;;846                *data_size = (record_header->data_size - offset_bytes);
;;;847            }
;;;848    
;;;849            // Copy data into the data buffer provided
;;;850            result = obj->bd->read(obj->bd->context, (data_addr + offset_bytes), *data_size, data);
;;;851            if (result != CY_RSLT_SUCCESS)
;;;852            {
;;;853                return result;
;;;854            }
;;;855        }
;;;856    
;;;857        if (data_size != NULL)
;;;858        {
;;;859            *data_size = record_header->data_size;
;;;860        }
;;;861    
;;;862        return result;
;;;863    }
