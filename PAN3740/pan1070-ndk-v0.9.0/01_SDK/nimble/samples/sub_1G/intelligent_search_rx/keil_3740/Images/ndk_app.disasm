;;;1203       rc = ble_att_svr_fill_type_value(conn_handle, start_handle, end_handle,
;;;1204                                        attr_type, *rxom, txom, mtu,
;;;1205                                        out_att_err);
;;;1206       if (rc != 0) {
;;;1207           goto done;
;;;1208       }
;;;1209   
;;;1210       rc = 0;
;;;1211   
;;;1212   done:
;;;1213       *out_txom = txom;
;;;1214       return rc;
;;;1215   }
