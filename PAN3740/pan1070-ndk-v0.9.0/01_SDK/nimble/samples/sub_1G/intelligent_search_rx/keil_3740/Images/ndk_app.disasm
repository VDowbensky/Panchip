;;;1837   static bool
;;;1838   ble_sm_verify_auth_requirements(uint8_t cmd)
;;;1839   {
;;;1840       /* For now we check only SC only mode. I.e.: when remote indicates
;;;1841        * to not support SC pairing, let us make sure legacy pairing is supported
;;;1842        * on our side. If not, we can fail right away.
;;;1843        */
