;;;787     * Processes the return code that results from an attempt to resume a
;;;788     * procedure.  If the resume attempt failed due to memory exhaustion at a lower
;;;789     * layer, the procedure is marked as stalled but still in progress.  Otherwise,
;;;790     * the resume error code is unmodified.
;;;791     */
;;;792    static int
;;;793    ble_gattc_process_resume_status(struct ble_gattc_proc *proc, int status)
;;;794    {
;;;795        switch (status) {
;;;796        case 0:
;;;797            return 0;
;;;798    
;;;799        case BLE_HS_ENOMEM:
;;;800            ble_gattc_proc_set_resume_timer(proc);
;;;801            return 0;
;;;802    
;;;803        default:
;;;804            return status;
;;;805        }
;;;806    }
