;;;1290               call_cb = 0;
;;;1291           } else {
;;;1292               call_cb = 1;
;;;1293               cb_status = rc;
;;;1294           }
;;;1295       } else {
;;;1296           call_cb = 1;
;;;1297           cb_status = BLE_HS_HCI_ERR(ev->status);
;;;1298       }
;;;1299   
;;;1300       if (call_cb) {
;;;1301           ble_gap_update_notify(conn_handle, cb_status);
;;;1302       }
;;;1303   #endif
