;;;3543   static int
;;;3544   ble_gap_periodic_adv_set(uint8_t instance, struct os_mbuf **data)
;;;3545   {
;;;3546       /* In that case we always fit all data in single HCI command */
;;;3547   #if MYNEWT_VAL(BLE_EXT_ADV_MAX_SIZE) <= BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN
;;;3548       static uint8_t buf[sizeof(struct ble_hci_le_set_periodic_adv_data_cp) +
;;;3549                          MYNEWT_VAL(BLE_EXT_ADV_MAX_SIZE)];
;;;3550       struct ble_hci_le_set_periodic_adv_data_cp *cmd = (void *) buf;
;;;3551       uint16_t len = OS_MBUF_PKTLEN(*data);
;;;3552       uint16_t opcode;
;;;3553   
;;;3554       opcode = BLE_HCI_OP(BLE_HCI_OGF_LE, BLE_HCI_OCF_LE_SET_PERIODIC_ADV_DATA);
;;;3555   
;;;3556       cmd->adv_handle = instance;
;;;3557       cmd->operation = BLE_HCI_LE_SET_DATA_OPER_COMPLETE;
;;;3558       cmd->adv_data_len = len;
;;;3559       os_mbuf_copydata(*data, 0, len, cmd->adv_data);
;;;3560   
;;;3561       os_mbuf_adj(*data, len);
;;;3562       *data = os_mbuf_trim_front(*data);
;;;3563   
;;;3564       return ble_hs_hci_cmd_tx(opcode, cmd, sizeof(*cmd) + cmd->adv_data_len,
;;;3565                                NULL, 0);
;;;3566   #else
;;;3567       static uint8_t buf[sizeof(struct ble_hci_le_set_periodic_adv_data_cp) +
;;;3568                          BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN];
;;;3569       struct ble_hci_le_set_periodic_adv_data_cp *cmd = (void *) buf;
;;;3570       uint16_t len = OS_MBUF_PKTLEN(*data);
;;;3571       uint16_t opcode;
;;;3572       uint8_t op;
;;;3573       int rc;
;;;3574   
;;;3575       opcode = BLE_HCI_OP(BLE_HCI_OGF_LE, BLE_HCI_OCF_LE_SET_PERIODIC_ADV_DATA);
;;;3576       cmd->adv_handle = instance;
;;;3577   
;;;3578       /* Complete data */
;;;3579       if (len <= BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN) {
;;;3580           cmd->operation = BLE_HCI_LE_SET_DATA_OPER_COMPLETE;
;;;3581           cmd->adv_data_len = len;
;;;3582           os_mbuf_copydata(*data, 0, len, cmd->adv_data);
;;;3583   
;;;3584           os_mbuf_adj(*data, len);
;;;3585           *data = os_mbuf_trim_front(*data);
;;;3586   
;;;3587           return ble_hs_hci_cmd_tx(opcode, cmd, sizeof(*cmd) + cmd->adv_data_len,
;;;3588                                    NULL, 0);
;;;3589       }
;;;3590   
;;;3591       /* If the periodic advertising is already enabled, the periodic advertising
;;;3592        * the op code shall be nothing but 0x03
;;;3593        * Bluetooth Core Specification, section 7.8.62
;;;3594        */
;;;3595       if (ble_gap_slave[instance].periodic_op == BLE_GAP_OP_S_PERIODIC_ADV) {
;;;3596           return BLE_HS_EINVAL;
;;;3597       }
;;;3598   
;;;3599       /* First fragment  */
;;;3600       op = BLE_HCI_LE_SET_DATA_OPER_FIRST;
;;;3601   
;;;3602       do{
;;;3603           cmd->operation = op;
;;;3604           cmd->adv_data_len = BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN;
;;;3605           os_mbuf_copydata(*data, 0, BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN,
;;;3606                            cmd->adv_data);
;;;3607   
;;;3608           os_mbuf_adj(*data, BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN);
;;;3609           *data = os_mbuf_trim_front(*data);
;;;3610   
;;;3611           rc = ble_hs_hci_cmd_tx(opcode, cmd, sizeof(*cmd) + cmd->adv_data_len,
;;;3612                                  NULL, 0);
;;;3613           if (rc) {
;;;3614               return rc;
;;;3615           }
;;;3616   
;;;3617           len -= BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN;
;;;3618           op = BLE_HCI_LE_SET_DATA_OPER_INT;
;;;3619       } while (len > BLE_HCI_MAX_PERIODIC_ADV_DATA_LEN);
;;;3620   
;;;3621       /* Last fragment */
;;;3622       cmd->operation = BLE_HCI_LE_SET_DATA_OPER_LAST;
;;;3623       cmd->adv_data_len = len;
;;;3624       os_mbuf_copydata(*data, 0, len, cmd->adv_data);
;;;3625   
;;;3626       os_mbuf_adj(*data, len);
;;;3627       *data = os_mbuf_trim_front(*data);
;;;3628   
;;;3629       return ble_hs_hci_cmd_tx(opcode, cmd, sizeof(*cmd) + cmd->adv_data_len,
;;;3630                                NULL, 0);
;;;3631   #endif
;;;3632   }
