;;;1567                                   ? 0
;;;1568                                   : _mtb_kvstore_get_record_size(obj, obj->active_area_addr,
;;;1569                                                                  strlen(key),
;;;1570                                                                  old_record_data_size);
;;;1571   
;;;1572       if (((operation == _MTB_KVSTORE_OPER_UPDATE) || (operation == _MTB_KVSTORE_OPER_ADD)) &&
        0x0000c9f0:    2e02        ..      CMP      r6,#2
