;;;4908   ble_gap_ext_connect(uint8_t own_addr_type, const ble_addr_t *peer_addr,
;;;4909                   int32_t duration_ms, uint8_t phy_mask,
;;;4910                   const struct ble_gap_conn_params *phy_1m_conn_params,
;;;4911                   const struct ble_gap_conn_params *phy_2m_conn_params,
;;;4912                   const struct ble_gap_conn_params *phy_coded_conn_params,
;;;4913                   ble_gap_event_fn *cb, void *cb_arg)
;;;4914   {
