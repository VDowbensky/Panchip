;;;1873   int
;;;1874   ble_att_svr_rx_read_group_type(uint16_t conn_handle, struct os_mbuf **rxom)
;;;1875   {
;;;1876   #if !MYNEWT_VAL(BLE_ATT_SVR_READ_GROUP_TYPE)
