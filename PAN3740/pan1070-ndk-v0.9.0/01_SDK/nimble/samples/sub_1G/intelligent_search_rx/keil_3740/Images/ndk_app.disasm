;;;2557   
;;;2558       /* Remove timed-out procedures from the main list and insert them into a
;;;2559        * temporary list.  This function also calculates the number of ticks until
;;;2560        * the next expiration will occur.
;;;2561        */
;;;2562       ticks_until_exp = ble_sm_extract_expired(&exp_list);
;;;2563   
;;;2564       /* Notify application of each failure and free the corresponding procedure
;;;2565        * object.
;;;2566        * XXX: Mark connection as tainted; don't allow any subsequent SMP
;;;2567        * procedures without reconnect.
;;;2568        */
;;;2569       while ((proc = STAILQ_FIRST(&exp_list)) != NULL) {
;;;2570           ble_gap_enc_event(proc->conn_handle, BLE_HS_ETIMEOUT, 0, 0);
;;;2571   
;;;2572           STAILQ_REMOVE_HEAD(&exp_list, next);
;;;2573           ble_sm_proc_free(proc);
;;;2574       }
;;;2575   
;;;2576       return ticks_until_exp;
;;;2577   }
