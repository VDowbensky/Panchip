;;;1487            * failure if a FreeRTOS API function is called from an interrupt that has
;;;1488            * been assigned a priority above the configured maximum system call
;;;1489            * priority.  Only FreeRTOS functions that end in FromISR can be called
;;;1490            * from interrupts  that have been assigned a priority at or (logically)
;;;1491            * below the maximum system call interrupt priority.  FreeRTOS maintains a
;;;1492            * separate interrupt safe API to ensure interrupt entry is as fast and as
;;;1493            * simple as possible.  More information (albeit Cortex-M specific) is
;;;1494            * provided on the following link:
;;;1495            * https://www.FreeRTOS.org/RTOS-Cortex-M3-M4.html */
;;;1496           portASSERT_IF_INTERRUPT_PRIORITY_INVALID();
;;;1497   
;;;1498           uxSavedInterruptState = portSET_INTERRUPT_MASK_FROM_ISR();
;;;1499           {
;;;1500               /* If null is passed in here then it is the priority of the calling
;;;1501                * task that is being queried. */
;;;1502               pxTCB = prvGetTCBFromHandle( xTask );
;;;1503               uxReturn = pxTCB->uxPriority;
;;;1504           }
;;;1505           portCLEAR_INTERRUPT_MASK_FROM_ISR( uxSavedInterruptState );
;;;1506   
;;;1507           return uxReturn;
;;;1508       }
