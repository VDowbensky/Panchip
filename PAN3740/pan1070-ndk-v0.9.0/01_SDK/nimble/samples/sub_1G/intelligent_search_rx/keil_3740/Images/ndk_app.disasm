;;;928    static void
;;;929    ble_gattc_extract(ble_gattc_match_fn *cb, void *arg, int max_procs,
;;;930                      struct ble_gattc_proc_list *dst_list)
;;;931    {
;;;932        struct ble_gattc_proc *proc;
;;;933        struct ble_gattc_proc *prev;
;;;934        struct ble_gattc_proc *next;
;;;935        int num_extracted;
;;;936    
;;;937        /* Only the parent task is allowed to remove entries from the list. */
;;;938        BLE_HS_DBG_ASSERT(ble_hs_is_parent_task());
;;;939    
;;;940        STAILQ_INIT(dst_list);
;;;941        num_extracted = 0;
;;;942    
;;;943        ble_hs_lock();
;;;944    
;;;945        prev = NULL;
;;;946        proc = STAILQ_FIRST(&ble_gattc_procs);
;;;947        while (proc != NULL) {
;;;948            next = STAILQ_NEXT(proc, next);
;;;949    
;;;950            if (cb(proc, arg)) {
;;;951                if (prev == NULL) {
;;;952                    STAILQ_REMOVE_HEAD(&ble_gattc_procs, next);
;;;953                } else {
;;;954                    STAILQ_REMOVE_AFTER(&ble_gattc_procs, prev, next);
;;;955                }
;;;956                STAILQ_INSERT_TAIL(dst_list, proc, next);
;;;957    
;;;958                if (max_procs > 0) {
;;;959                    num_extracted++;
;;;960                    if (num_extracted >= max_procs) {
;;;961                        break;
;;;962                    }
;;;963                }
;;;964            } else {
;;;965                prev = proc;
;;;966            }
;;;967    
;;;968            proc = next;
;;;969        }
;;;970    
;;;971        ble_hs_unlock();
;;;972    }
