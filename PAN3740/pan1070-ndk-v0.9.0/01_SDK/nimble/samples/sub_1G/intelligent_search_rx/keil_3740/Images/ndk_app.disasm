        0x0000c858:    19c0        ..      ADDS     r0,r0,r7
        0x0000c85a:    3013        .0      ADDS     r0,r0,#0x13
        0x0000c85c:    f7f3fc74    ..t.    BL       __aeabi_uidiv ; 0x148
        0x0000c860:    9900        ..      LDR      r1,[sp,#0]
        0x0000c862:    1c40        @.      ADDS     r0,r0,#1
        0x0000c864:    4348        HC      MULS     r0,r1,r0
;;;363                                     prog_size);
