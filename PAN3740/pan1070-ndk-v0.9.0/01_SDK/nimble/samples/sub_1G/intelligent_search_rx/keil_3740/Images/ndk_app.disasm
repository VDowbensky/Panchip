;;;306    static void find_special_chunk_in_range(size_t chunk_pattern, uint32_t range_start_sector_idx, uint16_t range_sector_num,
;;;307                                            uint32_t *chunk_start_sector_idx, uint16_t *chunk_sector_num)
;;;308    {
