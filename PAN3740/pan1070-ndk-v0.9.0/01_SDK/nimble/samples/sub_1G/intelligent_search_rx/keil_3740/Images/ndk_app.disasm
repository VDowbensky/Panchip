;;;380    // _mtb_kvstore_increment_max_keys
;;;381    //--------------------------------------------------------------------------------------------------
;;;382    uint16_t _mtb_kvstore_crc16(const uint8_t* data, uint32_t length, uint16_t init_crc)
;;;383    {
;;;384        //Using CRC-16/CCITT-0 Algorithm
;;;385        uint32_t crc = init_crc;
;;;386        int i;
;;;387        while (length--)
;;;388        {
;;;389            crc ^= ((uint32_t)*data++) << 8;
;;;390            for (i = 0; i < 8; i++)
;;;391            {
;;;392                crc = (crc & 0x8000) ? (crc << 1) ^ 0x1021 : (crc << 1);
;;;393            }
;;;394        }
;;;395        return crc & 0xffff;
;;;396    }
