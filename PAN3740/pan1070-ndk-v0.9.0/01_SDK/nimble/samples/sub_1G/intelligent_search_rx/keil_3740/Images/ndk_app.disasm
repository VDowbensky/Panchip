;;;2056           break;
;;;2057   #endif
;;;2058   
;;;2059       case BLE_GAP_OP_M_DISC:
;;;2060   #if NIMBLE_BLE_SCAN && !MYNEWT_VAL(BLE_EXT_ADV)
;;;2061           /* When a discovery procedure times out, it is not a failure. */
