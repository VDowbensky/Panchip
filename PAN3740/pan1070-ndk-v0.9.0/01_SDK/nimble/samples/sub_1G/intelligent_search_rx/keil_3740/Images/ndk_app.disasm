;;;1417   //--------------------------------------------------------------------------------------------------
;;;1418   // _mtb_kvstore_setup_areas
;;;1419   //--------------------------------------------------------------------------------------------------
;;;1420   static cy_rslt_t _mtb_kvstore_setup_areas(mtb_kvstore_t* obj)
;;;1421   {
;;;1422       CY_ASSERT(obj != NULL);
;;;1423       cy_rslt_t result = CY_RSLT_SUCCESS;
;;;1424   
;;;1425       // Divide the space into 2 equal sizes.
;;;1426       uint32_t area1_start_addr = obj->start_addr;
;;;1427       uint32_t area2_start_addr = obj->start_addr + _MTB_KVSTORE_AREA_SIZE(obj);
;;;1428   
;;;1429       bool area1_valid;
;;;1430       bool area2_valid;
;;;1431       uint16_t area1_version;
;;;1432       uint16_t area2_version;
;;;1433   
;;;1434       // Read area 1 header
;;;1435       cy_rslt_t area_valid_result = _mtb_kvstore_check_area_valid(obj, area1_start_addr,
;;;1436                                                                   &area1_version);
;;;1437       if ((CY_RSLT_SUCCESS != area_valid_result) &&
;;;1438           (MTB_KVSTORE_ERASED_DATA_ERROR != area_valid_result) &&
;;;1439           (MTB_KVSTORE_INVALID_DATA_ERROR != area_valid_result) &&
;;;1440           (MTB_KVSTORE_ITEM_NOT_FOUND_ERROR != area_valid_result))
;;;1441       {
;;;1442           return area_valid_result;
;;;1443       }
;;;1444       area1_valid = (CY_RSLT_SUCCESS == area_valid_result);
;;;1445   
;;;1446       area_valid_result = _mtb_kvstore_check_area_valid(obj, area2_start_addr, &area2_version);
;;;1447       if ((CY_RSLT_SUCCESS != area_valid_result) &&
;;;1448           (MTB_KVSTORE_ERASED_DATA_ERROR != area_valid_result) &&
;;;1449           (MTB_KVSTORE_INVALID_DATA_ERROR != area_valid_result) &&
;;;1450           (MTB_KVSTORE_ITEM_NOT_FOUND_ERROR != area_valid_result))
;;;1451       {
;;;1452           return area_valid_result;
;;;1453       }
;;;1454       area2_valid = (CY_RSLT_SUCCESS == area_valid_result);
;;;1455   
;;;1456       // If both are valid, set the one area whose master record has the
;;;1457       // higher version as active_area. Erase first sector of the other one.
;;;1458       if (area1_valid && area2_valid)
;;;1459       {
;;;1460           // The versions should never be equal.
;;;1461           CY_ASSERT(area1_version != area2_version);
;;;1462   
;;;1463           // Check if the area1 version is greater or 0 in case of wrap around.
;;;1464           if ((area1_version > area2_version) || (area1_version == 0))
;;;1465           {
;;;1466               obj->active_area_addr = area1_start_addr;
;;;1467               obj->active_area_version = area1_version;
;;;1468               obj->gc_area_addr = area2_start_addr;
;;;1469           }
;;;1470           else
;;;1471           {
;;;1472               obj->active_area_addr = area2_start_addr;
;;;1473               obj->active_area_version = area2_version;
;;;1474               obj->gc_area_addr = area1_start_addr;
;;;1475           }
;;;1476       }
;;;1477       // If one is valid, set its area as active_area.
;;;1478       else if (area1_valid)
;;;1479       {
;;;1480           obj->active_area_addr = area1_start_addr;
;;;1481           obj->active_area_version = area1_version;
;;;1482           obj->gc_area_addr = area2_start_addr;
;;;1483       }
;;;1484       else if (area2_valid)
;;;1485       {
;;;1486           obj->active_area_addr = area2_start_addr;
;;;1487           obj->active_area_version = area2_version;
;;;1488           obj->gc_area_addr = area1_start_addr;
;;;1489       }
;;;1490       // If none are valid, set area1 as active_area, and program area record
;;;1491       //with version 1.
;;;1492       else
;;;1493       {
;;;1494           // Erase first sector of area 1 to be able to write the header.
;;;1495           result = _mtb_kvstore_erase_area(obj, area1_start_addr);
;;;1496           if (result != CY_RSLT_SUCCESS)
;;;1497           {
;;;1498               return result;
;;;1499           }
;;;1500   
;;;1501           // Write the area header into the area 1.
;;;1502           result = _mtb_kvstore_write_area_record(obj, area1_start_addr,
;;;1503                                                   _MTB_KVSTORE_INITIAL_AREA_VERSION);
;;;1504           if (result != CY_RSLT_SUCCESS)
;;;1505           {
;;;1506               return result;
;;;1507           }
;;;1508           obj->active_area_addr = area1_start_addr;
;;;1509           obj->active_area_version = _MTB_KVSTORE_INITIAL_AREA_VERSION;
;;;1510           obj->gc_area_addr = area2_start_addr;
;;;1511       }
;;;1512   
;;;1513       return result;
;;;1514   }
