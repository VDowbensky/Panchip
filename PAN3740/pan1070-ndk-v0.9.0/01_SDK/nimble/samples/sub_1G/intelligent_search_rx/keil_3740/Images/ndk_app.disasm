;;;1295           /* Initialize the client configuration with a copy of the cache. */
;;;1296           memcpy(gatts_conn->clt_cfgs, ble_gatts_clt_cfgs,
;;;1297                  ble_gatts_clt_cfg_size());
;;;1298           gatts_conn->num_clt_cfgs = ble_gatts_num_cfgable_chrs;
;;;1299       } else {
;;;1300           gatts_conn->clt_cfgs = NULL;
;;;1301           gatts_conn->num_clt_cfgs = 0;
;;;1302       }
;;;1303   
;;;1304       return 0;
;;;1305   }
