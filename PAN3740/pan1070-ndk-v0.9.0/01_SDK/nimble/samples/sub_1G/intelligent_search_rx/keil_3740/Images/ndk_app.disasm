;;;1143       entry = ble_gap_update_entry_remove(conn_handle);
;;;1144       ble_hs_unlock();
;;;1145   
;;;1146       if (entry != NULL) {
;;;1147           ble_gap_update_notify(conn_handle, reason);
;;;1148           ble_gap_update_entry_free(entry);
;;;1149       }
;;;1150   
;;;1151       /* Indicate the connection termination to each module.  The order matters
;;;1152        * here: gatts must come before gattc to ensure the application does not
;;;1153        * get informed of spurious notify-tx events.
;;;1154        */
;;;1155       ble_l2cap_sig_conn_broken(conn_handle, reason);
;;;1156       ble_sm_connection_broken(conn_handle);
;;;1157       ble_gatts_connection_broken(conn_handle);
;;;1158       ble_gattc_connection_broken(conn_handle);
;;;1159       ble_hs_flow_connection_broken(conn_handle);;
;;;1160   
;;;1161       ble_hs_atomic_conn_delete(conn_handle);
;;;1162   
;;;1163       //ble_store_config_conf_save_all();
;;;1164   
;;;1165       event.type = BLE_GAP_EVENT_DISCONNECT;
;;;1166       event.disconnect.reason = reason;
;;;1167   
;;;1168       ble_gap_event_listener_call(&event);
;;;1169       ble_gap_call_event_cb(&event, snap.cb, snap.cb_arg);
;;;1170   
;;;1171       STATS_INC(ble_gap_stats, disconnect);
;;;1172   #endif
;;;1173   }
