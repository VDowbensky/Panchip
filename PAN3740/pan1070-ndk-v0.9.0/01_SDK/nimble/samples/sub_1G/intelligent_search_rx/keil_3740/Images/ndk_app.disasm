;;;4187   
;;;4188   #if ( configUSE_MUTEXES == 1 )
;;;4189   
;;;4190       BaseType_t xTaskPriorityDisinherit( TaskHandle_t const pxMutexHolder )
;;;4191       {
;;;4192           TCB_t * const pxTCB = pxMutexHolder;
;;;4193           BaseType_t xReturn = pdFALSE;
;;;4194   
;;;4195           if( pxMutexHolder != NULL )
;;;4196           {
;;;4197               /* A task can only have an inherited priority if it holds the mutex.
;;;4198                * If the mutex is held by a task then it cannot be given from an
;;;4199                * interrupt, and if a mutex is given by the holding task then it must
;;;4200                * be the running state task. */
;;;4201               configASSERT( pxTCB == pxCurrentTCB );
;;;4202               configASSERT( pxTCB->uxMutexesHeld );
;;;4203               ( pxTCB->uxMutexesHeld )--;
;;;4204   
;;;4205               /* Has the holder of the mutex inherited the priority of another
;;;4206                * task? */
;;;4207               if( pxTCB->uxPriority != pxTCB->uxBasePriority )
;;;4208               {
;;;4209                   /* Only disinherit if no other mutexes are held. */
;;;4210                   if( pxTCB->uxMutexesHeld == ( UBaseType_t ) 0 )
;;;4211                   {
;;;4212                       /* A task can only have an inherited priority if it holds
;;;4213                        * the mutex.  If the mutex is held by a task then it cannot be
;;;4214                        * given from an interrupt, and if a mutex is given by the
