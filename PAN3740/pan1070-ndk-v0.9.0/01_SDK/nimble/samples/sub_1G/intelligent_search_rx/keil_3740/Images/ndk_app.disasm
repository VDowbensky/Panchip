;;;1490           res.execute = 1;
;;;1491       } else {
;;;1492           /* The request is unexpected; nack and forget. */
;;;1493           restore = 0;
;;;1494           ble_sm_ltk_req_neg_reply_tx(conn_handle);
;;;1495           proc = NULL;
;;;1496       }
;;;1497   
;;;1498       if (restore) {
;;;1499           conn = ble_hs_conn_find_assert(conn_handle);
;;;1500           ble_hs_conn_addrs(conn, &addrs);
;;;1501           memcpy(peer_id_addr, addrs.peer_id_addr.val, 6);
