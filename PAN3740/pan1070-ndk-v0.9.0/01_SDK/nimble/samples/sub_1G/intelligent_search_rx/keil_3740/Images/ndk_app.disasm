;;;1476               res.execute = 1;
;;;1477           }
;;;1478       } else if (proc->state == BLE_SM_PROC_STATE_SEC_REQ) {
;;;1479           /* Same as above, except we solicited the encryption procedure by
;;;1480            * sending a security request.
;;;1481            */
;;;1482           restore = 1;
;;;1483           proc->state = BLE_SM_PROC_STATE_LTK_RESTORE;
;;;1484           res.execute = 1;
;;;1485       } else if (proc->state == BLE_SM_PROC_STATE_LTK_START) {
