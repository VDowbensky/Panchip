;;;996            return BLE_HS_ENOMEM;
;;;997        }
;;;998    
;;;999        put_le16(&u16, last);
;;;1000       rc = os_mbuf_append(om, &u16, 2);
;;;1001       if (rc != 0) {
;;;1002           *out_att_err = BLE_ATT_ERR_INSUFFICIENT_RES;
;;;1003           return BLE_HS_ENOMEM;
;;;1004       }
;;;1005   
;;;1006       return BLE_HS_EAGAIN;
;;;1007   }
