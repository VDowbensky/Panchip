;;;1740       return rc;
;;;1741   }
;;;1742   
;;;1743   static int
;;;1744   ble_l2cap_sig_le_credits_rx(uint16_t conn_handle, struct ble_l2cap_sig_hdr *hdr,
;;;1745                               struct os_mbuf **om)
;;;1746   {
;;;1747       struct ble_l2cap_sig_le_credits *req;
