;;;1121   void
;;;1122   ble_gap_conn_broken(uint16_t conn_handle, int reason)
;;;1123   {
;;;1124   #if NIMBLE_BLE_CONNECT
;;;1125       struct ble_gap_update_entry *entry;
;;;1126       struct ble_gap_snapshot snap;
;;;1127       struct ble_gap_event event;
;;;1128       int rc;
;;;1129   
;;;1130       memset(&event, 0, sizeof event);
;;;1131       snap.desc = &event.disconnect.conn;
;;;1132   
;;;1133       rc = ble_gap_find_snapshot(conn_handle, &snap);
;;;1134       if (rc != 0) {
;;;1135           /* No longer connected. */
;;;1136           return;
;;;1137       }
;;;1138   
;;;1139       /* If there was a connection update in progress, indicate to the
;;;1140        * application that it did not complete.
;;;1141        */
