;;;1239           uint16_t coc_err = ble_l2cap_sig_ble_hs_err2coc_err(rc);
;;;1240   
;;;1241           /* Make sure we do not send disconnect event when removing channel */
;;;1242           chan->cb = NULL;
;;;1243   
;;;1244           ble_hs_lock();
;;;1245           conn = ble_hs_conn_find_assert(conn_handle);
;;;1246           ble_hs_conn_delete_chan(conn, chan);
;;;1247           ble_hs_unlock();
;;;1248           rsp->result = htole16(coc_err);
;;;1249           goto failed;
;;;1250       }
;;;1251   
;;;1252       rsp->dcid = htole16(chan->scid);
;;;1253       rsp->credits = htole16(chan->coc_rx.credits);
;;;1254       rsp->mps = htole16(chan->my_coc_mps);
;;;1255       rsp->mtu = htole16(chan->coc_rx.mtu);
;;;1256       rsp->result = htole16(BLE_L2CAP_COC_ERR_CONNECTION_SUCCESS);
;;;1257   
;;;1258       rc = ble_l2cap_sig_tx(conn_handle, txom);
;;;1259       if (rc != 0) {
;;;1260           ble_hs_lock();
;;;1261           conn = ble_hs_conn_find_assert(conn_handle);
;;;1262           ble_hs_conn_delete_chan(conn, chan);
;;;1263           ble_hs_unlock();
;;;1264           return 0;
;;;1265       }
;;;1266   
;;;1267       /* Notify user about connection status */
;;;1268       ble_l2cap_event_coc_connected(chan, rc);
;;;1269   
;;;1270       return 0;
;;;1271   
;;;1272   failed:
;;;1273       ble_l2cap_sig_tx(conn_handle, txom);
;;;1274       return 0;
;;;1275   }
;;;1276   
;;;1277   static int
;;;1278   ble_l2cap_sig_coc_rsp_rx(uint16_t conn_handle, struct ble_l2cap_sig_hdr *hdr,
;;;1279                             struct os_mbuf **om)
;;;1280   {
;;;1281       struct ble_l2cap_sig_proc *proc;
;;;1282       struct ble_l2cap_sig_le_con_rsp *rsp;
;;;1283       struct ble_l2cap_chan *chan;
;;;1284       struct ble_hs_conn *conn;
;;;1285       int rc;
;;;1286   
;;;1287   #if !BLE_MONITOR
;;;1288       BLE_HS_LOG(DEBUG, "L2CAP LE COC connection response received\n");
;;;1289   #endif
;;;1290   
;;;1291       proc = ble_l2cap_sig_proc_extract(conn_handle,
;;;1292                                         BLE_L2CAP_SIG_PROC_OP_CONNECT,
;;;1293                                         hdr->identifier);
;;;1294       if (!proc) {
;;;1295           return 0;
;;;1296       }
;;;1297   
;;;1298       rc = ble_hs_mbuf_pullup_base(om, sizeof(*rsp));
;;;1299       if (rc != 0) {
;;;1300           goto done;
;;;1301       }
;;;1302   
;;;1303       rsp = (struct ble_l2cap_sig_le_con_rsp *)(*om)->om_data;
;;;1304   
;;;1305       chan = proc->connect.chan[0];
;;;1306   
;;;1307       if (rsp->result) {
;;;1308           rc = ble_l2cap_sig_coc_err2ble_hs_err(le16toh(rsp->result));
;;;1309           goto done;
;;;1310       }
;;;1311   
;;;1312       /* Fill up remote configuration
;;;1313        * Note MPS is the L2CAP MTU
;;;1314        */
;;;1315       chan->peer_coc_mps = le16toh(rsp->mps);
;;;1316       chan->dcid = le16toh(rsp->dcid);
;;;1317       chan->coc_tx.mtu = le16toh(rsp->mtu);
;;;1318       chan->coc_tx.credits = le16toh(rsp->credits);
;;;1319   
;;;1320       ble_hs_lock();
;;;1321       conn = ble_hs_conn_find(conn_handle);
;;;1322       assert(conn != NULL);
;;;1323       ble_hs_conn_chan_insert(conn, chan);
;;;1324       ble_hs_unlock();
;;;1325   
;;;1326       rc = 0;
;;;1327   
;;;1328   done:
;;;1329       ble_l2cap_sig_coc_connect_cb(proc, rc);
;;;1330       ble_l2cap_sig_proc_free(proc);
;;;1331   
;;;1332       /* Silently ignore errors as this is response signal */
;;;1333       return 0;
;;;1334   }
