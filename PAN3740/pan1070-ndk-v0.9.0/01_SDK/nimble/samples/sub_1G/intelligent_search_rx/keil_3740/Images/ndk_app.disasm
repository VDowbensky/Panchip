;;;3182       /* THIS FUNCTION MUST BE CALLED FROM A CRITICAL SECTION.  It can also be
;;;3183        * called from a critical section within an ISR. */
;;;3184   
;;;3185       /* The event list is sorted in priority order, so the first in the list can
;;;3186        * be removed as it is known to be the highest priority.  Remove the TCB from
;;;3187        * the delayed list, and add it to the ready list.
;;;3188        *
;;;3189        * If an event is for a queue that is locked then this function will never
;;;3190        * get called - the lock count on the queue will get modified instead.  This
;;;3191        * means exclusive access to the event list is guaranteed here.
;;;3192        *
;;;3193        * This function assumes that a check has already been made to ensure that
;;;3194        * pxEventList is not empty. */
;;;3195       pxUnblockedTCB = listGET_OWNER_OF_HEAD_ENTRY( pxEventList ); /*lint !e9079 void * is used as this macro is used with timers and co-routines too.  Alignment is known to be fine as the type of the pointer stored and retrieved is the same. */
;;;3196       configASSERT( pxUnblockedTCB );
;;;3197       listREMOVE_ITEM( &( pxUnblockedTCB->xEventListItem ) );
;;;3198   
;;;3199       if( uxSchedulerSuspended == ( UBaseType_t ) pdFALSE )
;;;3200       {
;;;3201           listREMOVE_ITEM( &( pxUnblockedTCB->xStateListItem ) );
;;;3202           prvAddTaskToReadyList( pxUnblockedTCB );
;;;3203   
;;;3204           #if ( configUSE_TICKLESS_IDLE != 0 )
;;;3205           {
;;;3206               /* If a task is blocked on a kernel object then xNextTaskUnblockTime
;;;3207                * might be set to the blocked task's time out time.  If the task is
;;;3208                * unblocked for a reason other than a timeout xNextTaskUnblockTime is
;;;3209                * normally left unchanged, because it is automatically reset to a new
;;;3210                * value when the tick count equals xNextTaskUnblockTime.  However if
;;;3211                * tickless idling is used it might be more important to enter sleep mode
;;;3212                * at the earliest possible time - so reset xNextTaskUnblockTime here to
;;;3213                * ensure it is updated at the earliest possible time. */
;;;3214               prvResetNextTaskUnblockTime();
;;;3215           }
;;;3216           #endif
;;;3217       }
;;;3218       else
;;;3219       {
;;;3220           /* The delayed and ready lists cannot be accessed, so hold this task
;;;3221            * pending until the scheduler is resumed. */
;;;3222           listINSERT_END( &( xPendingReadyList ), &( pxUnblockedTCB->xEventListItem ) );
;;;3223       }
;;;3224   
;;;3225       if( pxUnblockedTCB->uxPriority > pxCurrentTCB->uxPriority )
;;;3226       {
;;;3227           /* Return true if the task removed from the event list has a higher
;;;3228            * priority than the calling task.  This allows the calling task to know if
;;;3229            * it should force a context switch now. */
;;;3230           xReturn = pdTRUE;
;;;3231   
;;;3232           /* Mark that a yield is pending in case the user is not using the
;;;3233            * "xHigherPriorityTaskWoken" parameter to an ISR safe FreeRTOS function. */
;;;3234           xYieldPending = pdTRUE;
;;;3235       }
;;;3236       else
;;;3237       {
;;;3238           xReturn = pdFALSE;
;;;3239       }
;;;3240   
;;;3241       return xReturn;
;;;3242   }
;;;3243   /*-----------------------------------------------------------*/
;;;3244   
;;;3245   void vTaskRemoveFromUnorderedEventList( ListItem_t * pxEventListItem,
;;;3246                                           const TickType_t xItemValue )
;;;3247   {
;;;3248       TCB_t * pxUnblockedTCB;
;;;3249   
;;;3250       /* THIS FUNCTION MUST BE CALLED WITH THE SCHEDULER SUSPENDED.  It is used by
;;;3251        * the event flags implementation. */
;;;3252       configASSERT( uxSchedulerSuspended != pdFALSE );
;;;3253   
;;;3254       /* Store the new item value in the event list. */
;;;3255       listSET_LIST_ITEM_VALUE( pxEventListItem, xItemValue | taskEVENT_LIST_ITEM_VALUE_IN_USE );
;;;3256   
;;;3257       /* Remove the event list form the event flag.  Interrupts do not access
;;;3258        * event flags. */
;;;3259       pxUnblockedTCB = listGET_LIST_ITEM_OWNER( pxEventListItem ); /*lint !e9079 void * is used as this macro is used with timers and co-routines too.  Alignment is known to be fine as the type of the pointer stored and retrieved is the same. */
;;;3260       configASSERT( pxUnblockedTCB );
;;;3261       listREMOVE_ITEM( pxEventListItem );
;;;3262   
;;;3263       #if ( configUSE_TICKLESS_IDLE != 0 )
;;;3264       {
;;;3265           /* If a task is blocked on a kernel object then xNextTaskUnblockTime
;;;3266            * might be set to the blocked task's time out time.  If the task is
;;;3267            * unblocked for a reason other than a timeout xNextTaskUnblockTime is
;;;3268            * normally left unchanged, because it is automatically reset to a new
;;;3269            * value when the tick count equals xNextTaskUnblockTime.  However if
;;;3270            * tickless idling is used it might be more important to enter sleep mode
;;;3271            * at the earliest possible time - so reset xNextTaskUnblockTime here to
;;;3272            * ensure it is updated at the earliest possible time. */
;;;3273           prvResetNextTaskUnblockTime();
;;;3274       }
;;;3275       #endif
;;;3276   
;;;3277       /* Remove the task from the delayed list and add it to the ready list.  The
;;;3278        * scheduler is suspended so interrupts will not be accessing the ready
;;;3279        * lists. */
;;;3280       listREMOVE_ITEM( &( pxUnblockedTCB->xStateListItem ) );
;;;3281       prvAddTaskToReadyList( pxUnblockedTCB );
;;;3282   
;;;3283       if( pxUnblockedTCB->uxPriority > pxCurrentTCB->uxPriority )
;;;3284       {
;;;3285           /* The unblocked task has a priority above that of the calling task, so
;;;3286            * a context switch is required.  This function is called with the
;;;3287            * scheduler suspended so xYieldPending is set so the context switch
;;;3288            * occurs immediately that the scheduler is resumed (unsuspended). */
;;;3289           xYieldPending = pdTRUE;
;;;3290       }
;;;3291   }
