;;;1375           for (i = 0; i < conn->bhc_gatt_svr.num_clt_cfgs; i++) {
;;;1376               clt_cfg = conn->bhc_gatt_svr.clt_cfgs + i;
;;;1377               if (clt_cfg->flags & BLE_GATTS_CLT_CFG_F_MODIFIED) {
