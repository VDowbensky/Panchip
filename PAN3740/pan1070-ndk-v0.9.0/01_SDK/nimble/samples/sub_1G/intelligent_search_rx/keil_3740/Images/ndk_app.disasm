;;;1002   
;;;1003   /**
;;;1004    * Finds the update procedure that expires soonest.
;;;1005    *
;;;1006    * @param out_ticks_from_now    On success, the ticks until the update
;;;1007    *                                  procedure's expiry time gets written here.
;;;1008    *
;;;1009    * @return                      The connection handle of the update procedure
;;;1010    *                                  that expires soonest, or
;;;1011    *                                  BLE_HS_CONN_HANDLE_NONE if there are no
;;;1012    *                                  active update procedures.
;;;1013    */
;;;1014   static uint16_t
;;;1015   ble_gap_update_next_exp(int32_t *out_ticks_from_now)
;;;1016   {
;;;1017       struct ble_gap_update_entry *entry;
;;;1018       ble_npl_time_t now;
;;;1019       uint16_t conn_handle;
;;;1020       ble_npl_stime_t best_ticks;
;;;1021       ble_npl_stime_t ticks;
;;;1022   
;;;1023       // BLE_HS_DBG_ASSERT(ble_hs_locked_by_cur_task());
;;;1024   
;;;1025       conn_handle = BLE_HS_CONN_HANDLE_NONE;
;;;1026       best_ticks = BLE_HS_FOREVER;
;;;1027       now = ble_npl_time_get();
;;;1028   
;;;1029       SLIST_FOREACH(entry, &ble_gap_update_entries, next) {
;;;1030           ticks = entry->exp_os_ticks - now;
;;;1031           if (ticks <= 0) {
;;;1032               ticks = 0;
;;;1033           }
;;;1034   
;;;1035           if (ticks < best_ticks) {
;;;1036               conn_handle = entry->conn_handle;
;;;1037               best_ticks = ticks;
;;;1038           }
;;;1039       }
;;;1040   
;;;1041       if (out_ticks_from_now != NULL) {
;;;1042           *out_ticks_from_now = best_ticks;
;;;1043       }
;;;1044   
;;;1045       return conn_handle;
;;;1046   
;;;1047   }
;;;1048   
;;;1049   #if NIMBLE_BLE_SCAN
;;;1050   static void
;;;1051   ble_gap_master_set_timer(uint32_t ticks_from_now)
;;;1052   {
;;;1053       ble_gap_master.exp_os_ticks = ble_npl_time_get() + ticks_from_now;
;;;1054       ble_gap_master.exp_set = 1;
;;;1055   
;;;1056       ble_hs_timer_resched();
;;;1057   }
;;;1058   #endif
;;;1059   
;;;1060   #if NIMBLE_BLE_ADVERTISE && !MYNEWT_VAL(BLE_EXT_ADV)
;;;1061   static void
;;;1062   ble_gap_slave_set_timer(uint32_t ticks_from_now)
;;;1063   {
;;;1064       ble_gap_slave[0].exp_os_ticks = ble_npl_time_get() + ticks_from_now;
;;;1065       ble_gap_slave[0].exp_set = 1;
