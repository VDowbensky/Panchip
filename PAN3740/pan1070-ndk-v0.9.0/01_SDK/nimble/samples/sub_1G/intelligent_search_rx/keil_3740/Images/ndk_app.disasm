;;;3234           xYieldPending = pdTRUE;
;;;3235       }
;;;3236       else
;;;3237       {
;;;3238           xReturn = pdFALSE;
;;;3239       }
;;;3240   
;;;3241       return xReturn;
;;;3242   }
