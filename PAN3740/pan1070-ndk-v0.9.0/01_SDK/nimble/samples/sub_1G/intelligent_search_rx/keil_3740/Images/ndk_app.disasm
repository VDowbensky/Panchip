        0x0000c9be:    2e00        ..      CMP      r6,#0
        0x0000c9c0:    d01c        ..      BEQ      0xc9fc ; _mtb_kvstore_write_with_flags + 228
;;;1567                                   ? 0
;;;1568                                   : _mtb_kvstore_get_record_size(obj, obj->active_area_addr,
        0x0000c9c2:    6e20         n      LDR      r0,[r4,#0x60]
        0x0000c9c4:    900a        ..      STR      r0,[sp,#0x28]
        0x0000c9c6:    981a        ..      LDR      r0,[sp,#0x68]
        0x0000c9c8:    f7f3fca1    ....    BL       strlen ; 0x30e
        0x0000c9cc:    9003        ..      STR      r0,[sp,#0xc]
;;; ..\..\..\..\component\kv_store\mtb_kvstore.c (361)
        0x0000c9ce:    68a1        .h      LDR      r1,[r4,#8]
        0x0000c9d0:    9f13        ..      LDR      r7,[sp,#0x4c]
        0x0000c9d2:    690a        .i      LDR      r2,[r1,#0x10]
