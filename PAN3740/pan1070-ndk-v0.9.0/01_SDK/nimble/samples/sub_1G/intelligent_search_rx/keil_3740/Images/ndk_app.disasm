;;;1565                                                               key), size);
;;;1566       uint32_t old_record_size = (operation == _MTB_KVSTORE_OPER_ADD)
;;;1567                                   ? 0
;;;1568                                   : _mtb_kvstore_get_record_size(obj, obj->active_area_addr,
;;;1569                                                                  strlen(key),
;;;1570                                                                  old_record_data_size);
;;;1571   
;;;1572       if (((operation == _MTB_KVSTORE_OPER_UPDATE) || (operation == _MTB_KVSTORE_OPER_ADD)) &&
;;;1573           ((obj->consumed_size - old_record_size + record_size) > _MTB_KVSTORE_AREA_SIZE(obj)))
;;;1574       {
;;;1575           return MTB_KVSTORE_STORAGE_FULL_ERROR;
;;;1576       }
;;;1577   
;;;1578       if ((obj->free_space_offset + record_size) > _MTB_KVSTORE_AREA_SIZE(obj))
;;;1579       {
;;;1580           // If we need to update or delete a key and we do not enough space left. We can do the
;;;1581           // update or
;;;1582           // deletion when we run garbage collection by removing the value from the ram table before
;;;1583           // GC operation
;;;1584           // and injecting new updated entry if it is a update operation.
;;;1585           _mtb_kvstore_record_info_t record_info;
;;;1586           _mtb_kvstore_update_record_info_t update_rec;
;;;1587   
;;;1588           if ((operation == _MTB_KVSTORE_OPER_DELETE) || (operation == _MTB_KVSTORE_OPER_UPDATE))
;;;1589           {
;;;1590               record_info.ram_tbl_idx = ram_tbl_idx;
;;;1591               record_info.consumed_size_info.new_record_size = record_size;
;;;1592               record_info.consumed_size_info.old_record_size = old_record_size;
;;;1593           }
;;;1594   
;;;1595           if (operation == _MTB_KVSTORE_OPER_DELETE)
;;;1596           {
;;;1597               record_info.update_rec_info = NULL;
;;;1598           }
;;;1599           else if (operation == _MTB_KVSTORE_OPER_UPDATE)
;;;1600           {
;;;1601               update_rec.key = key;
;;;1602               update_rec.data = data;
;;;1603               update_rec.data_size = size;
;;;1604               update_rec.key_hash = hash;
;;;1605   
;;;1606               record_info.update_rec_info = &update_rec;
;;;1607           }
;;;1608   
;;;1609           result = _mtb_kvstore_garbage_collection(obj,
;;;1610                                                    (operation == _MTB_KVSTORE_OPER_ADD)
;;;1611                                                     ? NULL
;;;1612                                                     : &record_info);
;;;1613           if ((result != CY_RSLT_SUCCESS) || found_in_table)
;;;1614           {
;;;1615               return result;
;;;1616           }
;;;1617       }
;;;1618   
;;;1619       // We check that we have enough space earlier so when we get here we must
;;;1620       // have enough space.
;;;1621       CY_ASSERT((obj->free_space_offset + record_size) <= _MTB_KVSTORE_AREA_SIZE(obj));
;;;1622   
;;;1623       _mtb_kvstore_update_ram_table_info_t ram_tbl_info =
;;;1624       {
;;;1625           .ram_tbl_idx  = ram_tbl_idx,
;;;1626           .entry.hash   = hash,
;;;1627           .entry.offset = obj->free_space_offset
;;;1628       };
;;;1629   
;;;1630       _mtb_kvstore_update_consumed_size_info_t size_info =
;;;1631       {
;;;1632           .old_record_size = old_record_size,
;;;1633           .new_record_size = record_size
;;;1634       };
;;;1635   
;;;1636       result = _mtb_kvstore_write_record(obj, obj->active_area_addr, obj->free_space_offset,
;;;1637                                          key, data, size, operation, &ram_tbl_info,
;;;1638                                          &size_info);
;;;1639       if (result == CY_RSLT_SUCCESS)
;;;1640       {
;;;1641           obj->free_space_offset += record_size;
;;;1642       }
;;;1643   
