;;;1029        */
;;;1030       if (uuid_group->type != BLE_UUID_TYPE_16) {
;;;1031           return 1;
;;;1032       }
;;;1033   
;;;1034       /* Grouping is defined only for 16-bit UUIDs, so non-16-bit UUID attribute
;;;1035        * cannot end group.
;;;1036        */
;;;1037       if (uuid->type != BLE_UUID_TYPE_16) {
;;;1038           return 0;
;;;1039       }
;;;1040   
;;;1041       switch (ble_uuid_u16(uuid_group)) {
;;;1042       case BLE_ATT_UUID_PRIMARY_SERVICE:
;;;1043       case BLE_ATT_UUID_SECONDARY_SERVICE:
;;;1044           uuid16 = ble_uuid_u16(uuid);
;;;1045   
;;;1046           /* Only Primary or Secondary Service types end service group. */
