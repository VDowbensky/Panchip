;;;1698   
;;;1699   int
;;;1700   ble_l2cap_sig_disconnect(struct ble_l2cap_chan *chan)
;;;1701   {
;;;1702       struct os_mbuf *txom;
;;;1703       struct ble_l2cap_sig_disc_req *req;
;;;1704       struct ble_l2cap_sig_proc *proc;
;;;1705       int rc;
;;;1706   
;;;1707       if (chan->flags & BLE_L2CAP_CHAN_F_DISCONNECTING) {
;;;1708           return 0;
;;;1709       }
;;;1710   
;;;1711       proc = ble_l2cap_sig_proc_alloc();
;;;1712       if (proc == NULL) {
;;;1713           return BLE_HS_ENOMEM;
;;;1714       }
;;;1715   
;;;1716       proc->op = BLE_L2CAP_SIG_PROC_OP_DISCONNECT;
;;;1717       proc->id = ble_l2cap_sig_next_id();
;;;1718       proc->conn_handle = chan->conn_handle;
;;;1719       proc->disconnect.chan = chan;
;;;1720   
;;;1721       req = ble_l2cap_sig_cmd_get(BLE_L2CAP_SIG_OP_DISCONN_REQ, proc->id,
;;;1722                                   sizeof(*req), &txom);
;;;1723       if (!req) {
;;;1724           rc = BLE_HS_ENOMEM;
;;;1725           goto done;
;;;1726       }
;;;1727   
;;;1728       req->dcid = htole16(chan->dcid);
;;;1729       req->scid = htole16(chan->scid);
;;;1730   
