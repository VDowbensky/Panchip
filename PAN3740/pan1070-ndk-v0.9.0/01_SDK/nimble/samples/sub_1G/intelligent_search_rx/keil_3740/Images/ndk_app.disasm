;;;1094   /**
;;;1095    * Handles GATT server clean up for a terminated connection:
;;;1096    *     o Informs the application that the peer is no longer subscribed to any
;;;1097    *       characteristic updates.
;;;1098    *     o Frees GATT server resources consumed by the connection (CCCDs).
;;;1099    */
;;;1100   void
;;;1101   ble_gatts_connection_broken(uint16_t conn_handle)
;;;1102   {
;;;1103       struct ble_gatts_clt_cfg *clt_cfgs;
;;;1104       struct ble_hs_conn *conn;
;;;1105       int num_clt_cfgs;
;;;1106       int rc;
;;;1107       int i;
;;;1108   
;;;1109       /* Find the specified connection and extract its CCCD entries.  Extracting
;;;1110        * the clt_cfg pointer and setting the original to null is done for two
;;;1111        * reasons:
;;;1112        *     1. So that the CCCD entries can be safely processed after unlocking
;;;1113        *        the mutex.
;;;1114        *     2. To ensure a subsequent indicate procedure for this peer is not
;;;1115        *        attempted, as the connection is about to be terminated.  This
;;;1116        *        avoids a spurious notify-tx GAP event callback to the
;;;1117        *        application.  By setting the clt_cfg pointer to null, it is
;;;1118        *        assured that the connection has no pending indications to send.
;;;1119        */
;;;1120       ble_hs_lock();
;;;1121       conn = ble_hs_conn_find(conn_handle);
;;;1122       if (conn != NULL) {
;;;1123           clt_cfgs = conn->bhc_gatt_svr.clt_cfgs;
;;;1124           num_clt_cfgs = conn->bhc_gatt_svr.num_clt_cfgs;
;;;1125   
;;;1126           conn->bhc_gatt_svr.clt_cfgs = NULL;
;;;1127           conn->bhc_gatt_svr.num_clt_cfgs = 0;
;;;1128       }
;;;1129       ble_hs_unlock();
;;;1130   
;;;1131       if (conn == NULL) {
;;;1132           return;
;;;1133       }
;;;1134   
;;;1135       /* If there is an indicate procedure in progress for this connection,
;;;1136        * inform the application that it has failed.
;;;1137        */
;;;1138       ble_gatts_indicate_fail_notconn(conn_handle);
;;;1139   
;;;1140       /* Now that the mutex is unlocked, inform the application that the peer is
;;;1141        * no longer subscribed to any characteristic updates.
;;;1142        */
;;;1143       if (clt_cfgs != NULL) {
;;;1144           for (i = 0; i < num_clt_cfgs; i++) {
;;;1145               ble_gatts_subscribe_event(conn_handle, clt_cfgs[i].chr_val_handle,
;;;1146                                         BLE_GAP_SUBSCRIBE_REASON_TERM,
;;;1147                                         clt_cfgs[i].flags, 0);
;;;1148           }
;;;1149   
;;;1150           rc = os_memblock_put(&ble_gatts_clt_cfg_pool, clt_cfgs);
;;;1151           BLE_HS_DBG_ASSERT_EVAL(rc == 0);
;;;1152       }
;;;1153   }
